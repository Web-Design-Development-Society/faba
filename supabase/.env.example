# Copy to supabase/.env. The Supabase CLI reads it for env() values in config.toml.
# Never commit supabase/.env.
#
# Google OAuth client for local development (redirect URI:
# http://127.0.0.1:54331/auth/v1/callback). Placeholders are enough to start Supabase and
# use the seeded personas; Google sign-in needs real values from the dev client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-dev-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-dev-client-secret
