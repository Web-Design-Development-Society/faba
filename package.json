{
  "name": "faba",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "setup:dev-vars": "node scripts/setup-dev-vars.mjs",
    "push:keys": "node scripts/vapid-keys.mjs",
    "lint": "eslint --max-warnings=0 .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/db.types.ts && prettier --write --log-level warn src/lib/db.types.ts",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@fontsource/anton": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-sql-cst": "^0.25.1",
    "supabase": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "//": "overrides: typescript-eslint 8.72 still asks for minimatch ^10, which has GHSA-g3hv-75wg-m249 (OPS-03). Remove the override once it asks for 11 itself.",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true,
    "workerd@1.20261118.1": true
  }
}
