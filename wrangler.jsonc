{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "faba",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-23",
  // Values for local development, matching `npx supabase start`. Secrets never go here: use
  // `wrangler secret put`, or .dev.vars locally.
  "vars": {
    "SITE_URL": "http://localhost:4321",
    "SUPABASE_URL": "http://127.0.0.1:54331",
    // The local Supabase default. Publishable keys are public by design.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH",
    "ALLOWED_EMAIL_DOMAIN": "byui.edu",
    "LOG_LEVEL": "debug",
  },
  // Deployed environments. Astro picks one at build time (`CLOUDFLARE_ENV=staging astro build`),
  // and `wrangler deploy` then deploys what was built. Vars aren't inherited, so each environment
  // lists them all. Production comes with FND-09.
  "env": {
    // The faba-staging Worker. PR previews are versions of it with their own URLs (FND-08).
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "SITE_URL": "https://faba-staging.zack-alvey.workers.dev",
        "SUPABASE_URL": "https://qptrhaxvrozdozhuhagb.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_qfyJNOwaH_m0UujhmhaHbQ_8XvQrMxW",
        "ALLOWED_EMAIL_DOMAIN": "byui.edu",
        "LOG_LEVEL": "info",
      },
    },
  },
}
