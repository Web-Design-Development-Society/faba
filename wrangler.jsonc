{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "faba",
  // Astro answers requests, and the Cron Trigger below sends pushes (src/worker.ts).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-23",
  // Every minute, send the pushes that are due (NOTIF-20).
  "triggers": { "crons": ["* * * * *"] },
  // Smart Placement runs the Worker near the Supabase database it calls most, not near the visitor,
  // which keeps page loads fast as queries grow (PERF-01).
  "placement": { "mode": "smart" },
  // Picture uploads (MEDIA-01). Private: the Worker reads and writes the bucket, and serves a picture
  // only to a member who can see its activity or group. Local development uses a simulated bucket.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "faba-media-local" }],
  // Values for local development, matching `npx supabase start`. Secrets never go here: use
  // `wrangler secret put`, or .dev.vars locally.
  "vars": {
    "SITE_URL": "http://localhost:4321",
    "SUPABASE_URL": "http://127.0.0.1:54331",
    // The local Supabase default. Publishable keys are public by design.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH",
    "ALLOWED_EMAIL_DOMAIN": "byui.edu",
    "LOG_LEVEL": "debug",
    // Locally, Web Push's keys are in .dev.vars, made for each machine by `npm run setup:dev-vars`.
  },
  // Deployed environments. Astro picks one at build time (`CLOUDFLARE_ENV=staging astro build`),
  // and `wrangler deploy` then deploys what was built. Vars aren't inherited, so each environment
  // lists them all. Production comes with FND-09.
  "env": {
    // The faba-staging Worker. PR previews are versions of it with their own URLs (FND-08).
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "placement": { "mode": "smart" },
      // Only the deployed Worker runs it, not PR previews.
      "triggers": { "crons": ["* * * * *"] },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "faba-media-staging" }],
      "vars": {
        "SITE_URL": "https://faba-staging.zack-alvey.workers.dev",
        "SUPABASE_URL": "https://qptrhaxvrozdozhuhagb.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_qfyJNOwaH_m0UujhmhaHbQ_8XvQrMxW",
        "ALLOWED_EMAIL_DOMAIN": "byui.edu",
        "LOG_LEVEL": "info",
        // Its private key is the VAPID_PRIVATE_KEY secret. Push stays off until it's set.
        "VAPID_PUBLIC_KEY": "BHsbq03K18-jGqkyVMuGfF_7UznfYImGvnHd2tajOttPDYYJ16NK5yGb5qPYRoIgCtpTN7ayHsUzLbnjQuv40b8",
      },
    },
  },
}
