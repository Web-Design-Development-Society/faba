---
// The notification center (NOTIF-01, design document section 7.9, journey J8): the last 90 days,
// newest first, 30 at a time, with the unread ones under New and the rest under Earlier. Each row
// has an icon, a line about what happened, the activity's title, and how long ago. Unread rows are
// bold and have a dot, not just a color. Tapping one marks it read and opens its activity, and an
// activity that's gone, or hidden, opens "not available". Mark all read is at the top. It all works
// without JavaScript.
//
// All | Unread switches between every alert and the new ones (?show=unread). Each alert is a card
// (UI-07): its type's icon on a soft blue tile, the activity's or group's name in bold, the sentence
// that says what happened, how long ago, and a chevron. The sentence comes first for screen
// readers, after "Unread", and the name is drawn above it.
import { actions } from 'astro:actions';
import Icon from '../components/Icon.astro';
import Status from '../components/Status.astro';
import Layout from '../layouts/Layout.astro';
import { nextPage, readCursor } from '../lib/feed';
import { describe, type PostedUpdate } from '../lib/notifications';
import { FLASH_MESSAGES, setFlash, takeFlash } from '../lib/server/flash';
import { formatAgo } from '../lib/time';

const PAGE = 30;
const KEPT_DAYS = 90;

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const opened = Astro.getActionResult(actions.notifications.open);
if (opened && !opened.error) return Astro.redirect(opened.data.href, 303);
const readAll = Astro.getActionResult(actions.notifications.readAll);
if (readAll && !readAll.error) {
  setFlash(Astro.cookies, Astro.url, 'read');
  return Astro.redirect('/notifications', 303);
}
const failed = opened?.error ?? readAll?.error;
const flash = takeFlash(Astro.cookies);

const now = new Date();
const onlyUnread = Astro.url.searchParams.get('show') === 'unread';
const cursor = readCursor(Astro.url.searchParams);
let query = supabase
  .from('notifications')
  .select('id, type, payload, read_at, created_at, activity:activities(title), group:groups(name)')
  .gte('created_at', new Date(now.getTime() - KEPT_DAYS * 24 * 60 * 60 * 1000).toISOString())
  .order('created_at', { ascending: false })
  .order('id', { ascending: false })
  .limit(PAGE + 1);
if (onlyUnread) query = query.is('read_at', null);
if (cursor.after_id) {
  query = query.or(
    `created_at.lt."${cursor.after_starts_at}",and(created_at.eq."${cursor.after_starts_at}",id.lt.${cursor.after_id})`
  );
}
const { data, error } = await query;
const shown = data?.slice(0, PAGE) ?? [];
// Organizer and group updates hold the update's id, and its text is read here, so one a moderator
// hides is gone from the center too (NOTIF-04, GRP-04). Its author and moderators can read a hidden one, so it's
// left out here.
const updateIdOf = (payload: unknown) => {
  const id = (payload as { update_id?: unknown } | null)?.update_id;
  return typeof id === 'string' ? id : '';
};
const updateIds = shown
  .filter(({ type }) => type === 'organizer_update' || type === 'group_update')
  .map(({ payload }) => updateIdOf(payload))
  .filter(Boolean);
const { data: updates } = updateIds.length
  ? await supabase
      .from('activity_updates')
      .select('id, body, author:profiles!activity_updates_author_id_fkey(display_name)')
      .in('id', updateIds)
      .is('hidden_at', null)
  : { data: [] };
const posted = new Map<string, PostedUpdate>(
  updates?.map(({ id, body, author }) => [id, { author: author?.display_name ?? null, body }])
);
const last = shown.at(-1);
const next =
  last && data!.length > PAGE ? nextPage({ starts_at: last.created_at, id: last.id }) : null;
const more = next && onlyUnread ? `${next}&show=unread` : next;
const groups = [
  { name: 'New', items: shown.filter(({ read_at }) => !read_at) },
  { name: 'Earlier', items: shown.filter(({ read_at }) => read_at) },
].filter(({ items }) => items.length > 0);
const unread = groups[0]?.name === 'New' || (onlyUnread && shown.length > 0);
---

<Layout title="Alerts" tab="alerts">
  <header class="top">
    <h1>Alerts</h1>
    {unread && (
      <form method="post" action={actions.notifications.readAll.queryString}>
        <button>Mark all read</button>
      </form>
    )}
  </header>
  <nav class="switch" aria-label="Show">
    <a href="/notifications" aria-current={onlyUnread ? undefined : 'page'}>
      All
    </a>
    <a href="/notifications?show=unread" aria-current={onlyUnread ? 'page' : undefined}>
      Unread
    </a>
  </nav>
  <Status message={flash && FLASH_MESSAGES[flash]} />
  {failed && <p role="alert">{failed.message}</p>}

  {error ? (
    <p role="alert">Your alerts couldn't load. Please try again.</p>
  ) : shown.length === 0 ? (
    <p class="empty">
      {onlyUnread
        ? "You're all caught up."
        : "You're all caught up. We'll let you know when plans change."}
    </p>
  ) : (
    groups.map(({ name, items }) => (
      <section aria-labelledby={`alerts-${name}`}>
        <h2 id={`alerts-${name}`}>{name}</h2>
        <ul>
          {items.map((notification) => {
            const { icon, summary } = describe(
              notification.type,
              notification.payload,
              notification.type === 'organizer_update' || notification.type === 'group_update'
                ? (posted.get(updateIdOf(notification.payload)) ?? null)
                : undefined,
              now
            );
            return (
              <li class:list={{ unread: !notification.read_at }}>
                <form method="post" action={actions.notifications.open.queryString}>
                  <input type="hidden" name="id" value={notification.id} />
                  <button>
                    <span class="tile">
                      <Icon name={icon} />
                    </span>
                    <span class="text">
                      <span class="summary">
                        {!notification.read_at && <span class="unread-label">Unread: </span>}
                        {summary}
                      </span>
                      <span class="title">
                        {notification.activity?.title ??
                          notification.group?.name ??
                          'No longer available'}
                      </span>
                      <time datetime={notification.created_at}>
                        {formatAgo(new Date(notification.created_at), now)}
                      </time>
                    </span>
                    <Icon name="chevron" class="chevron" />
                  </button>
                </form>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  )}
  {more && (
    <a class="more" href={`/notifications${more}`}>
      Show more
    </a>
  )}
</Layout>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .top button {
    min-height: 44px;
    padding: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    background: none;
    border: 0;
  }
  /* All | Unread, like Discover's Activities | Groups (UI-07). */
  .switch {
    display: flex;
    margin: 0.5rem 0;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .switch a {
    display: grid;
    flex: 1;
    place-items: center;
    min-height: 44px;
    color: var(--navy);
    text-decoration: none;
  }
  .switch a + a {
    border-left: 1px solid var(--border);
  }
  .switch [aria-current] {
    font-weight: 700;
    color: white;
    background: var(--blue);
  }
  h2 {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.875rem;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each alert is a card, and the whole card is one button. */
  li button {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 44px;
    padding: 0.875rem 0.75rem 0.875rem 1rem;
    font: inherit;
    font-weight: 400;
    color: inherit;
    text-align: left;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  li button:hover {
    border-color: var(--blue);
  }
  /* An unread alert has a blue left edge, a dot and a bold name, so it isn't shown by color alone. */
  .unread button {
    border-left: 0.3125rem solid var(--blue);
  }
  /* The type's line icon on a soft blue tile (UI-02). */
  .tile {
    display: grid;
    flex: none;
    place-items: center;
    align-self: flex-start;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--blue);
    background: var(--blue-soft);
    border-radius: 0.5rem;
  }
  /* The name is drawn first, above what happened, which screen readers hear first. */
  .text {
    display: grid;
    flex: 1;
    gap: 0.125rem;
    min-width: 0;
  }
  .title {
    order: -1;
    font-weight: 600;
    color: var(--navy);
  }
  .unread .title {
    font-weight: 800;
  }
  .unread .title::before {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    vertical-align: middle;
    content: '';
    background: var(--blue);
    border-radius: 50%;
  }
  /* The sentence wraps to as many lines as it needs. */
  .summary {
    overflow-wrap: anywhere;
  }
  .unread-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  time {
    font-size: 0.875rem;
    color: var(--muted);
  }
  button :global(.chevron) {
    color: var(--muted);
  }
  .empty {
    margin-top: 2rem;
    text-align: center;
  }
  .more {
    display: grid;
    place-items: center;
    min-height: 44px;
    margin-top: 1rem;
  }
</style>
