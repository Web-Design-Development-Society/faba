---
// The notification center (NOTIF-01, design document section 7.9, journey J8): the last 90 days,
// newest first, 30 at a time, with the unread ones under New and the rest under Earlier. Each row
// has an icon, a line about what happened, the activity's title, and how long ago. Unread rows are
// on light blue paper and have a dot, not just a color. Tapping one marks it read and opens its
// activity, and an activity that's gone, or hidden, opens "not available". A sentence at the top
// says what the page is for, with Mark all read at its right (UI-24). It all works without
// JavaScript.
//
// All | Unread switches between every alert and the new ones (?show=unread). Each alert is a card
// (UI-07) on paper (UI-15, UI-16) with three lines and nothing else (UI-20): the activity's or
// group's name in the display face, the sentence that says what happened, and how long ago. The
// sentence comes first for screen readers, after "Unread", and the name is drawn above it. An
// unread one is on light blue paper.
//
// Each alert has a Remove button, an × at its top right, and Earlier has Clear, which removes every
// alert that's been read (NOTIF-21). Removing one comes back to the same list, at the alert that took
// its place, so removing several in a row doesn't jump to the top.
import { actions } from 'astro:actions';
import Icon from '../components/Icon.astro';
import PageSentence from '../components/PageSentence.astro';
import Status from '../components/Status.astro';
import Layout from '../layouts/Layout.astro';
import { nextPage, readCursor } from '../lib/feed';
import { describe, type PostedUpdate } from '../lib/notifications';
import { FLASH_MESSAGES, setFlash, takeFlash } from '../lib/server/flash';
import { formatAgo } from '../lib/time';

const PAGE = 30;
const KEPT_DAYS = 90;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const opened = Astro.getActionResult(actions.notifications.open);
if (opened && !opened.error) return Astro.redirect(opened.data.href, 303);
const readAll = Astro.getActionResult(actions.notifications.readAll);
if (readAll && !readAll.error) {
  setFlash(Astro.cookies, Astro.url, 'read');
  return Astro.redirect('/notifications', 303);
}
// This list, as All or Unread and on the page it's on, without an action.
const list = new URLSearchParams(Astro.url.searchParams);
list.delete('_action');
list.delete('near');
const here = `/notifications${list.size ? `?${list}` : ''}`;
const removed = Astro.getActionResult(actions.notifications.remove);
if (removed && !removed.error) {
  setFlash(Astro.cookies, Astro.url, 'alert_removed');
  const near = Astro.url.searchParams.get('near') ?? '';
  return Astro.redirect(UUID.test(near) ? `${here}#alert-${near}` : here, 303);
}
const cleared = Astro.getActionResult(actions.notifications.clearRead);
if (cleared && !cleared.error) {
  setFlash(Astro.cookies, Astro.url, 'cleared');
  return Astro.redirect(here, 303);
}
const failed = opened?.error ?? readAll?.error ?? removed?.error ?? cleared?.error;
const flash = takeFlash(Astro.cookies);

const now = new Date();
const onlyUnread = Astro.url.searchParams.get('show') === 'unread';
const cursor = readCursor(Astro.url.searchParams);
let query = supabase
  .from('notifications')
  .select('id, type, payload, read_at, created_at, activity:activities(title), group:groups(name)')
  .is('removed_at', null)
  .gte('created_at', new Date(now.getTime() - KEPT_DAYS * 24 * 60 * 60 * 1000).toISOString())
  .order('created_at', { ascending: false })
  .order('id', { ascending: false })
  .limit(PAGE + 1);
if (onlyUnread) query = query.is('read_at', null);
if (cursor.after_id) {
  query = query.or(
    `created_at.lt."${cursor.after_starts_at}",and(created_at.eq."${cursor.after_starts_at}",id.lt.${cursor.after_id})`
  );
}
const { data, error } = await query;
const shown = data?.slice(0, PAGE) ?? [];
// Organizer and group updates hold the update's id, and its text is read here, so one a moderator
// hides is gone from the center too (NOTIF-04, GRP-04). Its author and moderators can read a hidden one, so it's
// left out here.
const updateIdOf = (payload: unknown) => {
  const id = (payload as { update_id?: unknown } | null)?.update_id;
  return typeof id === 'string' ? id : '';
};
const updateIds = shown
  .filter(({ type }) => type === 'organizer_update' || type === 'group_update')
  .map(({ payload }) => updateIdOf(payload))
  .filter(Boolean);
const { data: updates } = updateIds.length
  ? await supabase
      .from('activity_updates')
      .select('id, body, author:profiles!activity_updates_author_id_fkey(display_name)')
      .in('id', updateIds)
      .is('hidden_at', null)
  : { data: [] };
const posted = new Map<string, PostedUpdate>(
  updates?.map(({ id, body, author }) => [id, { author: author?.display_name ?? null, body }])
);
const last = shown.at(-1);
const next =
  last && data!.length > PAGE ? nextPage({ starts_at: last.created_at, id: last.id }) : null;
const more = next && onlyUnread ? `${next}&show=unread` : next;
const groups = [
  { name: 'New', items: shown.filter(({ read_at }) => !read_at) },
  { name: 'Earlier', items: shown.filter(({ read_at }) => read_at) },
].filter(({ items }) => items.length > 0);
const unread = groups[0]?.name === 'New' || (onlyUnread && shown.length > 0);
// Where removing an alert comes back to: the one after it, or before it if it was the last.
const order = groups.flatMap(({ items }) => items.map(({ id }) => id));
const removeAction = (id: string) => {
  const query = new URLSearchParams(list);
  const i = order.indexOf(id);
  const near = order[i + 1] ?? order[i - 1];
  if (near) query.set('near', near);
  for (const [key, value] of new URLSearchParams(actions.notifications.remove.queryString)) {
    query.set(key, value);
  }
  return `/notifications?${query}`;
};
---

<Layout title="Alerts" tab="alerts">
  <header class="top">
    <h1 class="visually-hidden">Alerts</h1>
    <PageSentence>Messages that help you keep track of new and changing activities</PageSentence>
    {unread && (
      <form method="post" action={actions.notifications.readAll.queryString}>
        <button class="secondary">Mark all read</button>
      </form>
    )}
  </header>
  <nav class="switch" aria-label="Show">
    <a href="/notifications" aria-current={onlyUnread ? undefined : 'page'}>
      All
    </a>
    <a href="/notifications?show=unread" aria-current={onlyUnread ? 'page' : undefined}>
      Unread
    </a>
  </nav>
  <Status message={flash && FLASH_MESSAGES[flash]} />
  {failed && <p role="alert">{failed.message}</p>}

  {error ? (
    <p role="alert">Your alerts couldn't load. Please try again.</p>
  ) : shown.length === 0 ? (
    <p class="empty">
      {onlyUnread
        ? "You're all caught up."
        : "You're all caught up. We'll let you know when plans change."}
    </p>
  ) : (
    groups.map(({ name, items }) => (
      <section aria-labelledby={`alerts-${name}`}>
        <div class="heading">
          <h2 id={`alerts-${name}`}>{name}</h2>
          {name === 'Earlier' && (
            <form method="post" action={actions.notifications.clearRead.queryString}>
              <button class="clear">
                Clear<span class="visually-hidden"> earlier alerts</span>
              </button>
            </form>
          )}
        </div>
        <ul>
          {items.map((notification) => {
            const { summary } = describe(
              notification.type,
              notification.payload,
              notification.type === 'organizer_update' || notification.type === 'group_update'
                ? (posted.get(updateIdOf(notification.payload)) ?? null)
                : undefined,
              now
            );
            const title =
              notification.activity?.title ?? notification.group?.name ?? 'No longer available';
            return (
              <li id={`alert-${notification.id}`} class:list={{ unread: !notification.read_at }}>
                <form method="post" action={actions.notifications.open.queryString}>
                  <input type="hidden" name="id" value={notification.id} />
                  <button class="alert">
                    <span class="text">
                      <span class="summary">
                        {!notification.read_at && <span class="unread-label">Unread: </span>}
                        {summary}
                      </span>
                      <span class="title">{title}</span>
                      <time datetime={notification.created_at}>
                        {formatAgo(new Date(notification.created_at), now)}
                      </time>
                    </span>
                  </button>
                </form>
                <form class="remove" method="post" action={removeAction(notification.id)}>
                  <input type="hidden" name="id" value={notification.id} />
                  <button aria-label={`Remove alert: ${summary}, ${title}`}>
                    <Icon name="x" />
                  </button>
                </form>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  )}
  {more && (
    <a class="more button" href={`/notifications${more}`}>
      Show more
    </a>
  )}
</Layout>

<style>
  /* Earlier's Clear is at the right of its heading. Both headings are as tall as it, so they're
     spaced alike. */
  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    margin: 0.75rem 0 0;
  }
  h2 {
    margin: 0;
    font-size: 0.875rem;
    text-transform: capitalize;
  }
  /* Quiet words, in red, since it removes (UI-12). */
  .clear {
    min-height: 44px;
    padding: 0 0.25rem;
    color: var(--danger);
    font-family: inherit;
    font-size: 0.875rem;
    letter-spacing: normal;
    text-transform: none;
    background: none;
  }
  .clear:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
    background: none;
  }
  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Remove sits on the card's top right, so the card leaves room for it. */
  li {
    position: relative;
    scroll-margin-top: 6rem;
  }
  /* Each alert is a piece of white paper with square corners and a shadow, and the whole piece is
     one button (UI-15, UI-16). Like every list, the pieces stay straight. */
  .alert {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.625rem 2.75rem 0.625rem 0.875rem;
    font: inherit;
    font-weight: 400;
    color: inherit;
    text-align: left;
    border: 1px solid transparent;
    background: var(--card);
    border-radius: 0;
    box-shadow: var(--lift);
    letter-spacing: normal;
    text-transform: none;
  }
  /* An unread alert is on light blue paper, with a dot before its name, so it isn't shown by color
     alone. Screen readers hear "Unread" first. */
  .unread .alert {
    background: var(--sky);
  }
  /* There's no border to color on hover, so the name is underlined. */
  .alert:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  /* The name is drawn first, above what happened, which screen readers hear first. */
  .text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  /* In the display face, each word starting with a capital by CSS, like an activity's title (UI-30). */
  .title {
    order: -1;
    font-family: var(--display);
    font-size: 1.125rem;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--navy);
    text-transform: capitalize;
    overflow-wrap: anywhere;
  }
  /* The dot is a border, not a background, so it still shows in high contrast. */
  .unread .title::before {
    display: inline-block;
    box-sizing: border-box;
    width: 0.625rem;
    height: 0.625rem;
    margin-right: 0.5rem;
    vertical-align: 0.2em;
    content: '';
    border: 0.3125rem solid var(--blue-text);
    border-radius: 0;
  }
  /* The sentence wraps to as many lines as it needs. */
  .summary {
    overflow-wrap: anywhere;
  }
  .unread-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  time {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .empty {
    margin-top: 2rem;
    text-align: center;
  }
  .more {
    display: flex;
    margin-top: 1rem;
  }
  /* Remove: an × in the muted color, 44 px square, that turns red on hover. */
  .remove {
    position: absolute;
    top: 0;
    right: 0;
  }
  .remove button {
    display: grid;
    place-items: center;
    width: 44px;
    padding: 0;
    color: var(--muted);
    background: none;
  }
  .remove button:hover {
    color: var(--danger);
    background: none;
  }
  /* High contrast: a plain border in the system's colors, as everywhere else. */
  @media (forced-colors: active) {
    .alert {
      background: Canvas !important;
      border-color: CanvasText !important;
      box-shadow: none !important;
    }
  }
</style>
