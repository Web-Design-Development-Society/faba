---
// Reporting a member (MOD-01), from Report in the ⋯ menu on their profile. Sending it goes back to
// the profile, which says thanks.
import { actions } from 'astro:actions';
import ReportForm from '../../../components/ReportForm.astro';
import Layout from '../../../layouts/Layout.astro';
import { setFlash } from '../../../lib/server/flash';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const id = Astro.params.id!;
const result = Astro.getActionResult(actions.reports.create);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'reported');
  return Astro.redirect(`/people/${id}`, 303);
}

// What report_content() takes: an active member, as on their profile. The member's own earlier
// report, by reporter, since moderators will read everyone's.
const [{ data: profile }, { data: report }] = await Promise.all([
  supabase
    .from('profiles')
    .select('id, display_name')
    .eq('id', id)
    .eq('status', 'active')
    .maybeSingle(),
  supabase
    .from('reports')
    .select('id')
    .eq('reporter_id', user.id)
    .eq('target_type', 'profile')
    .eq('target_id', id)
    .maybeSingle(),
]);
if (!profile) Astro.response.status = 404;
---

<Layout title={profile ? `Report ${profile.display_name}` : 'Not available'}>
  {profile ? (
    <>
      <a href={`/people/${profile.id}`}>Back to {profile.display_name}</a>
      <h1>Report this member</h1>
      <ReportForm
        type="profile"
        id={profile.id}
        mine={profile.id === user.id}
        reported={!!report}
      />
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This member is no longer active.</p>
    </>
  )}
</Layout>
