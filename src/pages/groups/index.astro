---
// Groups (GRP-01, design document section 7.3): Discover's other half. Every group that isn't
// archived, by name, each a card with its banner, its category, how many members it has (GRP-02),
// whether anyone can join, and the start of its description (UI-10). Members can't read a hidden
// one (RLS). Start a group is at the top.
import DiscoverSwitch from '../../components/DiscoverSwitch.astro';
import GroupCard from '../../components/GroupCard.astro';
import Status from '../../components/Status.astro';
import Layout from '../../layouts/Layout.astro';
import { FLASH_MESSAGES, takeFlash } from '../../lib/server/flash';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');
const flash = takeFlash(Astro.cookies);

const { data: groups, error } = await supabase
  .from('groups')
  .select(
    'slug, name, description, kind, join_policy, member_count, my_membership, category:categories(name, icon, color_token), banner:images!groups_banner_image_id_fkey(id, hidden_at)'
  )
  .is('archived_at', null)
  .order('name')
  .order('slug');
---

<Layout title="Groups · Discover" tab="discover">
  <header class="top">
    <h1>Discover</h1>
    <a href="/groups/new">Start a group</a>
    <a href="/leagues/new">Start a league</a>
  </header>
  <DiscoverSwitch current="groups" />
  <Status message={flash && FLASH_MESSAGES[flash]} />

  {error ? (
    <p role="alert">Groups couldn't load. Please try again.</p>
  ) : !groups?.length ? (
    <div class="empty">
      <p>No groups yet. Start one around something you love.</p>
      <a href="/groups/new">Start a group</a>
    </div>
  ) : (
    <ul class="groups">
      {groups.map((group) => (
        <li>
          <GroupCard group={group} />
        </li>
      ))}
    </ul>
  )}
</Layout>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .top a,
  .empty a {
    display: inline-grid;
    place-items: center;
    min-height: 44px;
  }
  /* minmax(0, 1fr) keeps a card with a long name from widening the column. */
  .groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .empty {
    margin-top: 2rem;
    text-align: center;
  }
</style>
