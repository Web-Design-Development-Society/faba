---
// Reporting a group (MOD-08), from Report group on its page. Sending it goes back to the group, which
// says thanks. A group's owner can't report it, and a hidden group isn't here.
import { actions } from 'astro:actions';
import Back from '../../../components/Back.astro';
import ReportForm from '../../../components/ReportForm.astro';
import Layout from '../../../layouts/Layout.astro';
import { setFlash } from '../../../lib/server/flash';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const slug = Astro.params.slug!;
const result = Astro.getActionResult(actions.reports.create);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'reported');
  return Astro.redirect(`/groups/${slug}`, 303);
}

// The group, if it isn't hidden, and the member's own earlier report of it.
const { data: group } = await supabase
  .from('groups')
  .select('id, slug, name, owner_id, hidden_at')
  .eq('slug', slug)
  .is('hidden_at', null)
  .maybeSingle();
const { data: report } = group
  ? await supabase
      .from('reports')
      .select('id')
      .eq('reporter_id', user.id)
      .eq('target_type', 'group')
      .eq('target_id', group.id)
      .maybeSingle()
  : { data: null };
if (!group) Astro.response.status = 404;
---

<Layout title={group ? `Report ${group.name}` : 'Not available'} tab="discover">
  {group ? (
    <>
      <Back href={`/groups/${group.slug}`}>Back to {group.name}</Back>
      <h1>Report this group</h1>
      <ReportForm
        type="group"
        id={group.id}
        mine={group.owner_id === user.id}
        reported={!!report}
      />
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This group isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
</Layout>
