---
// A group's page (GRP-01): its name, category, who started it, who can join, how many members it
// has and what it's about. Members can't read a hidden group (RLS), so it's not available to them.
// Join, Request to join, Withdraw request and Leave group (GRP-02) work without JavaScript. Its
// upcoming activities follow, and its organizers have Post an activity (GRP-03). RLS leaves out the
// members-only ones for anyone outside the group. Its updates come last, newest first, for its
// members, and its organizers have Post update (GRP-04). Each can be reported. Its members and
// moderators see who's in it after Coming up (UI-23), and those who can manage it have Manage
// members, a sheet with who's asking to join, roles, removing and handing it on (GRP-05).
import { actions } from 'astro:actions';
import ActivityCard from '../../../components/ActivityCard.astro';
import Avatar from '../../../components/Avatar.astro';
import Back from '../../../components/Back.astro';
import CoverPicture from '../../../components/CoverPicture.astro';
import FollowButton from '../../../components/FollowButton.astro';
import Menu from '../../../components/Menu.astro';
import PictureUpload from '../../../components/PictureUpload.astro';
import Sheet from '../../../components/Sheet.astro';
import Status from '../../../components/Status.astro';
import Layout from '../../../layouts/Layout.astro';
import { profileHref } from '../../../lib/back';
import { CARD, historySince } from '../../../lib/cards';
import { LEAGUES } from '../../../lib/features';
import { linkify } from '../../../lib/links';
import {
  type Flash,
  FLASH_MESSAGES,
  pictureRefusal,
  setFlash,
  takeFlash,
} from '../../../lib/server/flash';
import { formatAgo } from '../../../lib/time';

const { supabase, user, member } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const join = Astro.getActionResult(actions.groups.join);
if (join && !join.error) {
  setFlash(Astro.cookies, Astro.url, join.data.status === 'active' ? 'joined' : 'requested');
  return Astro.redirect(Astro.url.pathname, 303);
}
const leave = Astro.getActionResult(actions.groups.leave);
if (leave && !leave.error) {
  setFlash(Astro.cookies, Astro.url, leave.data.pending ? 'withdrawn' : 'left');
  return Astro.redirect(Astro.url.pathname, 303);
}
// Managing its members, from the sheet (GRP-05, UI-23).
const approve = Astro.getActionResult(actions.groups.approve);
const remove = Astro.getActionResult(actions.groups.remove);
const setRole = Astro.getActionResult(actions.groups.setRole);
const managed: Flash | null =
  approve && !approve.error
    ? 'approved'
    : remove && !remove.error
      ? remove.data.pending
        ? 'declined'
        : 'removed'
      : setRole && !setRole.error
        ? setRole.data.role === 'organizer'
          ? 'made_organizer'
          : 'made_member'
        : null;
if (managed) {
  setFlash(Astro.cookies, Astro.url, managed);
  return Astro.redirect(`${Astro.url.pathname}#members`, 303);
}
const failure = (join?.error ?? leave?.error ?? approve?.error ?? remove?.error ?? setRole?.error)
  ?.message;
const flash = takeFlash(Astro.cookies);
// A refused banner says why next to its form, not in the toast (MEDIA-01).
const pictureError = pictureRefusal(flash);

const { data: group } = await supabase
  .from('groups')
  .select(
    'id, slug, name, description, kind, join_policy, owner_id, archived_at, hidden_at, member_count, my_membership, category:categories(name), owner:profiles!groups_owner_id_fkey(id, display_name), banner:images!groups_banner_image_id_fkey(id, alt, uploaded_by, hidden_at, hidden_reason)'
  )
  .eq('slug', Astro.params.slug!)
  .maybeSingle();
if (!group) Astro.response.status = 404;
const now = new Date();
// Its activities that are coming up or underway, as in the feed, and whether the member organizes
// the group.
const [{ data: activities }, { data: me }, { data: updates }] = group
  ? await Promise.all([
      supabase
        .from('activities')
        .select(CARD)
        .eq('group_id', group.id)
        .eq('status', 'published')
        .is('hidden_at', null)
        .gte('starts_at', new Date(now.getTime() - 3 * 60 * 60 * 1000).toISOString())
        .order('starts_at')
        .order('id')
        .limit(20),
      supabase
        .from('group_members')
        .select('role')
        .eq('group_id', group.id)
        .eq('user_id', user.id)
        .eq('status', 'active')
        .maybeSingle(),
      // Only its members, its authors and moderators read them (RLS).
      supabase
        .from('activity_updates')
        .select(
          'id, body, created_at, author_id, hidden_at, hidden_reason, author:profiles!activity_updates_author_id_fkey(display_name)'
        )
        .eq('group_id', group.id)
        .order('created_at', { ascending: false })
        .limit(20),
    ])
  : [{ data: null }, { data: null }, { data: null }];
// Its past activities, from the last 24 months, newest first, each saying whether the member went
// or organized it (HIST-01). Only the member's own RSVPs show, as RLS allows.
const { data: past } = group
  ? await supabase
      .from('activities')
      .select(CARD)
      .eq('group_id', group.id)
      .in('status', ['published', 'cancelled'])
      .is('hidden_at', null)
      .lt('starts_at', new Date(now.getTime() - 3 * 60 * 60 * 1000).toISOString())
      .gte('starts_at', historySince(now))
      .order('starts_at', { ascending: false })
      .order('id', { ascending: false })
      .limit(20)
  : { data: null };
const organizer = me?.role === 'owner' || me?.role === 'organizer';
// A hidden picture's label, with the moderator's reason when there is one.
const withReason = (label: string, reason: string | null) =>
  reason ? `${label}. Reason: ${reason}` : label;
const moderator =
  member?.status === 'active' && (member.role === 'moderator' || member.role === 'admin');
// Who's in it, for its members and moderators. RLS lets them read them all, and anyone else only
// their own, so anyone else sees just the count.
const { data: rows } =
  group && (me || moderator)
    ? await supabase
        .from('group_members')
        .select(
          'user_id, role, status, profile:profiles!group_members_user_id_fkey(id, display_name, avatar_url, use_initials, department, status)'
        )
        .eq('group_id', group.id)
    : { data: null };
const people = (rows ?? [])
  .filter(({ profile }) => profile?.status === 'active')
  .map(({ role, status, profile }) => ({ ...profile!, role, status }))
  .sort((a, b) => a.display_name.localeCompare(b.display_name));
const requests = organizer ? people.filter(({ status }) => status === 'pending') : [];
const asking = requests.length;
const active = people.filter(({ status }) => status === 'active');
// The owner, then its organizers, then everyone else, each by name.
const rank = { owner: 0, organizer: 1, member: 2 } as Record<string, number>;
const listed = active.toSorted((a, b) => rank[a.role] - rank[b.role]);
const owner = me?.role === 'owner';
const organizers = active.filter(({ role }) => role === 'organizer');
const others = active.filter(({ role, id }) => role === 'member' && id !== user.id);
// Manage members is for its organizers, and for moderators, who can hand it on.
const manage = organizer || moderator;
const mine = group?.owner_id === user.id;
const membership = group?.my_membership ?? null;
// Whether the member follows the group (NOTIF-09). Only active members can, so only they see it.
const { data: following } =
  group && membership === 'active'
    ? await supabase
        .from('follows')
        .select('target_id')
        .eq('user_id', user.id)
        .eq('target_type', 'group')
        .eq('target_id', group.id)
        .maybeSingle()
    : { data: null };
const followed = Astro.getActionResult(actions.follows.set);
const followError = followed?.error?.message ?? null;
const members = group?.member_count ?? 0;
---

<Layout title={group?.name ?? 'Not available'} tab="discover" paper>
  <header class="top">
    <Back href="/groups">Back to Groups</Back>
    {group && user.id !== group.owner_id && (
      <Menu>
        <li>
          <a href={`/groups/${group.slug}/report`}>Report group</a>
        </li>
      </Menu>
    )}
  </header>
  <Status message={flash && !pictureError ? FLASH_MESSAGES[flash] : undefined} />
  {failure && <p role="alert">{failure}</p>}
  {group ? (
    <>
      {group.hidden_at && <p class="banner">Hidden by a moderator</p>}
      {group.archived_at && <p class="banner">This group is archived.</p>}
      {/* The name, then joining it, then its banner, and each fact under a plain heading (UI-26). */}
      <h1>{group.name}</h1>
      {!mine && (
        <div class="membership">
          {membership === 'active' ? (
            <>
              <p>✓ You're a member</p>
              <form method="post" action={actions.groups.leave.queryString}>
                <input type="hidden" name="group_id" value={group.id} />
                <button class="secondary">Leave group</button>
              </form>
              {followError && <p role="alert">{followError}</p>}
              <FollowButton
                kind="group"
                target={group.id}
                name={group.name}
                following={!!following}
              />
            </>
          ) : membership === 'pending' ? (
            <>
              <p>Requested. You're in once an organizer approves it.</p>
              <form method="post" action={actions.groups.leave.queryString}>
                <input type="hidden" name="group_id" value={group.id} />
                <input type="hidden" name="pending" value="true" />
                <button class="secondary">Withdraw request</button>
              </form>
            </>
          ) : group.archived_at ? null : (
            <form method="post" action={actions.groups.join.queryString}>
              <input type="hidden" name="group_id" value={group.id} />
              <button class="primary">
                {group.join_policy === 'open' ? 'Join' : 'Request to join'}
              </button>
            </form>
          )}
        </div>
      )}
      {group.banner && !group.banner.hidden_at && (
        <CoverPicture image={group.banner} viewer={user.id} shape="banner" />
      )}
      {group.banner?.hidden_at && (
        <p class="hidden">
          {withReason('Picture hidden by a moderator', group.banner.hidden_reason)}
        </p>
      )}
      <section class="topic" aria-labelledby="about-heading">
        <h2 id="about-heading">About</h2>
        {group.description && (
          <p class="description">
            {linkify(group.description).map(({ text, href }) =>
              href ? (
                <a href={href} rel="nofollow ugc noopener">
                  {text}
                </a>
              ) : (
                text
              )
            )}
          </p>
        )}
        <p class="fact">
          {mine ? (
            'You started this group'
          ) : group.owner ? (
            <>
              Started by{' '}
              <a href={profileHref(group.owner.id, `/groups/${group.slug}`)}>
                {group.owner.display_name}
              </a>
            </>
          ) : (
            'Its owner left FABA'
          )}
        </p>
        <p class="fact">
          {members} {members === 1 ? 'member' : 'members'} ·{' '}
          {group.join_policy === 'open' ? 'Anyone can join' : 'Ask to join'}
          {!!asking && (
            <>
              {' · '}
              <button type="button" class="quiet asking" commandfor="manage" command="show-modal">
                {asking} asking to join
              </button>
            </>
          )}
        </p>
      </section>
      {group.category && (
        <section class="topic" aria-labelledby="category-heading">
          <h2 id="category-heading">Category</h2>
          <p class="fact">{group.category.name}</p>
        </section>
      )}
      {LEAGUES && group.kind === 'league' && (
        <p>
          <a href={`/groups/${group.slug}/seasons`} class="button">
            Seasons
          </a>
        </p>
      )}
      <section aria-labelledby="activities" class="activities topic">
        <header class="topic-head">
          <h2 id="activities">Coming up</h2>
          {organizer && !group.archived_at && !group.hidden_at && (
            <a href={`/activities/new?group=${group.id}`} class="button">
              Post an activity
            </a>
          )}
        </header>
        {activities?.length ? (
          <ul>
            {activities.map((activity) => (
              <li>
                <ActivityCard activity={activity} viewer={user.id} now={now} />
              </li>
            ))}
          </ul>
        ) : (
          <p>Nothing planned yet.</p>
        )}
      </section>
      {/* Everyone in it, on its page (UI-23), like who's going to an activity (UI-21). */}
      {listed.length > 0 && (
        <section id="members" aria-labelledby="members-heading" class="members topic">
          <header class="topic-head">
            <h2 id="members-heading">Members</h2>
            {manage && (
              <button type="button" class="quiet" commandfor="manage" command="show-modal">
                Manage members
              </button>
            )}
          </header>
          <ul class="people">
            {listed.map((person) => (
              <li>
                <Avatar member={person} />
                <span>
                  <a href={profileHref(person.id, `/groups/${group.slug}`)}>
                    {person.display_name}
                  </a>
                  {person.role === 'owner' && <span class="badge">Owner</span>}
                  {person.role === 'organizer' && <span class="badge">Organizer</span>}
                  {person.department && <span class="department">{person.department}</span>}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
      {/* Approving, roles, removing and handing it on, for those who can (GRP-05). Postgres checks
          every rule again. */}
      {manage && (
        <Sheet id="manage" title="Manage members">
          {requests.length > 0 && (
            <section aria-labelledby="requests" class="manage">
              <h3 id="requests">Asking to join</h3>
              <ul>
                {requests.map((person) => (
                  <li>
                    <span>{person.display_name}</span>
                    <div class="actions">
                      {!group.archived_at && (
                        <form method="post" action={actions.groups.approve.queryString}>
                          <input type="hidden" name="group_id" value={group.id} />
                          <input type="hidden" name="user_id" value={person.id} />
                          <button aria-label={`Approve ${person.display_name}`}>Approve</button>
                        </form>
                      )}
                      <form method="post" action={actions.groups.remove.queryString}>
                        <input type="hidden" name="group_id" value={group.id} />
                        <input type="hidden" name="user_id" value={person.id} />
                        <input type="hidden" name="pending" value="true" />
                        <button class="secondary" aria-label={`Decline ${person.display_name}`}>
                          Decline
                        </button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {owner && organizers.length > 0 && (
            <section aria-labelledby="organizers" class="manage">
              <h3 id="organizers">Organizers</h3>
              <ul>
                {organizers.map((person) => (
                  <li>
                    <span>{person.display_name}</span>
                    <div class="actions">
                      <form method="post" action={actions.groups.setRole.queryString}>
                        <input type="hidden" name="group_id" value={group.id} />
                        <input type="hidden" name="user_id" value={person.id} />
                        <input type="hidden" name="role" value="member" />
                        {/* The visible words start the name, then whose it is (WCAG 2.5.3). */}
                        <button
                          class="secondary"
                          aria-label={`Make member: ${person.display_name}`}
                        >
                          Make member
                        </button>
                      </form>
                      <form method="post" action={actions.groups.remove.queryString}>
                        <input type="hidden" name="group_id" value={group.id} />
                        <input type="hidden" name="user_id" value={person.id} />
                        <button class="danger" aria-label={`Remove ${person.display_name}`}>
                          Remove
                        </button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {organizer && others.length > 0 && (
            <section aria-labelledby="everyone" class="manage">
              <h3 id="everyone">Members</h3>
              <ul>
                {others.map((person) => (
                  <li>
                    <span>{person.display_name}</span>
                    <div class="actions">
                      {owner && (
                        <form method="post" action={actions.groups.setRole.queryString}>
                          <input type="hidden" name="group_id" value={group.id} />
                          <input type="hidden" name="user_id" value={person.id} />
                          <input type="hidden" name="role" value="organizer" />
                          <button
                            class="secondary"
                            aria-label={`Make organizer: ${person.display_name}`}
                          >
                            Make organizer
                          </button>
                        </form>
                      )}
                      <form method="post" action={actions.groups.remove.queryString}>
                        <input type="hidden" name="group_id" value={group.id} />
                        <input type="hidden" name="user_id" value={person.id} />
                        <button class="danger" aria-label={`Remove ${person.display_name}`}>
                          Remove
                        </button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {organizer && !requests.length && !others.length && !(owner && organizers.length) && (
            <p>Nobody else has joined yet.</p>
          )}
          {(owner || moderator) && (
            <p>
              <a class="button" href={`/groups/${group.slug}/owner`}>
                Hand on this group
              </a>
            </p>
          )}
        </Sheet>
      )}
      {past?.length ? (
        <section aria-labelledby="past" class="activities past topic">
          <h2 id="past">Past</h2>
          <ul>
            {past.map((activity) => (
              <li>
                <ActivityCard
                  activity={activity}
                  viewer={user.id}
                  now={now}

                  history
                />
              </li>
            ))}
          </ul>
        </section>
      ) : null}
      {(organizer || (updates?.length ?? 0) > 0) && (
        <section id="updates" aria-labelledby="updates-title" class="updates topic">
          <header class="topic-head">
            <h2 id="updates-title">Updates</h2>
            {organizer && !group.archived_at && !group.hidden_at && (
              <a href={`/groups/${group.slug}/update`} class="button">
                Post update
              </a>
            )}
          </header>
          {updates?.length ? (
            <ul>
              {updates.map((update) => (
                <li>
                  {update.hidden_at && (
                    <p class="hidden">
                      {update.hidden_reason
                        ? `Hidden by a moderator: ${update.hidden_reason}`
                        : 'Hidden by a moderator'}
                    </p>
                  )}
                  <p class="description">
                    {linkify(update.body).map(({ text, href }) =>
                      href ? (
                        <a href={href} rel="nofollow ugc noopener">
                          {text}
                        </a>
                      ) : (
                        text
                      )
                    )}
                  </p>
                  <p class="byline">
                    {update.author?.display_name ?? 'A former member'} ·{' '}
                    <time datetime={update.created_at}>
                      {formatAgo(new Date(update.created_at), now)}
                    </time>
                    {update.author_id !== user.id && !update.hidden_at && (
                      <>
                        {' · '}
                        <a href={`/groups/${group.slug}/updates/${update.id}/report`}>Report</a>
                      </>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p>No updates yet.</p>
          )}
        </section>
      )}
      {/* Changing the banner, for its organizers, last, like an activity's cover picture. */}
      {organizer && !group.archived_at && !group.hidden_at && (
        <section class="topic" aria-labelledby="banner-heading">
          <h2 id="banner-heading">Banner</h2>
          <details class="banner-upload" open={pictureError ? true : undefined}>
            <summary class="button">Change the banner</summary>
            <PictureUpload
              target="group"
              id={group.id}
              back={`/groups/${group.slug}`}
              submit="Save banner"
              error={pictureError}
            />
          </details>
        </section>
      )}
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This group isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
</Layout>

<style>
  /* Back at the left and the ⋯ menu at the right. */
  .top {
    justify-content: space-between;
  }
  .description {
    white-space: pre-line;
  }
  .fact {
    margin: 0.5rem 0 0;
  }
  .activities ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .updates ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .updates li + li {
    border-top: 1px solid var(--border);
  }
  .byline {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  /* Report, at least 24 px tall (WCAG 2.2 target size). */
  .byline a {
    display: inline-block;
    padding: 0.25rem 0;
  }
  .hidden {
    margin-bottom: 0;
    padding: 0.25rem 0.75rem;
    font-weight: 600;
    border-left: 0.25rem solid var(--danger);
    background: var(--danger-soft);
  }
  /* Manage members and "2 asking to join" are quiet, like Manage attendees (UI-21): words in the
     darker FABA blue, still 44 px tall, underlined on hover. */
  .quiet {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 44px;
    padding: 0 0.25rem;
    color: var(--blue-dark);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    background: none;
    border: 0;
    cursor: pointer;
    letter-spacing: normal;
    text-transform: none;
  }
  .quiet:hover {
    text-decoration: underline;
    background: none;
  }
  /* In a sentence, so underlined to show it does something. */
  .asking {
    text-decoration: underline;
  }
  .people,
  .manage ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.25rem 0;
  }
  .people a {
    display: inline-block;
    padding: 0.25rem 0;
  }
  .badge {
    margin-left: 0.5rem;
    padding: 0 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: 0;
  }
  .department {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--muted);
  }
  .manage h3 {
    margin: 1rem 0 0.25rem;
    font-size: 1rem;
  }
  .manage li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .actions button {
    padding: 0 0.75rem;
  }
  .membership {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .membership p {
    margin: 0;
  }
  .membership button {
    min-width: 8rem;
    min-height: 44px;
  }
  .primary {
    font-weight: 600;
  }
  .banner {
    padding: 0.75rem 1rem;
    border-left: 0.25rem solid var(--danger);
    background: var(--danger-soft);
  }
</style>
