---
// A group's page (GRP-01): its name, category, who started it, who can join, how many members it
// has and what it's about. Members can't read a hidden group (RLS), so it's not available to them.
// Join, Request to join, Withdraw request and Leave group (GRP-02) work without JavaScript. Its
// upcoming activities follow, and its organizers have Post an activity (GRP-03). RLS leaves out the
// members-only ones for anyone outside the group. Its updates come last, newest first, for its
// members, and its organizers have Post update (GRP-04). Each can be reported. Its members and
// moderators open who's in it from the member count, and its organizers see how many are asking to
// join (GRP-05).
import { actions } from 'astro:actions';
import ActivityCard from '../../../components/ActivityCard.astro';
import FollowButton from '../../../components/FollowButton.astro';
import Status from '../../../components/Status.astro';
import Layout from '../../../layouts/Layout.astro';
import { CARD, FACES, historySince } from '../../../lib/cards';
import { linkify } from '../../../lib/links';
import { FLASH_MESSAGES, setFlash, takeFlash } from '../../../lib/server/flash';
import { formatAgo } from '../../../lib/time';

const { supabase, user, member } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const join = Astro.getActionResult(actions.groups.join);
if (join && !join.error) {
  setFlash(Astro.cookies, Astro.url, join.data.status === 'active' ? 'joined' : 'requested');
  return Astro.redirect(Astro.url.pathname, 303);
}
const leave = Astro.getActionResult(actions.groups.leave);
if (leave && !leave.error) {
  setFlash(Astro.cookies, Astro.url, leave.data.pending ? 'withdrawn' : 'left');
  return Astro.redirect(Astro.url.pathname, 303);
}
const failure = (join?.error ?? leave?.error)?.message;
const flash = takeFlash(Astro.cookies);

const { data: group } = await supabase
  .from('groups')
  .select(
    'id, slug, name, description, join_policy, owner_id, archived_at, hidden_at, member_count, my_membership, category:categories(name), owner:profiles!groups_owner_id_fkey(id, display_name)'
  )
  .eq('slug', Astro.params.slug!)
  .maybeSingle();
if (!group) Astro.response.status = 404;
const now = new Date();
// Its activities that are coming up or underway, as in the feed, and whether the member organizes
// the group.
const [{ data: activities }, { data: me }, { data: updates }] = group
  ? await Promise.all([
      supabase
        .from('activities')
        .select(CARD)
        .eq('group_id', group.id)
        .eq('status', 'published')
        .is('hidden_at', null)
        .gte('starts_at', new Date(now.getTime() - 3 * 60 * 60 * 1000).toISOString())
        .eq('going.status', 'going')
        .order('starts_at')
        .order('id')
        .order('created_at', { referencedTable: 'going' })
        .limit(FACES, { referencedTable: 'going' })
        .limit(20),
      supabase
        .from('group_members')
        .select('role')
        .eq('group_id', group.id)
        .eq('user_id', user.id)
        .eq('status', 'active')
        .maybeSingle(),
      // Only its members, its authors and moderators read them (RLS).
      supabase
        .from('activity_updates')
        .select(
          'id, body, created_at, author_id, hidden_at, hidden_reason, author:profiles!activity_updates_author_id_fkey(display_name)'
        )
        .eq('group_id', group.id)
        .order('created_at', { ascending: false })
        .limit(20),
    ])
  : [{ data: null }, { data: null }, { data: null }];
// Its past activities, from the last 24 months, newest first, each saying whether the member went
// or organized it (HIST-01). Only the member's own RSVPs show, as RLS allows.
const { data: past } = group
  ? await supabase
      .from('activities')
      .select(CARD)
      .eq('group_id', group.id)
      .in('status', ['published', 'cancelled'])
      .is('hidden_at', null)
      .lt('starts_at', new Date(now.getTime() - 3 * 60 * 60 * 1000).toISOString())
      .gte('starts_at', historySince(now))
      .eq('going.status', 'going')
      .order('starts_at', { ascending: false })
      .order('id', { ascending: false })
      .order('created_at', { referencedTable: 'going' })
      .limit(FACES, { referencedTable: 'going' })
      .limit(20)
  : { data: null };
const organizer = me?.role === 'owner' || me?.role === 'organizer';
const moderator =
  member?.status === 'active' && (member.role === 'moderator' || member.role === 'admin');
const { count: asking } =
  group && organizer
    ? await supabase
        .from('group_members')
        .select('user_id', { count: 'exact', head: true })
        .eq('group_id', group.id)
        .eq('status', 'pending')
    : { count: 0 };
const mine = group?.owner_id === user.id;
const membership = group?.my_membership ?? null;
// Whether the member follows the group (NOTIF-09). Only active members can, so only they see it.
const { data: following } =
  group && membership === 'active'
    ? await supabase
        .from('follows')
        .select('target_id')
        .eq('user_id', user.id)
        .eq('target_type', 'group')
        .eq('target_id', group.id)
        .maybeSingle()
    : { data: null };
const followed = Astro.getActionResult(actions.follows.set);
const followError = followed?.error?.message ?? null;
const members = group?.member_count ?? 0;
---

<Layout title={group?.name ?? 'Not available'} tab="discover">
  <a href="/groups">Back to Groups</a>
  <Status message={flash && FLASH_MESSAGES[flash]} />
  {failure && <p role="alert">{failure}</p>}
  {group ? (
    <>
      {group.hidden_at && <p class="banner">Hidden by a moderator</p>}
      {group.archived_at && <p class="banner">This group is archived.</p>}
      {group.category && <p class="category">{group.category.name}</p>}
      <h1>{group.name}</h1>
      <p>
        {me || moderator ? (
          <a href={`/groups/${group.slug}/members`}>
            {members} {members === 1 ? 'member' : 'members'}
          </a>
        ) : (
          <>
            {members} {members === 1 ? 'member' : 'members'}
          </>
        )}{' '}
        · {group.join_policy === 'open' ? 'Anyone can join' : 'Ask to join'}
        {!!asking && (
          <>
            {' · '}
            <a href={`/groups/${group.slug}/members`}>{asking} asking to join</a>
          </>
        )}
      </p>
      <p>
        {mine ? (
          'You started this group'
        ) : group.owner ? (
          <>
            Started by <a href={`/people/${group.owner.id}`}>{group.owner.display_name}</a>
          </>
        ) : (
          'Its owner left FABA'
        )}
      </p>
      {!mine && (
        <div class="membership">
          {membership === 'active' ? (
            <>
              <p>✓ You're a member</p>
              <form method="post" action={actions.groups.leave.queryString}>
                <input type="hidden" name="group_id" value={group.id} />
                <button>Leave group</button>
              </form>
              {followError && <p role="alert">{followError}</p>}
              <FollowButton
                kind="group"
                target={group.id}
                name={group.name}
                following={!!following}
              />
            </>
          ) : membership === 'pending' ? (
            <>
              <p>Requested. You're in once an organizer approves it.</p>
              <form method="post" action={actions.groups.leave.queryString}>
                <input type="hidden" name="group_id" value={group.id} />
                <input type="hidden" name="pending" value="true" />
                <button>Withdraw request</button>
              </form>
            </>
          ) : group.archived_at ? null : (
            <form method="post" action={actions.groups.join.queryString}>
              <input type="hidden" name="group_id" value={group.id} />
              <button class="primary">
                {group.join_policy === 'open' ? 'Join' : 'Request to join'}
              </button>
            </form>
          )}
        </div>
      )}
      {group.description && (
        <p class="description">
          {linkify(group.description).map(({ text, href }) =>
            href ? (
              <a href={href} rel="nofollow ugc noopener">
                {text}
              </a>
            ) : (
              text
            )
          )}
        </p>
      )}
      {user.id !== group.owner_id && (
        <p>
          <a href={`/groups/${group.slug}/report`}>Report group</a>
        </p>
      )}
      <section aria-labelledby="activities" class="activities">
        <header>
          <h2 id="activities">Coming up</h2>
          {organizer && !group.archived_at && !group.hidden_at && (
            <a href={`/activities/new?group=${group.id}`}>Post an activity</a>
          )}
        </header>
        {activities?.length ? (
          <ul>
            {activities.map((activity) => (
              <li>
                <ActivityCard activity={activity} viewer={user.id} now={now} faces={FACES} />
              </li>
            ))}
          </ul>
        ) : (
          <p>Nothing planned yet.</p>
        )}
      </section>
      {past?.length ? (
        <section aria-labelledby="past" class="activities past">
          <header>
            <h2 id="past">Past</h2>
          </header>
          <ul>
            {past.map((activity) => (
              <li>
                <ActivityCard
                  activity={activity}
                  viewer={user.id}
                  now={now}
                  faces={FACES}
                  history
                />
              </li>
            ))}
          </ul>
        </section>
      ) : null}
      {(organizer || (updates?.length ?? 0) > 0) && (
        <section id="updates" aria-labelledby="updates-title" class="updates">
          <header>
            <h2 id="updates-title">Updates</h2>
            {organizer && !group.archived_at && !group.hidden_at && (
              <a href={`/groups/${group.slug}/update`}>Post update</a>
            )}
          </header>
          {updates?.length ? (
            <ul>
              {updates.map((update) => (
                <li>
                  {update.hidden_at && (
                    <p class="hidden">
                      {update.hidden_reason
                        ? `Hidden by a moderator: ${update.hidden_reason}`
                        : 'Hidden by a moderator'}
                    </p>
                  )}
                  <p class="description">
                    {linkify(update.body).map(({ text, href }) =>
                      href ? (
                        <a href={href} rel="nofollow ugc noopener">
                          {text}
                        </a>
                      ) : (
                        text
                      )
                    )}
                  </p>
                  <p class="byline">
                    {update.author?.display_name ?? 'A former member'} ·{' '}
                    <time datetime={update.created_at}>
                      {formatAgo(new Date(update.created_at), now)}
                    </time>
                    {update.author_id !== user.id && !update.hidden_at && (
                      <>
                        {' · '}
                        <a href={`/groups/${group.slug}/updates/${update.id}/report`}>Report</a>
                      </>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p>No updates yet.</p>
          )}
        </section>
      )}
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This group isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
</Layout>

<style>
  .category {
    margin-bottom: 0;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .description {
    white-space: pre-line;
  }
  .activities header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .activities h2 {
    font-size: 1rem;
  }
  .activities header a {
    display: inline-grid;
    place-items: center;
    min-height: 44px;
  }
  .activities ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .updates header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .updates h2 {
    font-size: 1rem;
  }
  .updates header a {
    display: inline-grid;
    place-items: center;
    min-height: 44px;
  }
  .updates ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .updates li + li {
    border-top: 1px solid #767676;
  }
  .byline {
    font-size: 0.875rem;
    color: #595959;
  }
  /* Report, at least 24 px tall (WCAG 2.2 target size). */
  .byline a {
    display: inline-block;
    padding: 0.25rem 0;
  }
  .hidden {
    margin-bottom: 0;
    padding: 0.25rem 0.75rem;
    font-weight: 600;
    border-left: 0.25rem solid #b42318;
    background: #fef3f2;
  }
  .membership {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .membership p {
    margin: 0;
  }
  .membership button {
    min-width: 8rem;
    min-height: 44px;
  }
  .primary {
    font-weight: 600;
  }
  .banner {
    padding: 0.75rem 1rem;
    border-left: 0.25rem solid #b42318;
    background: #fef3f2;
  }
</style>
