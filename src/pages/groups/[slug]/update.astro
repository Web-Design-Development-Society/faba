---
// Posting an update to a group's members (GRP-04), from Post update on its page. Only its owner and
// organizers can, while it isn't archived or hidden. It works without JavaScript: when posting
// fails, the form comes back with what was typed and the same idempotency key, so posting again
// never posts twice. Once it's posted, the page goes back to the group, which shows it first.
import { actions, isInputError } from 'astro:actions';
import FieldError from '../../../components/FieldError.astro';
import Layout from '../../../layouts/Layout.astro';
import { setFlash } from '../../../lib/server/flash';
import { GROUP_UPDATES_PER_DAY, UPDATE_MAX } from '../../../lib/validation/update';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');
const { slug } = Astro.params;

const result = Astro.getActionResult(actions.groups.postUpdate);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'update_posted');
  return Astro.redirect(`/groups/${slug}#updates`, 303);
}

const { data: group } = await supabase
  .from('groups')
  .select('id, name, archived_at, hidden_at, members:group_members(role)')
  .eq('slug', slug!)
  .eq('members.user_id', user.id)
  .eq('members.status', 'active')
  .maybeSingle();
const organizer = ['owner', 'organizer'].includes(group?.members[0]?.role ?? '');
if (!group) Astro.response.status = 404;
else if (!organizer) Astro.response.status = 403;

// What was typed, after a failed post. The Action read a copy of the request.
const typed = result?.error ? await Astro.request.formData() : undefined;
const fields: Record<string, string[] | undefined> = isInputError(result?.error)
  ? result.error.fields
  : {};
const failure = result?.error && !isInputError(result.error) ? result.error.message : null;
---

<Layout title={group ? `Post an update to ${group.name}` : 'Not available'}>
  {!group ? (
    <>
      <h1>Not available</h1>
      <p>This group isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  ) : (
    <>
      <a href={`/groups/${slug}`}>Back to {group.name}</a>
      <h1>Post an update</h1>
      {!organizer ? (
        <p>Only the group's organizers can post updates to it.</p>
      ) : group.archived_at || group.hidden_at ? (
        <p>This group isn't taking updates.</p>
      ) : (
        <form method="post" action={actions.groups.postUpdate.queryString}>
          {failure && <p role="alert">{failure}</p>}
          <input type="hidden" name="group_id" value={group.id} />
          <input
            type="hidden"
            name="idempotency_key"
            value={typed?.get('idempotency_key')?.toString() ?? crypto.randomUUID()}
          />
          <p>
            <label for="body">Update</label>
            <br />
            <textarea
              id="body"
              name="body"
              rows="5"
              maxlength={UPDATE_MAX}
              required
              aria-invalid={fields.body ? 'true' : undefined}
              aria-describedby={fields.body ? 'body-hint body-error' : 'body-hint'}
            >{typed?.get('body')?.toString() ?? ''}</textarea>
            <br />
            <span id="body-hint">
              Up to {UPDATE_MAX} characters, and {GROUP_UPDATES_PER_DAY} updates a day. Every member
              gets it in Alerts.
            </span>
            <FieldError name="body" errors={fields.body} />
          </p>
          <button type="submit">Post update</button>
        </form>
      )}
    </>
  )}
</Layout>

<style>
  textarea {
    box-sizing: border-box;
    width: 100%;
    font: inherit;
  }
  #body-hint {
    font-size: 0.875rem;
    color: #595959;
  }
  button {
    min-height: 44px;
    padding: 0 1rem;
  }
</style>
