---
// Reporting a group's update (GRP-04, FR-REP-3), from Report beside it on the group's page. Sending
// it goes back to the group, which says thanks.
import { actions } from 'astro:actions';
import ReportForm from '../../../../../components/ReportForm.astro';
import Layout from '../../../../../layouts/Layout.astro';
import { setFlash } from '../../../../../lib/server/flash';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const { slug, update: updateId } = Astro.params;
const result = Astro.getActionResult(actions.reports.create);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'reported');
  return Astro.redirect(`/groups/${slug}#updates`, 303);
}

// What report_content() takes: an update that isn't hidden, to a group that isn't. The member's
// own earlier report, by reporter, since moderators will read everyone's.
const [{ data: update }, { data: report }] = await Promise.all([
  supabase
    .from('activity_updates')
    .select('id, body, author_id, group:groups!inner(slug, name)')
    .eq('id', updateId!)
    .eq('group.slug', slug!)
    .is('hidden_at', null)
    .is('group.hidden_at', null)
    .maybeSingle(),
  supabase
    .from('reports')
    .select('id')
    .eq('reporter_id', user.id)
    .eq('target_type', 'activity_update')
    .eq('target_id', updateId!)
    .maybeSingle(),
]);
if (!update) Astro.response.status = 404;
---

<Layout title={update ? `Report an update to ${update.group.name}` : 'Not available'}>
  {update ? (
    <>
      <a href={`/groups/${update.group.slug}#updates`}>Back to {update.group.name}</a>
      <h1>Report this update</h1>
      <blockquote>{update.body}</blockquote>
      <ReportForm
        type="activity_update"
        id={update.id}
        mine={update.author_id === user.id}
        reported={!!report}
      />
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This update isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
</Layout>
