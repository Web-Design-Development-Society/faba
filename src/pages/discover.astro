---
// Home (ACT-01, design document section 7.4): what's coming up, soonest first, under a heading
// for each day in Rexburg time. Chips filter it by date and category, as in
// /discover?when=weekend&cat=outdoors (ACT-06, SRCH-02), and More filters by custom dates. The app
// shell's bottom navigation replaces the links.
import { actions } from 'astro:actions';
import ActivityCard from '../components/ActivityCard.astro';
import Avatar from '../components/Avatar.astro';
import FilterChips from '../components/FilterChips.astro';
import MoreFilters from '../components/MoreFilters.astro';
import Status from '../components/Status.astro';
import Layout from '../layouts/Layout.astro';
import { CARD, FACES } from '../lib/cards';
import { filterQuery, nextPage, readCursor, readDates, readMore } from '../lib/feed';
import { FLASH_MESSAGES, postedFrom, setFlash, takeFlash } from '../lib/server/flash';
import { formatDay, rexburgDate, WHENS } from '../lib/time';

// Activities on a page.
const PAGE = 20;
const HOUR = 60 * 60 * 1000;

const { supabase, user, member } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

// I'm in and Can't make it without JavaScript come back to the card (RSVP-01, RSVP-02).
const rsvp = Astro.getActionResult(actions.rsvps.set);
if (rsvp && !rsvp.error) {
  setFlash(Astro.cookies, Astro.url, rsvp.data.status);
  return Astro.redirect(postedFrom(Astro.url, `#activity-${rsvp.data.activity_id}`), 303);
}
const flash = takeFlash(Astro.cookies);

const now = new Date();
const cursor = readCursor(Astro.url.searchParams);
const firstPage = !cursor.after_id;
const cat = Astro.url.searchParams.get('cat') || undefined;
const dates = readDates(Astro.url.searchParams, now);
const moreFilters = readMore(Astro.url.searchParams);

const [feed, plan, categories, tags] = await Promise.all([
  // One more than a page says whether there's another.
  supabase
    .rpc('get_feed', {
      ...cursor,
      category: cat,
      page_size: PAGE + 1,
      starts_from: dates.starts_from,
      starts_before: dates.starts_before,
      has_spots: moreFilters.spots,
      tag_ids: moreFilters.tags,
    })
    .select(CARD)
    .eq('going.status', 'going')
    .order('starts_at')
    .order('id')
    .order('created_at', { referencedTable: 'going' })
    .limit(FACES, { referencedTable: 'going' }),
  // The soonest activity the member is going to in the next 7 days, or one that's underway as in
  // the feed. Only on the first page.
  firstPage
    ? supabase
        .from('activities')
        .select(CARD)
        .eq('my_rsvp', 'going')
        .eq('status', 'published')
        .is('hidden_at', null)
        .gte('starts_at', new Date(now.getTime() - 3 * HOUR).toISOString())
        .lt('starts_at', new Date(now.getTime() + 7 * 24 * HOUR).toISOString())
        .eq('going.status', 'going')
        .order('starts_at')
        .order('id')
        .order('created_at', { referencedTable: 'going' })
        .limit(FACES, { referencedTable: 'going' })
        .limit(1)
        .maybeSingle()
    : { data: null },
  supabase.from('categories').select('id, name').eq('is_active', true).order('sort_order'),
  supabase.from('tags').select('id, name').eq('is_active', true).order('sort_order'),
]);

// A link to a category that isn't offered shows them all. Members who aren't active can't read the
// categories, so they get no chips.
const chips = categories.data?.length ? categories.data : null;
const category = chips?.find(({ id }) => id === cat);
if (cat && categories.data && !category) return Astro.redirect('/discover');
// The tags asked for that are offered, which are the ones the database used.
const chosenTags = tags.data?.filter(({ id }) => moreFilters.tags.includes(id)) ?? [];
const filters = {
  cat: category?.id,
  when: dates.when,
  from: dates.from,
  to: dates.to,
  spots: moreFilters.spots ? '1' : undefined,
  tag: chosenTags.map(({ id }) => id),
};
const kept = filterQuery(filters);
const here = kept ? `/discover?${kept}` : '/discover';
// What the filters ask for, such as "Outdoors this weekend", when nothing matches.
const matching = [
  category?.name,
  dates.when && WHENS[dates.when].toLowerCase(),
  dates.from && `from ${formatDay(dates.from, now)}`,
  dates.to && `${dates.from ? 'to' : 'until'} ${formatDay(dates.to, now)}`,
  moreFilters.spots && 'with spots left',
  chosenTags.length && `tagged ${chosenTags.map(({ name }) => name).join(', ')}`,
]
  .filter(Boolean)
  .join(' ');
const post = category
  ? `/activities/new?cat=${encodeURIComponent(category.id)}`
  : '/activities/new';

const activities = feed.data?.slice(0, PAGE) ?? [];
const more = feed.data && feed.data.length > PAGE ? nextPage(activities.at(-1)!, filters) : null;
const days = Map.groupBy(activities, ({ starts_at }) => rexburgDate(new Date(starts_at)));
---

<Layout title={category ? `${category.name} · Discover` : 'Discover'}>
  <h1>Discover</h1>
  <nav aria-label="Main">
    <a href="/search">Search</a>
    <a href="/plans">Plans</a>
    <a href={post}>Post</a>
    <a href="/me">Me</a>
  </nav>
  <p data-zone-note hidden>
    Times are in Rexburg time.
  </p>
  <Status message={flash && FLASH_MESSAGES[flash]} />
  {rsvp?.error && <p role="alert">{rsvp.error.message}</p>}

  {plan.data && (
    <section aria-labelledby="plan">
      <h2 id="plan">Your next plan</h2>
      <ActivityCard activity={plan.data} viewer={user.id} now={now} faces={FACES} />
    </section>
  )}
  {chips && <FilterChips categories={chips} page="/discover" query={Astro.url.searchParams} />}
  <MoreFilters
    page="/discover"
    query={Astro.url.searchParams}
    dates={dates}
    more={{ spots: moreFilters.spots, tags: filters.tag }}
    tags={tags.data ?? []}
  />

  {feed.error ? (
    <p role="alert">Activities couldn't load. Please try again.</p>
  ) : activities.length === 0 ? (
    firstPage && matching ? (
      <div class="empty">
        <p>
          Nothing matches <em>{matching}</em>.
        </p>
        <a href="/discover">Clear filters</a>
        <a href={post}>Post one</a>
      </div>
    ) : firstPage ? (
      <div class="empty">
        <p>It's quiet right now. Be the one who gets people together.</p>
        <a href="/activities/new">Post the first activity</a>
      </div>
    ) : (
      <p>
        That's everything for now. <a href={here}>Back to the start</a>
      </p>
    )
  ) : (
    <div data-feed>
      {[...days].map(([date, group]) => (
        <section data-day={date} aria-labelledby={`day-${date}`}>
          <h2 id={`day-${date}`}>{formatDay(date, now)}</h2>
          <ul>
            {group.map((activity) => (
              <li id={`activity-${activity.id}`}>
                <ActivityCard activity={activity} viewer={user.id} now={now} faces={FACES} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
  {more && (
    <a class="more" href={`/discover${more}`} data-more>
      Show more
    </a>
  )}
  {member && (
    <template data-my-face>
      <Avatar member={member} named />
    </template>
  )}
</Layout>

<script>
  import '../scripts/feed';
  import '../scripts/rsvp';
  import '../scripts/sheets';
</script>

<style>
  nav {
    display: flex;
    gap: 1rem;
  }
  h2 {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.875rem;
    text-transform: uppercase;
  }
  /* minmax(0, 1fr) keeps a card with a long place on one line from widening the column. */
  ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .empty {
    margin-top: 2rem;
    text-align: center;
  }
  .empty a,
  .more {
    display: inline-grid;
    place-items: center;
    min-height: 44px;
    padding: 0 1rem;
  }
  .more {
    display: grid;
    margin-top: 1rem;
  }
</style>
