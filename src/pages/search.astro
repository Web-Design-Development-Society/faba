---
// Search (SRCH-01, design document sections 7.10 and J3): a keyword search over each activity's
// title, place and description, and its organizer's name, upcoming by default, with Include past.
// The query lives in the URL, as in /search?q=hike&past=1, so it works without JavaScript and can
// be shared. The chips and More filters narrow the results by date and category, as on Discover
// (SRCH-02), and searching again keeps them. Without a query, it shows recent searches, which only
// this device keeps, and the chips, as links to Discover. Results are cards, under a heading for
// each day, as on Discover.
import { actions } from 'astro:actions';
import ActivityCard from '../components/ActivityCard.astro';
import Avatar from '../components/Avatar.astro';
import FilterChips from '../components/FilterChips.astro';
import MoreFilters from '../components/MoreFilters.astro';
import Status from '../components/Status.astro';
import Layout from '../layouts/Layout.astro';
import { CARD, FACES } from '../lib/cards';
import { filterQuery, nextPage, readCursor, readDates, readMore } from '../lib/feed';
import { FLASH_MESSAGES, postedFrom, setFlash, takeFlash } from '../lib/server/flash';
import { formatDay, rexburgDate, WHENS } from '../lib/time';

// Results on a page, and the longest query, as search_activities() reads it.
const PAGE = 20;
const MAX_QUERY = 100;

const { supabase, user, member } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

// I'm in and Can't make it without JavaScript come back to the card (RSVP-01, RSVP-02).
const rsvp = Astro.getActionResult(actions.rsvps.set);
if (rsvp && !rsvp.error) {
  setFlash(Astro.cookies, Astro.url, rsvp.data.status);
  return Astro.redirect(postedFrom(Astro.url, `#activity-${rsvp.data.activity_id}`), 303);
}
const flash = takeFlash(Astro.cookies);

const now = new Date();
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, MAX_QUERY);
const past = Astro.url.searchParams.get('past') === '1';
const cat = Astro.url.searchParams.get('cat') || undefined;
const dates = readDates(Astro.url.searchParams, now);
const moreFilters = readMore(Astro.url.searchParams);
const cursor = readCursor(Astro.url.searchParams);
const firstPage = !cursor.after_id;

const [results, categories, tags] = await Promise.all([
  // One more than a page says whether there's another.
  q
    ? supabase
        .rpc('search_activities', {
          q,
          include_past: past,
          ...cursor,
          page_size: PAGE + 1,
          category: cat,
          starts_from: dates.starts_from,
          starts_before: dates.starts_before,
          has_spots: moreFilters.spots,
          tag_ids: moreFilters.tags,
        })
        .select(CARD)
        .eq('going.status', 'going')
        .order('starts_at', { ascending: !past })
        .order('id', { ascending: !past })
        .order('created_at', { referencedTable: 'going' })
        .limit(FACES, { referencedTable: 'going' })
    : { data: null, error: null },
  supabase.from('categories').select('id, name').eq('is_active', true).order('sort_order'),
  supabase.from('tags').select('id, name').eq('is_active', true).order('sort_order'),
]);

const category = categories.data?.find(({ id }) => id === cat);
// The tags asked for that are offered, which are the ones the database used.
const chosenTags = tags.data?.filter(({ id }) => moreFilters.tags.includes(id)) ?? [];
const filters = {
  cat: category?.id,
  when: dates.when,
  from: dates.from,
  to: dates.to,
  spots: moreFilters.spots ? '1' : undefined,
  tag: chosenTags.map(({ id }) => id),
};
const activities = results.data?.slice(0, PAGE) ?? [];
const more =
  results.data && results.data.length > PAGE
    ? nextPage(activities.at(-1)!, { q, past: past ? '1' : undefined, ...filters })
    : null;
const days = Map.groupBy(activities, ({ starts_at }) => rexburgDate(new Date(starts_at)));
const withPast = `/search?${filterQuery({ q, past: '1', ...filters })}`;
// What the search asks for, such as "hike this weekend", when nothing matches.
const matching = [
  q,
  category && `in ${category.name}`,
  dates.when && WHENS[dates.when].toLowerCase(),
  dates.from && `from ${formatDay(dates.from, now)}`,
  dates.to && `${dates.from ? 'to' : 'until'} ${formatDay(dates.to, now)}`,
  moreFilters.spots && 'with spots left',
  chosenTags.length && `tagged ${chosenTags.map(({ name }) => name).join(', ')}`,
]
  .filter(Boolean)
  .join(' ');
---

<Layout title={q ? `${q} · Search` : 'Search'}>
  <a href="/discover">Back to Discover</a>
  <h1>Search</h1>
  <form method="get" action="/search" role="search" data-search>
    <label for="q">Search activities</label>
    <div class="field">
      <input
        id="q"
        name="q"
        type="search"
        value={q}
        maxlength={MAX_QUERY}
        autocomplete="off"
        enterkeyhint="search"
        autofocus={!q}
      />
      <button>Search</button>
    </div>
    <label class="past">
      <input type="checkbox" name="past" value="1" checked={past} />
      Include past
    </label>
    {Object.entries(filters).flatMap(([name, value]) =>
      [value ?? []].flat().map((one) => <input type="hidden" name={name} value={one} />)
    )}
  </form>
  {q && categories.data?.length ? (
    <FilterChips categories={categories.data} page="/search" query={Astro.url.searchParams} />
  ) : null}
  {q && (
    <MoreFilters
      page="/search"
      query={Astro.url.searchParams}
      dates={dates}
      more={{ spots: moreFilters.spots, tags: filters.tag }}
      tags={tags.data ?? []}
    />
  )}
  <Status message={flash && FLASH_MESSAGES[flash]} />
  {rsvp?.error && <p role="alert">{rsvp.error.message}</p>}

  {!q ? (
    <>
      <section aria-labelledby="recent" data-recent hidden>
        <h2 id="recent">Recent searches</h2>
        <ul class="recent"></ul>
      </section>
      {categories.data?.length ? (
        <section aria-labelledby="browse">
          <h2 id="browse">Browse</h2>
          <FilterChips
            categories={categories.data}
            page="/discover"
            query={new URLSearchParams()}
            browse
          />
        </section>
      ) : null}
    </>
  ) : results.error ? (
    <p role="alert">Search didn't work. Please try again.</p>
  ) : activities.length === 0 ? (
    firstPage ? (
      <div class="empty">
        <p>
          Nothing {past ? '' : 'coming up '}matches <em>{matching}</em>.
        </p>
        {!past && <a href={withPast}>Include past activities</a>}
        <a href="/discover">Back to Discover</a>
      </div>
    ) : (
      <p>That's everything.</p>
    )
  ) : (
    <div data-feed>
      {[...days].map(([date, group]) => (
        <section data-day={date} aria-labelledby={`day-${date}`}>
          <h2 id={`day-${date}`}>{formatDay(date, now)}</h2>
          <ul>
            {group.map((activity) => (
              <li id={`activity-${activity.id}`}>
                <ActivityCard activity={activity} viewer={user.id} now={now} faces={FACES} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
  {more && (
    <a class="more" href={`/search${more}`} data-more>
      Show more
    </a>
  )}
  {member && (
    <template data-my-face>
      <Avatar member={member} named />
    </template>
  )}
</Layout>

<script>
  import '../scripts/feed';
  import '../scripts/rsvp';
  import '../scripts/search';
  import '../scripts/sheets';
</script>

<style>
  .field {
    display: flex;
    gap: 0.5rem;
  }
  .field input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    font: inherit;
  }
  .field button {
    min-height: 44px;
    padding: 0 1rem;
  }
  .past {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
  }
  h2 {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.875rem;
    text-transform: uppercase;
  }
  /* minmax(0, 1fr) keeps a card with a long place on one line from widening the column. */
  ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recent a {
    display: inline-grid;
    align-items: center;
    min-height: 44px;
  }
  .empty {
    margin-top: 2rem;
    text-align: center;
  }
  .empty a,
  .more {
    display: inline-grid;
    place-items: center;
    min-height: 44px;
    padding: 0 1rem;
  }
  .more {
    display: grid;
    margin-top: 1rem;
  }
</style>
