---
// The landing page for visitors. Signed-in members go straight to Discover.
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) return Astro.redirect('/discover');
---

<Layout title="FABA">
  <h1>FABA</h1>
  <p>Find and share activities with other BYU-Idaho faculty in Rexburg.</p>
  <form method="post" action="/auth/login">
    <button type="submit">Continue with Google</button>
  </form>
  <p>For BYU-Idaho faculty with a byui.edu account.</p>
  <p>
    <small>
      FABA is run by the Faculty Association Board. It isn't an official BYU-Idaho site.
    </small>
  </p>
</Layout>
