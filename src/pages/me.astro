---
// The Me screen, with Sign out (AUTH-03). The member's activities are in Plans (RSVP-08), which
// replaced Phase 1's My activities here (HIST-02). Edit profile opens the profile form (PROF-02),
// which comes back here. Moderators see how many reports are open, which opens the queue (MOD-02).
// Delete account is at the bottom, away from everything else (PROF-05).
//
// The member's profile is a card at the top (UI-11): their photo in a large circle, their name,
// department, bio and interests, with Edit profile and See my profile. The settings are rows with
// icons under it, then the calendar feed in its own card, and how to add FABA to the home screen
// (UI-31), with a sheet of steps for iPhone and one for Android. The Theme card, under the settings,
// chooses light or dark for this device, or follows its setting (UI-34).
import { actions, isInputError } from 'astro:actions';
import Avatar from '../components/Avatar.astro';
import Icon from '../components/Icon.astro';
import Sheet from '../components/Sheet.astro';
import Status from '../components/Status.astro';
import Layout from '../layouts/Layout.astro';
import { FLASH_MESSAGES, setFlash, takeFlash } from '../lib/server/flash';
import { THEME_COOKIE, themeFrom } from '../lib/theme';

const { supabase, member, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const chosen = Astro.getActionResult(actions.theme.choose);
if (chosen && !chosen.error) {
  setFlash(Astro.cookies, Astro.url, 'theme_saved');
  return Astro.redirect('/me#theme', 303);
}
const theme = themeFrom(Astro.cookies.get(THEME_COOKIE)?.value);
const THEME_CHOICES = [
  ['device', 'Match device'],
  ['light', 'Light'],
  ['dark', 'Dark'],
] as const;

const flash = takeFlash(Astro.cookies);

// The calendar link is shown once, straight from this request, so it isn't kept anywhere (CAL-01).
const feed = Astro.getActionResult(actions.calendar.resetFeed);
const feedError = feed?.error && !isInputError(feed.error) ? feed.error.message : null;

const moderator =
  member?.status === 'active' && (member.role === 'moderator' || member.role === 'admin');
const [{ data: profile }, { data: categories }, open, { count: hasFeed }] = await Promise.all([
  supabase
    .from('profiles')
    .select('display_name, avatar_url, use_initials, department, bio, interests')
    .eq('id', user.id)
    .single(),
  supabase.from('categories').select('id, name').order('sort_order'),
  moderator
    ? supabase.from('reports').select('id', { count: 'exact', head: true }).eq('status', 'open')
    : null,
  supabase
    .from('calendar_feeds')
    .select('user_id', { count: 'exact', head: true })
    .eq('user_id', user.id),
]);
const interests = categories?.filter(({ id }) => profile?.interests.includes(id)) ?? [];
---

<Layout title="Me" tab="me">
  <h1 class="visually-hidden">Me</h1>
  <Status message={flash && FLASH_MESSAGES[flash]} />

  <section class="card profile" aria-labelledby="my-name">
    {profile && <Avatar member={profile} named large />}
    <h2 id="my-name">{profile?.display_name ?? member?.display_name ?? user.email}</h2>
    <p class="signed-in">Signed in with {user.email}</p>
    {profile?.department && <p class="department">{profile.department}</p>}
    {profile?.bio && <p class="bio">{profile.bio}</p>}
    {interests.length > 0 && (
      <ul class="interests" aria-label="Interests">
        {interests.map(({ name }) => (
          <li>{name}</li>
        ))}
      </ul>
    )}
    <p class="links">
      <a href="/me/edit" class="button">
        Edit profile
      </a>
      <a href={`/people/${user.id}`} class="button">
        See my profile
      </a>
    </p>
  </section>

  <nav class="card settings" aria-label="Settings">
    <a href="/me/notifications">
      <Icon name="bell" />
      <span>Notifications</span>
      <Icon name="chevron" class="chevron" />
    </a>
    <a href="#calendar-feed">
      <Icon name="calendar" />
      <span>Calendar feed</span>
      <Icon name="chevron" class="chevron" />
    </a>
    {typeof open?.count === 'number' && (
      <a href="/mod">
        <Icon name="flag" />
        <span>Open reports: {open.count}</span>
        <Icon name="chevron" class="chevron" />
      </a>
    )}
    <form method="post" action="/auth/logout">
      <button type="submit">
        <Icon name="back" />
        <span>Sign out</span>
      </button>
    </form>
  </nav>

  {/* Light or dark for this device, or its own setting (UI-34). A choice saves at once, and Save is
      for when JavaScript is off. */}
  <section class="card" id="theme" aria-labelledby="theme-heading">
    <h2 id="theme-heading">Theme</h2>
    <p>Match device follows your phone's or computer's light or dark setting.</p>
    <form method="post" action={actions.theme.choose.queryString} data-theme-form>
      <fieldset class="choices">
        <legend class="visually-hidden">Theme</legend>
        {THEME_CHOICES.map(([value, label]) => (
          <label>
            <input type="radio" name="theme" value={value} checked={value === theme} />
            {label}
          </label>
        ))}
      </fieldset>
      <button data-theme-save>Save</button>
    </form>
  </section>

  <section class="card" id="calendar-feed" aria-labelledby="calendar-feed-heading">
    <h2 id="calendar-feed-heading">Calendar feed</h2>
    <p>
      Your going activities, in your phone or computer calendar. Anyone with the link can read them,
      so keep it private.
    </p>
    {feedError && <p role="alert">{feedError}</p>}
    {feed && !feed.error && (
      <>
        <p>Copy this link now. It won't be shown again.</p>
        <p class="link">
          <code>{feed.data.url}</code>
        </p>
      </>
    )}
    <form method="post" action={actions.calendar.resetFeed.queryString}>
      <button>{hasFeed ? 'Reset link' : 'Get calendar link'}</button>
    </form>
    {hasFeed && !feed ? <p>Resetting makes a new link, and the old one stops working.</p> : null}
  </section>

  {/* How to open FABA from the home screen, like an app (UI-31), from Apple's and Google's own
      steps. It hides once FABA is opened that way, since there's nothing left to do. */}
  <section class="card" id="home-screen" aria-labelledby="home-screen-heading">
    <h2 id="home-screen-heading">Add FABA to your home screen</h2>
    <p>
      FABA then opens from an icon, like an app, in its own window. On an iPhone, that's also how it
      can send you push notifications.
    </p>
    <div class="phones">
      <button type="button" class="secondary" commandfor="iphone-steps" command="show-modal">
        On iPhone
      </button>
      <button type="button" class="secondary" commandfor="android-steps" command="show-modal">
        On Android
      </button>
    </div>
  </section>
  <Sheet id="iphone-steps" title="Add FABA on iPhone">
    <ol class="steps">
      <li>Open FABA in Safari.</li>
      <li>
        Tap <strong>⋯</strong>, then <strong>Share</strong>. If your tabs are at the bottom or the
        top, tap the <strong>Share</strong> button instead.
      </li>
      <li>
        Scroll down and tap <strong>Add to Home Screen</strong>. Not there? At the bottom of the
        list, tap <strong>Edit Actions</strong> and add it.
      </li>
      <li>
        Turn on <strong>Open as Web App</strong>.
      </li>
      <li>
        Tap <strong>Add</strong>.
      </li>
    </ol>
    <p>FABA's icon is on your Home Screen. Tap it to open FABA like an app.</p>
    <p>
      <a
        href="https://support.apple.com/guide/iphone/open-as-web-app-iphea86e5236/ios"
        target="_blank"
        rel="noopener"
      >
        Apple's steps
      </a>
    </p>
  </Sheet>
  <Sheet id="android-steps" title="Add FABA on Android">
    <ol class="steps">
      <li>Open FABA in Chrome.</li>
      <li>
        Tap <strong>⋮</strong> (More), at the right of the address bar.
      </li>
      <li>
        Tap <strong>Install and create shortcut</strong>, then <strong>Install</strong>.
      </li>
      <li>Follow the steps on the screen.</li>
    </ol>
    <p>FABA's icon is on your home screen. Tap it to open FABA like an app.</p>
    <p>
      <a
        href="https://support.google.com/chrome/answer/9658361?co=GENIE.Platform%3DAndroid"
        target="_blank"
        rel="noopener"
      >
        Google's steps
      </a>
    </p>
  </Sheet>

  {/* Away from everything else (PROF-05). */}
  <p class="delete">
    <a href="/me/delete" class="button danger">
      Delete account
    </a>
  </p>
</Layout>

<style>
  /* Pieces of white paper, from the layout's .card (UI-16). */
  .card {
    margin: 1rem 0;
    padding: 1rem;
  }
  /* The profile, centered, with the photo large and round (UI-11). */
  .profile {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 1.5rem 1rem;
    text-align: center;
  }
  .profile :global(.avatar) {
    width: 6rem;
    height: 6rem;
    margin-bottom: 0.5rem;
    font-size: 2rem;
    box-shadow: 0 0 0 4px var(--blue-soft);
  }
  .profile h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .profile p {
    margin: 0;
  }
  .signed-in,
  .department {
    color: var(--muted);
  }
  .department {
    font-weight: 600;
  }
  .bio {
    max-width: 30rem;
    margin-top: 0.5rem !important;
    white-space: pre-line;
  }
  .interests {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .interests li {
    padding: 0.125rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--blue-text);
    background: var(--blue-soft);
    border-radius: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem !important;
  }
  /* Each setting is a row with its icon, and a chevron when it opens somewhere. */
  .settings {
    display: grid;
    padding: 0;
  }
  .settings a,
  .settings button {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 52px;
    padding: 0 1rem;
    font: inherit;
    font-weight: 400;
    color: var(--ink);
    text-align: left;
    text-decoration: none;
    background: none;
    border: 0;
    border-radius: 0;
    letter-spacing: normal;
    text-transform: none;
  }
  .settings > * + * {
    border-top: 1px solid var(--line);
  }
  .settings span {
    flex: 1;
  }
  .settings :global(.icon) {
    color: var(--blue-text);
  }
  .settings :global(.chevron) {
    color: var(--muted);
  }
  .settings a:hover,
  .settings button:hover {
    background: var(--blue-soft);
  }
  .settings form {
    margin: 0;
  }
  #calendar-feed h2,
  #home-screen h2 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }
  /* The two phones' buttons side by side, each half the card. */
  .phones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .phones button {
    flex: 1 1 8rem;
  }
  /* "iPhone" keeps its small i, so the sheets' titles show as written, not capitalized (UI-30). */
  :global(#iphone-steps-title),
  :global(#android-steps-title) {
    text-transform: none;
  }
  .steps {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  /* Opened from the home screen, there's nothing left to do. */
  @media (display-mode: standalone) {
    #home-screen {
      display: none;
    }
  }
  /* The chips end the card, as the calendar's button does. Without JavaScript, Save sits under
     them. */
  #theme fieldset {
    margin: 0;
  }
  .link code {
    overflow-wrap: anywhere;
  }
  .delete {
    margin-top: 2rem;
    text-align: center;
  }
</style>

<script>
  import '../scripts/theme';
</script>
