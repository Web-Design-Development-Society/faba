---
// The Me screen, with Sign out (AUTH-03). The member's activities are in Plans (RSVP-08), which
// replaced Phase 1's My activities here (HIST-02). Edit profile opens the profile form (PROF-02),
// which comes back here. Moderators see how many reports are open, which opens the queue (MOD-02).
// Delete account is at the bottom, away from everything else (PROF-05).
//
// The member's profile is a card at the top (UI-11): their photo in a large circle, their name,
// department, bio and interests, with Edit profile and See my profile. The settings are rows with
// icons under it, then the calendar feed in its own card.
import { actions, isInputError } from 'astro:actions';
import Avatar from '../components/Avatar.astro';
import Icon from '../components/Icon.astro';
import Status from '../components/Status.astro';
import Layout from '../layouts/Layout.astro';
import { FLASH_MESSAGES, takeFlash } from '../lib/server/flash';

const { supabase, member, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const flash = takeFlash(Astro.cookies);

// The calendar link is shown once, straight from this request, so it isn't kept anywhere (CAL-01).
const feed = Astro.getActionResult(actions.calendar.resetFeed);
const feedError = feed?.error && !isInputError(feed.error) ? feed.error.message : null;

const moderator =
  member?.status === 'active' && (member.role === 'moderator' || member.role === 'admin');
const [{ data: profile }, { data: categories }, open, { count: hasFeed }] = await Promise.all([
  supabase
    .from('profiles')
    .select('display_name, avatar_url, use_initials, department, bio, interests')
    .eq('id', user.id)
    .single(),
  supabase.from('categories').select('id, name').order('sort_order'),
  moderator
    ? supabase.from('reports').select('id', { count: 'exact', head: true }).eq('status', 'open')
    : null,
  supabase
    .from('calendar_feeds')
    .select('user_id', { count: 'exact', head: true })
    .eq('user_id', user.id),
]);
const interests = categories?.filter(({ id }) => profile?.interests.includes(id)) ?? [];
---

<Layout title="Me" tab="me">
  <h1>Me</h1>
  <Status message={flash && FLASH_MESSAGES[flash]} />

  <section class="card profile" aria-labelledby="my-name">
    {profile && <Avatar member={profile} named large />}
    <h2 id="my-name">{profile?.display_name ?? member?.display_name ?? user.email}</h2>
    <p class="signed-in">Signed in with {user.email}</p>
    {profile?.department && <p class="department">{profile.department}</p>}
    {profile?.bio && <p class="bio">{profile.bio}</p>}
    {interests.length > 0 && (
      <ul class="interests" aria-label="Interests">
        {interests.map(({ name }) => (
          <li>{name}</li>
        ))}
      </ul>
    )}
    <p class="links">
      <a href="/me/edit" class="button">
        Edit profile
      </a>
      <a href={`/people/${user.id}`} class="button">
        See my profile
      </a>
    </p>
  </section>

  <nav class="card settings" aria-label="Settings">
    <a href="/me/notifications">
      <Icon name="bell" />
      <span>Notifications</span>
      <Icon name="chevron" class="chevron" />
    </a>
    <a href="#calendar-feed">
      <Icon name="calendar" />
      <span>Calendar feed</span>
      <Icon name="chevron" class="chevron" />
    </a>
    {typeof open?.count === 'number' && (
      <a href="/mod">
        <Icon name="flag" />
        <span>Open reports: {open.count}</span>
        <Icon name="chevron" class="chevron" />
      </a>
    )}
    <form method="post" action="/auth/logout">
      <button type="submit">
        <Icon name="back" />
        <span>Sign out</span>
      </button>
    </form>
  </nav>

  <section class="card" id="calendar-feed" aria-labelledby="calendar-feed-heading">
    <h2 id="calendar-feed-heading">Calendar feed</h2>
    <p>
      Your going activities, in your phone or computer calendar. Anyone with the link can read them,
      so keep it private.
    </p>
    {feedError && <p role="alert">{feedError}</p>}
    {feed && !feed.error && (
      <>
        <p>Copy this link now. It won't be shown again.</p>
        <p class="link">
          <code>{feed.data.url}</code>
        </p>
      </>
    )}
    <form method="post" action={actions.calendar.resetFeed.queryString}>
      <button>{hasFeed ? 'Reset link' : 'Get calendar link'}</button>
    </form>
    {hasFeed && !feed ? <p>Resetting makes a new link, and the old one stops working.</p> : null}
  </section>

  {/* Away from everything else (PROF-05). */}
  <p class="delete">
    <a href="/me/delete" class="button danger">
      Delete account
    </a>
  </p>
</Layout>

<style>
  .card {
    margin: 1rem 0;
    padding: 1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  /* The profile, centered, with the photo large and round (UI-11). */
  .profile {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 1.5rem 1rem;
    text-align: center;
  }
  .profile :global(.avatar) {
    width: 6rem;
    height: 6rem;
    margin-bottom: 0.5rem;
    font-size: 2rem;
    box-shadow: 0 0 0 4px var(--blue-soft);
  }
  .profile h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .profile p {
    margin: 0;
  }
  .signed-in,
  .department {
    color: var(--muted);
  }
  .department {
    font-weight: 600;
  }
  .bio {
    max-width: 30rem;
    margin-top: 0.5rem !important;
    white-space: pre-line;
  }
  .interests {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .interests li {
    padding: 0.125rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--blue);
    background: var(--blue-soft);
    border-radius: 999px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem !important;
  }
  /* Each setting is a row with its icon, and a chevron when it opens somewhere. */
  .settings {
    display: grid;
    padding: 0;
  }
  .settings a,
  .settings button {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 52px;
    padding: 0 1rem;
    font: inherit;
    font-weight: 400;
    color: var(--ink);
    text-align: left;
    text-decoration: none;
    background: none;
    border: 0;
    border-radius: 0;
  }
  .settings > * + * {
    border-top: 1px solid var(--line);
  }
  .settings span {
    flex: 1;
  }
  .settings :global(.icon) {
    color: var(--blue);
  }
  .settings :global(.chevron) {
    color: var(--muted);
  }
  .settings a:hover,
  .settings button:hover {
    background: var(--blue-soft);
  }
  .settings form {
    margin: 0;
  }
  #calendar-feed h2 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }
  .link code {
    overflow-wrap: anywhere;
  }
  .delete {
    margin-top: 2rem;
    text-align: center;
  }
</style>
