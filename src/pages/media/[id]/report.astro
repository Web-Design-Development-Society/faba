---
// Reporting a picture on an activity or a group (MEDIA-01), from Report beside it. Sending it goes
// back to the page it's on, which says thanks.
import { actions } from 'astro:actions';
import ReportForm from '../../../components/ReportForm.astro';
import Layout from '../../../layouts/Layout.astro';
import { setFlash } from '../../../lib/server/flash';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const id = Astro.params.id!;

// What report_content() takes: a picture that isn't hidden, on an activity or group that isn't. The
// member's own earlier report, by reporter, since moderators will read everyone's.
const [{ data: image }, { data: report }] = await Promise.all([
  supabase
    .from('images')
    .select('id, alt, uploaded_by, activity_id, group:groups(slug)')
    .eq('id', id)
    .is('hidden_at', null)
    .maybeSingle(),
  supabase
    .from('reports')
    .select('id')
    .eq('reporter_id', user.id)
    .eq('target_type', 'image')
    .eq('target_id', id)
    .maybeSingle(),
]);
if (!image) Astro.response.status = 404;
const back = image?.activity_id
  ? `/activities/${image.activity_id}`
  : `/groups/${image?.group?.slug ?? ''}`;
const result = Astro.getActionResult(actions.reports.create);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'reported');
  return Astro.redirect(back, 303);
}
---

<Layout title={image ? 'Report a picture' : 'Not available'}>
  {image ? (
    <>
      <h1>Report this picture</h1>
      <p>{image.alt}</p>
      <ReportForm
        type="image"
        id={image.id}
        mine={image.uploaded_by === user.id}
        reported={!!report}
      />
      <p>
        <a href={back}>Back</a>
      </p>
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This picture isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
</Layout>
