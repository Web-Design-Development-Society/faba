---
// Me → Delete account (PROF-05): what deleting does, and typing DELETE to confirm it. Once it's
// done, the member is signed out and sees Goodbye. It works without JavaScript.
import { actions, isInputError } from 'astro:actions';
import Back from '../../components/Back.astro';
import FieldError from '../../components/FieldError.astro';
import Layout from '../../layouts/Layout.astro';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const result = Astro.getActionResult(actions.profile.deleteAccount);
if (result && !result.error) {
  // The session's user is gone, so this only clears the cookies.
  await supabase.auth.signOut({ scope: 'local' });
  return Astro.redirect('/goodbye', 303);
}
const fields: Record<string, string[] | undefined> = isInputError(result?.error)
  ? result.error.fields
  : {};
const failure = result?.error && !isInputError(result.error) ? result.error.message : null;
---

<Layout title="Delete account">
  <Back href="/me">Back to Me</Back>
  <h1>Delete your account</h1>
  {failure && <p role="alert">{failure}</p>}
  <p>Deleting your FABA account:</p>
  <ul>
    <li>cancels the upcoming activities you organize, so the people going see they're off</li>
    <li>removes your RSVPs</li>
    <li>deletes your profile, your email and your other details</li>
    <li>keeps the past activities you organized, with "Former member" as the organizer</li>
  </ul>
  <p>It can't be undone. If you sign in again later, you start with a new, empty account.</p>
  <form method="post" action={actions.profile.deleteAccount.queryString}>
    <p>
      <label for="confirm">Type DELETE to confirm</label>
      <br />
      <input
        id="confirm"
        name="confirm"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        required
        aria-invalid={fields.confirm ? 'true' : undefined}
        aria-describedby={fields.confirm ? 'confirm-error' : undefined}
      />
      <FieldError name="confirm" errors={fields.confirm} />
    </p>
    <button type="submit" class="destructive">
      Delete my account
    </button>
  </form>
</Layout>

<style>
  button {
    min-height: 44px;
    padding: 0 1rem;
  }
  /* No background, since the red is too dark on WebKit's grey buttons. */
  .destructive {
    color: #b42318;
    background: none;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
  }
</style>
