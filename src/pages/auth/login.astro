---
// Signing in (design document section 9.7). GET shows the sign-in screen. POST sends the browser
// to Google through Supabase, which sends it back to /auth/callback.
import { ALLOWED_EMAIL_DOMAIN } from 'astro:env/server';
import Layout from '../../layouts/Layout.astro';
import { authCookieOptions, NEXT_COOKIE, safeNextPath } from '../../lib/server/auth';

let failed = Astro.url.searchParams.has('error');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const { data, error } = await Astro.locals.supabase.auth.signInWithOAuth({
    provider: 'google',
    options: {
      // Back to this request's own site, so pull request previews return to their preview.
      redirectTo: new URL('/auth/callback', Astro.url).href,
      // hd steers Google's account chooser to school accounts. Nothing trusts it (ADR-005).
      queryParams: { hd: ALLOWED_EMAIL_DOMAIN, prompt: 'select_account' },
    },
  });

  if (error) {
    failed = true;
  } else {
    // Ten minutes is plenty to choose an account.
    Astro.cookies.set(NEXT_COOKIE, safeNextPath(form.get('next')), {
      ...authCookieOptions(Astro.url),
      path: '/auth',
      maxAge: 600,
    });
    return Astro.redirect(data.url, 303);
  }
}

const next = safeNextPath(Astro.url.searchParams.get('next'));
---

<Layout title="Sign in">
  <h1>Sign in to FABA</h1>
  {failed && <p role="alert">Sign-in didn't finish. Please try again.</p>}
  <form method="post" action="/auth/login">
    <input type="hidden" name="next" value={next} />
    <button type="submit">Continue with Google</button>
  </form>
  <p>Use your byui.edu Google account.</p>
</Layout>
