---
// Signing in (design document section 9.7). GET shows the sign-in screen. POST sends the browser
// to Google through Supabase, which sends it back to /auth/callback.
import { ALLOWED_EMAIL_DOMAIN } from 'astro:env/server';
import SignIn from '../../components/SignIn.astro';
import Layout from '../../layouts/Layout.astro';
import {
  authCookieOptions,
  googleSignInOptions,
  NEXT_COOKIE,
  safeNextPath,
  signInErrorPath,
} from '../../lib/server/auth';

const isPost = Astro.request.method === 'POST';
const next = safeNextPath(
  isPost ? (await Astro.request.formData()).get('next') : Astro.url.searchParams.get('next')
);

if (isPost) {
  const { data, error } = await Astro.locals.supabase.auth.signInWithOAuth({
    provider: 'google',
    options: googleSignInOptions(Astro.url, ALLOWED_EMAIL_DOMAIN),
  });
  if (error) return Astro.redirect(signInErrorPath('failed', next), 303);

  // Ten minutes is plenty to choose an account.
  Astro.cookies.set(NEXT_COOKIE, next, {
    ...authCookieOptions(Astro.url),
    path: '/auth',
    maxAge: 600,
  });
  return Astro.redirect(data.url, 303);
}
---

<Layout title="Sign in">
  <h1>Sign in to FABA</h1>
  <SignIn next={next} error={null} />
  <p>Use your byui.edu Google account.</p>
</Layout>
