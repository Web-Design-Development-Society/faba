---
// Posting an activity (ACT-03, design document section 7.7). It works without JavaScript: when a
// post fails, the form comes back with what was typed and the same idempotency key, so posting
// again can't make a second activity. src/scripts/activity-form.ts adds the extras. Post again
// (ACT-07) opens it with ?from= one of the member's activities, filled in from it but for the date
// and times. Organizers of a group choose it, and whether the activity is for its members only
// (GRP-03). A group's Post an activity opens it with ?group= that group. Under More options,
// Repeats makes it a series: weekly, every 2 weeks or monthly, through a last date or rolling on
// (REC-01).
import { actions, isInputError } from 'astro:actions';
import ActivityFields from '../../components/ActivityFields.astro';
import FieldError from '../../components/FieldError.astro';
import Layout from '../../layouts/Layout.astro';
import { monthlyLabels, REPEATS } from '../../lib/series';
import { setFlash } from '../../lib/server/flash';
import { rexburgDate, rexburgTime } from '../../lib/time';
import { suggestedStart } from '../../lib/validation/activity';

const result = Astro.getActionResult(actions.activities.create);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'posted');
  return Astro.redirect(`/activities/${result.data.id}`, 303);
}

// What was typed, after a failed post. The Action read a copy of the request.
const typed = result?.error ? await Astro.request.formData() : undefined;
const value = (name: string) => typed?.get(name)?.toString() || undefined;

const fields: Record<string, string[] | undefined> = isInputError(result?.error)
  ? result.error.fields
  : {};
const failure = result?.error && !isInputError(result.error) ? result.error.message : null;

// The activity to copy, which must be one of theirs that a moderator hasn't hidden. Only its
// organizer can read its details for attendees, and they come too.
const from = Astro.url.searchParams.get('from');
const [
  { data: categories, error: categoriesError },
  { data: tags },
  { data: original },
  { data: organizing },
] = await Promise.all([
  Astro.locals.supabase
    .from('categories')
    .select('id, name')
    .eq('is_active', true)
    .order('sort_order'),
  Astro.locals.supabase.from('tags').select('id, name').eq('is_active', true).order('sort_order'),
  from && !typed && /^[0-9a-f-]{36}$/i.test(from)
    ? Astro.locals.supabase
        .from('activities')
        .select(
          'id, title, description, location_name, cost_note, capacity, guests_allowed, max_guests_per_rsvp, category_id, group_id, visibility, activity_tags(tag_id), private:activity_private_details(details)'
        )
        .eq('id', from)
        .eq('organizer_id', Astro.locals.user?.id ?? '')
        .is('hidden_at', null)
        .maybeSingle()
    : { data: null },
  // The groups they organize that take activities (GRP-03).
  Astro.locals.supabase
    .from('group_members')
    .select('group:groups!inner(id, name)')
    .eq('user_id', Astro.locals.user?.id ?? '')
    .eq('status', 'active')
    .in('role', ['owner', 'organizer'])
    .is('group.archived_at', null)
    .is('group.hidden_at', null),
]);
const groups = (organizing ?? [])
  .map(({ group }) => group)
  .toSorted((a, b) => a.name.localeCompare(b.name));
// The suggested start, and a category that Discover's filter can choose.
const start = suggestedStart(new Date());
const suggested: Record<string, string | undefined> = {
  date: rexburgDate(start),
  start_time: rexburgTime(start),
  category_id: original?.category_id ?? Astro.url.searchParams.get('cat') ?? undefined,
  title: original?.title,
  location_name: original?.location_name,
  description: original?.description ?? undefined,
  cost_note: original?.cost_note ?? undefined,
  private_details: original?.private?.details,
  capacity: original?.capacity?.toString(),
  guests_allowed: original?.guests_allowed ? 'true' : undefined,
  max_guests_per_rsvp: original?.max_guests_per_rsvp.toString(),
  copied_from_id: original?.id,
  group_id: original?.group_id ?? Astro.url.searchParams.get('group') ?? undefined,
  visibility: original?.visibility ?? 'members',
};
const shown = (name: string) => value(name) ?? suggested[name];
---

<Layout title="New activity">
  <h1>New activity</h1>
  {failure && <p role="alert">{failure}</p>}
  {categoriesError && <p role="alert">The categories couldn't load. Please try again.</p>}
  {original && <p>Copied from {original.title}. Pick a new date and time.</p>}
  <p data-draft-notice hidden>
    We kept what you typed last time. <button type="button">Start over</button>
  </p>
  <form
    method="post"
    action={actions.activities.create.queryString}
    data-activity-form
    data-draft
    data-typed={typed || original || suggested.group_id ? '' : undefined}
  >
    <input
      type="hidden"
      name="idempotency_key"
      value={value('idempotency_key') ?? crypto.randomUUID()}
    />
    {shown('copied_from_id') && (
      <input type="hidden" name="copied_from_id" value={shown('copied_from_id')} />
    )}
    <ActivityFields
      value={shown}
      errors={fields}
      categories={categories ?? []}
      tags={tags ?? []}
      chosen={
        typed?.getAll('tags').map(String) ??
        original?.activity_tags.map(({ tag_id }) => tag_id) ??
        []
      }
    >
      <fieldset slot="more" class="repeats">
        <legend>Repeats</legend>
        <p>
          <label for="repeats">How often</label>
          <br />
          <select
            id="repeats"
            name="repeats"
            data-repeats
            aria-invalid={fields.repeats ? 'true' : undefined}
            aria-describedby={fields.repeats ? 'repeats-error' : undefined}
          >
            {Object.entries({ none: REPEATS.none, ...monthlyLabels(shown('date')) }).map(
              ([freq, label]) => (
                <option value={freq} selected={(shown('repeats') ?? 'none') === freq}>
                  {label}
                </option>
              )
            )}
          </select>
          <FieldError name="repeats" errors={fields.repeats} />
        </p>
        <p>
          <label for="until_date">Last date</label>
          <br />
          <span id="until_date-hint">
            Leave empty to keep it going. A series can run up to 12 months.
          </span>
          <br />
          <input
            type="date"
            id="until_date"
            name="until_date"
            value={shown('until_date')}
            min={shown('date')}
            aria-describedby={
              fields.until_date ? 'until_date-hint until_date-error' : 'until_date-hint'
            }
            aria-invalid={fields.until_date ? 'true' : undefined}
          />
          <FieldError name="until_date" errors={fields.until_date} />
        </p>
      </fieldset>
    </ActivityFields>
    {groups.length > 0 && (
      <fieldset class="group">
        <legend>Group</legend>
        <p>
          <label for="group_id">Post under a group you organize (optional)</label>
          <br />
          <select id="group_id" name="group_id">
            <option value="">No group</option>
            {groups.map(({ id, name }) => (
              <option value={id} selected={id === shown('group_id')}>
                {name}
              </option>
            ))}
          </select>
        </p>
        <fieldset
          {...(fields.visibility
            ? { 'aria-invalid': 'true', 'aria-describedby': 'visibility-error' }
            : {})}
        >
          <legend>Who can see it?</legend>
          <label>
            <input
              type="radio"
              name="visibility"
              value="members"
              checked={shown('visibility') !== 'group'}
            />
            Everyone
          </label>
          <label>
            <input
              type="radio"
              name="visibility"
              value="group"
              checked={shown('visibility') === 'group'}
            />
            Group members only
          </label>
          <FieldError name="visibility" errors={fields.visibility} />
        </fieldset>
      </fieldset>
    )}
    <button type="submit">Post activity</button>
  </form>
</Layout>

<script>
  import '../../scripts/activity-form';
</script>

<style>
  .group label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
  }
  .group select,
  .repeats select {
    min-height: 44px;
  }
</style>
