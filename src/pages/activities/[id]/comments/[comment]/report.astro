---
// Reporting a comment on an activity (ACT-12), from Report beside it on the activity's page. Sending
// it goes back to the activity, which says thanks.
import { actions } from 'astro:actions';
import Back from '../../../../../components/Back.astro';
import ReportForm from '../../../../../components/ReportForm.astro';
import Layout from '../../../../../layouts/Layout.astro';
import { setFlash } from '../../../../../lib/server/flash';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const id = Astro.params.id;
const commentId = Astro.params.comment;
const result = Astro.getActionResult(actions.reports.create);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'reported');
  return Astro.redirect(`/activities/${id}#comments`, 303);
}

// What report_content() takes: a comment that isn't hidden, on an activity that isn't. The member's
// own earlier report, by reporter, since moderators will read everyone's.
const [{ data: comment }, { data: report }] = await Promise.all([
  supabase
    .from('activity_comments')
    .select('id, body, author_id, activity:activities!inner(id, title)')
    .eq('id', commentId!)
    .eq('activity_id', id!)
    .is('hidden_at', null)
    .is('activity.hidden_at', null)
    .maybeSingle(),
  supabase
    .from('reports')
    .select('id')
    .eq('reporter_id', user.id)
    .eq('target_type', 'comment')
    .eq('target_id', commentId!)
    .maybeSingle(),
]);
if (!comment) Astro.response.status = 404;
---

<Layout title={comment ? `Report a comment on ${comment.activity.title}` : 'Not available'}>
  {comment ? (
    <>
      <Back href={`/activities/${comment.activity.id}#comments`}>
        Back to {comment.activity.title}
      </Back>
      <h1>Report this comment</h1>
      <blockquote>{comment.body}</blockquote>
      <ReportForm
        type="comment"
        id={comment.id}
        mine={comment.author_id === user.id}
        reported={!!report}
      />
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This comment isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
</Layout>

<style>
  blockquote {
    margin: 0;
    padding: 0.5rem 1rem;
    white-space: pre-line;
    border-left: 0.25rem solid #767676;
  }
</style>
