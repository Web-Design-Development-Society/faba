---
// Reporting an organizer's update (NOTIF-04, FR-REP-3), from Report beside it on the activity's
// page. Sending it goes back to the activity, which says thanks.
import { actions } from 'astro:actions';
import ReportForm from '../../../../../components/ReportForm.astro';
import Layout from '../../../../../layouts/Layout.astro';
import { setFlash } from '../../../../../lib/server/flash';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const { id, update: updateId } = Astro.params;
const result = Astro.getActionResult(actions.reports.create);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'reported');
  return Astro.redirect(`/activities/${id}#updates`, 303);
}

// What report_content() takes: an update that isn't hidden, to an activity that isn't. The
// member's own earlier report, by reporter, since moderators will read everyone's.
const [{ data: update }, { data: report }] = await Promise.all([
  supabase
    .from('activity_updates')
    .select('id, body, author_id, activity:activities!inner(id, title)')
    .eq('id', updateId!)
    .eq('activity_id', id!)
    .is('hidden_at', null)
    .is('activity.hidden_at', null)
    .maybeSingle(),
  supabase
    .from('reports')
    .select('id')
    .eq('reporter_id', user.id)
    .eq('target_type', 'activity_update')
    .eq('target_id', updateId!)
    .maybeSingle(),
]);
if (!update) Astro.response.status = 404;
---

<Layout title={update ? `Report an update to ${update.activity.title}` : 'Not available'}>
  {update ? (
    <>
      <a href={`/activities/${update.activity.id}#updates`}>Back to {update.activity.title}</a>
      <h1>Report this update</h1>
      <blockquote>{update.body}</blockquote>
      <ReportForm
        type="activity_update"
        id={update.id}
        mine={update.author_id === user.id}
        reported={!!report}
      />
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This update isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
</Layout>

<style>
  blockquote {
    margin: 0;
    padding: 0.5rem 1rem;
    white-space: pre-line;
    border-left: 0.25rem solid #767676;
  }
</style>
