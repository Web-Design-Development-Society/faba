---
// Editing an activity (ACT-04, journey J5): the create form, filled in, with the same rules. Only
// the organizer can. It works without JavaScript: when a save fails, the form comes back with what
// was typed and the version it showed, so a save from an older page keeps failing. Once the
// activity has started, only its description can change (FR-ACT-4). Cancel activity is at the
// bottom, away from Save, and asks first in a sheet. Restore takes its place until the start
// (ACT-05).
import { actions, isInputError } from 'astro:actions';
import ActivityFields from '../../../components/ActivityFields.astro';
import FieldError from '../../../components/FieldError.astro';
import Sheet from '../../../components/Sheet.astro';
import Layout from '../../../layouts/Layout.astro';
import { setFlash } from '../../../lib/server/flash';
import { rexburgDate, rexburgTime } from '../../../lib/time';
import { ACTIVITY } from '../../../lib/validation/activity';

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const result =
  Astro.getActionResult(actions.activities.update) ??
  Astro.getActionResult(actions.activities.updateDescription);
if (result && !result.error) {
  setFlash(Astro.cookies, Astro.url, 'saved');
  return Astro.redirect(`/activities/${result.data.id}`, 303);
}
const cancel = Astro.getActionResult(actions.activities.cancel);
if (cancel && !cancel.error) {
  setFlash(Astro.cookies, Astro.url, 'cancelled');
  return Astro.redirect(`/activities/${cancel.data.id}`, 303);
}
const restore = Astro.getActionResult(actions.activities.restore);
if (restore && !restore.error) {
  setFlash(Astro.cookies, Astro.url, 'restored');
  return Astro.redirect(`/activities/${restore.data.id}`, 303);
}

// Every category, so an activity keeps one that's no longer offered.
const [{ data: activity }, { data: categories }, { data: tags }] = await Promise.all([
  supabase
    .from('activities')
    .select(
      'id, title, description, starts_at, ends_at, location_name, cost_note, capacity, guests_allowed, max_guests_per_rsvp, category_id, organizer_id, version, status, activity_tags(tag_id)'
    )
    .eq('id', Astro.params.id!)
    .maybeSingle(),
  supabase.from('categories').select('id, name, is_active').order('sort_order'),
  supabase.from('tags').select('id, name, is_active').order('sort_order'),
]);
const mine = activity?.organizer_id === user.id;
if (!activity) Astro.response.status = 404;
else if (!mine) Astro.response.status = 403;

// What was typed, after a failed save. The Action read a copy of the request.
const typed = result?.error ? await Astro.request.formData() : undefined;
const startsAt = new Date(activity?.starts_at ?? 0);
const saved: Record<string, string | undefined> = {
  title: activity?.title,
  date: rexburgDate(startsAt),
  start_time: rexburgTime(startsAt),
  end_time: activity?.ends_at ? rexburgTime(new Date(activity.ends_at)) : undefined,
  location_name: activity?.location_name,
  category_id: activity?.category_id,
  description: activity?.description ?? undefined,
  cost_note: activity?.cost_note ?? undefined,
  capacity: activity?.capacity?.toString(),
  guests_allowed: activity?.guests_allowed ? 'true' : undefined,
  max_guests_per_rsvp: activity?.max_guests_per_rsvp.toString(),
  version: activity?.version.toString(),
};
const value = (name: string) => (typed ? typed.get(name)?.toString() || undefined : saved[name]);

const fields: Record<string, string[] | undefined> = isInputError(result?.error)
  ? result.error.fields
  : {};
// The reason's error shows at the top, since its sheet has closed.
const failure =
  (result?.error && !isInputError(result.error) ? result.error.message : null) ??
  (isInputError(cancel?.error) ? cancel.error.fields.reason?.[0] : cancel?.error?.message) ??
  restore?.error?.message;
const started = startsAt <= new Date();
const offered = categories?.filter((c) => c.is_active || c.id === activity?.category_id) ?? [];
// Its tags, or what was typed, and the tags offered, with any it keeps that no longer are.
const chosen = typed
  ? typed.getAll('tags').map(String)
  : (activity?.activity_tags.map(({ tag_id }) => tag_id) ?? []);
const offeredTags = tags?.filter((t) => t.is_active || chosen.includes(t.id)) ?? [];
const back = `/activities/${Astro.params.id}`;
---

<Layout title="Edit activity">
  <a href={back}>Back to the activity</a>
  {!activity ? (
    <>
      <h1>Not available</h1>
      <p>This activity isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  ) : !mine ? (
    <>
      <h1>Edit activity</h1>
      <p>Only the organizer can edit this activity.</p>
    </>
  ) : (
    <>
      <h1>Edit activity</h1>
      {failure && <p role="alert">{failure}</p>}
      <form
        method="post"
        action={
          started
            ? actions.activities.updateDescription.queryString
            : actions.activities.update.queryString
        }
        data-activity-form={started ? undefined : ''}
      >
        <input type="hidden" name="id" value={activity.id} />
        <input type="hidden" name="version" value={value('version')} />
        {started ? (
          <>
            <p>This activity has started, so only its description can change.</p>
            <p>
              <label for="description">Details (optional)</label>
              <br />
              <textarea
                id="description"
                name="description"
                rows="4"
                maxlength={ACTIVITY.description.max}
                aria-invalid={fields.description ? 'true' : undefined}
                aria-describedby={fields.description ? 'description-error' : undefined}
              >{value('description')}</textarea>
              <FieldError name="description" errors={fields.description} />
            </p>
          </>
        ) : (
          <ActivityFields
            value={value}
            errors={fields}
            categories={offered}
            tags={offeredTags}
            chosen={chosen}
          />
        )}
        <button type="submit">Save</button>
      </form>
      <div class="activity-status">
        {activity.status === 'published' ? (
          <>
            <button type="button" class="destructive" commandfor="cancel" command="show-modal">
              Cancel activity
            </button>
            <Sheet id="cancel" title="Cancel this activity?">
              <p>
                It stays here, marked cancelled, so people who are going can see. It leaves
                Discover.
              </p>
              <form method="post" action={actions.activities.cancel.queryString}>
                <input type="hidden" name="id" value={activity.id} />
                <p>
                  <label for="reason">Reason (optional)</label>
                  <br />
                  <textarea
                    id="reason"
                    name="reason"
                    rows="2"
                    maxlength={ACTIVITY.cancelReason.max}
                  />
                </p>
                <button type="submit" class="destructive">
                  Yes, cancel it
                </button>
              </form>
              <form method="dialog">
                <button>No, keep it</button>
              </form>
            </Sheet>
          </>
        ) : started ? (
          <p>This activity is cancelled. It has started, so it can't be restored.</p>
        ) : (
          <form method="post" action={actions.activities.restore.queryString}>
            <input type="hidden" name="id" value={activity.id} />
            <p>This activity is cancelled. Restoring it puts it back on Discover.</p>
            <button type="submit">Restore activity</button>
          </form>
        )}
      </div>
    </>
  )}
</Layout>

<script>
  import '../../../scripts/activity-form';
  import '../../../scripts/sheets';
</script>

<style>
  .activity-status {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid #767676;
  }
  .activity-status button {
    min-height: 44px;
    padding: 0 1rem;
  }
  /* No background, since the red is too dark on WebKit's grey buttons. */
  .destructive {
    color: #b42318;
    background: none;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
  }
</style>
