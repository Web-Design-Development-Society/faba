---
// An activity's page (ACT-02, design document section 7.6), in the order people ask: what, when,
// where, who, then the details. Report opens the Report form (MOD-01), and those going or maybe can
// Mute updates from the same menu (NOTIF-08). Its organizer's updates come last, newest first, and
// Post update sits beside Edit (NOTIF-04). Moderators unhide a hidden one here (MOD-03), and give
// an ineligible organizer's upcoming one to a new host or cancel it (AUTH-05). Its details for
// attendees show only to those who can read them (ACT-09). Add to calendar sits beside the time
// (ACT-08).
import { actions, isInputError } from 'astro:actions';
import Avatar from '../../../components/Avatar.astro';
import BoardContact from '../../../components/BoardContact.astro';
import GoingList from '../../../components/GoingList.astro';
import Menu from '../../../components/Menu.astro';
import ModerationAction from '../../../components/ModerationAction.astro';
import ParticipationDisclaimer from '../../../components/ParticipationDisclaimer.astro';
import RsvpForm from '../../../components/RsvpForm.astro';
import Sheet from '../../../components/Sheet.astro';
import Status from '../../../components/Status.astro';
import Layout from '../../../layouts/Layout.astro';
import { googleCalendarUrl } from '../../../lib/calendar';
import { isFull } from '../../../lib/cards';
import { PHYSICAL_CATEGORIES } from '../../../lib/contact';
import { linkify, mapsUrl } from '../../../lib/links';
import { FLASH_MESSAGES, postedFrom, setFlash, takeFlash } from '../../../lib/server/flash';
import { formatAgo, formatRange, isOver } from '../../../lib/time';

// Faces in the going row, and people in who's going before Show all (RSVP-03).
const FACES = 4;
const LIST = 50;

const { supabase, user, member } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

// I'm in and Can't make it without JavaScript (RSVP-01, RSVP-02). When it fails, the page says why.
const rsvp = Astro.getActionResult(actions.rsvps.set);
if (rsvp && !rsvp.error) {
  setFlash(Astro.cookies, Astro.url, rsvp.data.status);
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const unhide = Astro.getActionResult(actions.moderation.unhide);
if (unhide && !unhide.error) {
  setFlash(Astro.cookies, Astro.url, 'unhidden');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const transfer = Astro.getActionResult(actions.moderation.transfer);
if (transfer && !transfer.error) {
  setFlash(Astro.cookies, Astro.url, 'transferred');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const cancel = Astro.getActionResult(actions.moderation.cancel);
if (cancel && !cancel.error) {
  setFlash(Astro.cookies, Astro.url, 'cancelled');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const mute = Astro.getActionResult(actions.notifications.mute);
if (mute && !mute.error) {
  setFlash(Astro.cookies, Astro.url, mute.data.muted ? 'muted' : 'unmuted');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const unhideUpdate = Astro.getActionResult(actions.moderation.unhideUpdate);
if (unhideUpdate && !unhideUpdate.error) {
  setFlash(Astro.cookies, Astro.url, 'update_unhidden');
  return Astro.redirect(postedFrom(Astro.url, '#updates'), 303);
}
// The error shows at the top, since its sheet has closed.
const failed =
  unhide?.error ?? transfer?.error ?? cancel?.error ?? mute?.error ?? unhideUpdate?.error;
const failure = isInputError(failed) ? Object.values(failed.fields).flat()[0] : failed?.message;

// Only its organizer and moderators can read a hidden activity (RLS), so it's not available to
// anyone else. Nor is an id that isn't a UUID, which is an error. Only active members are going, in
// the faces and the list (RSVP-03). Members can't read suspended members' profiles (RLS), and the
// filter keeps those out for moderators too, who'll be able to. Only its organizer, members going
// and moderators can read its details for attendees (RLS), so nobody else's page has them.
const [{ data: activity }, { data: me }] = await Promise.all([
  supabase
    .from('activities')
    .select(
      `id, title, description, starts_at, ends_at, location_name, cost_note, status, cancel_reason,
      hidden_at, hidden_reason, going_count, maybe_count, guest_total, capacity, guests_allowed,
      max_guests_per_rsvp, organizer_id,
      time_or_place_changed_at, category_id, has_private_details,
      private:activity_private_details(details),
      category:categories(name),
      tags:activity_tags(tag:tags(name, sort_order)),
      organizer:profiles!activities_organizer_id_fkey(id, display_name, avatar_url, use_initials, department, status),
      mine:rsvps(status, guest_count, mute:activity_mutes(muted_at)),
      going:rsvps(member:profiles!inner(id, display_name, avatar_url, use_initials, department)),
      maybe:rsvps(member:profiles!inner(id, display_name, avatar_url, use_initials, department)),
      updates:activity_updates(id, body, created_at, author_id, hidden_at, hidden_reason,
        author:profiles!activity_updates_author_id_fkey(display_name))`
    )
    .eq('id', Astro.params.id!)
    .eq('mine.user_id', user.id)
    .eq('going.status', 'going')
    .eq('going.member.status', 'active')
    .eq('maybe.status', 'maybe')
    .eq('maybe.member.status', 'active')
    .order('created_at', { referencedTable: 'going' })
    .limit(LIST, { referencedTable: 'going' })
    .order('created_at', { referencedTable: 'updates', ascending: false })
    .limit(LIST, { referencedTable: 'updates' })
    .maybeSingle(),
  // The member in who's going, for after I'm in.
  supabase
    .from('profiles')
    .select('id, display_name, avatar_url, use_initials, department')
    .eq('id', user.id)
    .single(),
]);
if (!activity) Astro.response.status = 404;

const flash = takeFlash(Astro.cookies);
const hosting = activity?.organizer_id === user.id;
const answer = activity?.mine[0]?.status ?? null;
const going = answer === 'going';
// Those going or maybe, the organizer among them, hear about it, so they can mute it (NOTIF-08).
const mutable = going || answer === 'maybe';
const muted = !!activity?.mine[0]?.mute;
const moderator =
  member?.status === 'active' && (member.role === 'moderator' || member.role === 'admin');
const over =
  !!activity &&
  isOver(
    new Date(activity.starts_at),
    activity.ends_at ? new Date(activity.ends_at) : null,
    new Date()
  );
// A hidden one takes no RSVPs, as rsvp() says.
const open = activity?.status === 'published' && !activity.hidden_at && !over;
const host = activity?.organizer;
// Full to anyone not going or maybe (RSVP-04). A maybe can still change their answer.
const full = !!activity && !going && answer !== 'maybe' && isFull(activity);
// Who's maybe, which only the organizer can read (RSVP-05).
const maybes = activity?.maybe.map(({ member }) => member) ?? [];
// An ineligible organizer's upcoming activity, which moderators can give to someone going or
// cancel (AUTH-05). Members can't read that organizer, but moderators can.
const handover =
  moderator &&
  host?.status === 'ineligible' &&
  activity?.status === 'published' &&
  new Date(activity.starts_at) > new Date();
const people = activity?.going.map(({ member }) => member) ?? [];
const department = host?.department ? `· ${host.department}` : '';
const url = new URL(Astro.url.pathname, Astro.url.origin).href;
// Add to calendar (ACT-08), until it's cancelled or over. The .ics has the details for attendees
// for a member going, and the Google Calendar link never has them.
const google =
  activity?.status === 'published' && !over
    ? googleCalendarUrl({
        title: activity.title,
        startsAt: new Date(activity.starts_at),
        endsAt: activity.ends_at ? new Date(activity.ends_at) : null,
        place: activity.location_name,
        description: activity.description,
        url,
      })
    : null;
const withReason = (label: string, reason: string | null) =>
  reason ? `${label}: ${reason}` : label;
const email = activity
  ? `mailto:?subject=${encodeURIComponent(activity.title)}&body=${encodeURIComponent(url)}`
  : undefined;
---

<Layout title={activity?.title ?? 'Not available'}>
  <header class="top">
    <a href="/discover">Back to Discover</a>
    {activity && (
      <Menu>
        <li>
          <a href={email} data-share data-title={activity.title} data-url={url}>
            Share
          </a>
        </li>
        {mutable && (
          <li>
            <form method="post" action={actions.notifications.mute.queryString}>
              <input type="hidden" name="activity_id" value={activity.id} />
              <input type="hidden" name="muted" value={String(!muted)} />
              <button>{muted ? 'Unmute updates' : 'Mute updates'}</button>
            </form>
          </li>
        )}
        <li>
          <a href={`/activities/${activity.id}/report`}>Report</a>
        </li>
      </Menu>
    )}
  </header>
  <Status
    message={flash && FLASH_MESSAGES[flash]}
    data-posted={flash === 'posted' ? '' : undefined}
  />
  {rsvp?.error && <p role="alert">{rsvp.error.message}</p>}
  {failure && <p role="alert">{failure}</p>}
  {activity ? (
    <>
      {activity.hidden_at && (
        <div class="banner">
          <p>{withReason('Hidden by a moderator', activity.hidden_reason)}</p>
          {hosting ? (
            <p>
              Contact <BoardContact /> if you think this was a mistake.
            </p>
          ) : (
            moderator && (
              <ModerationAction
                id="unhide"
                label="Unhide"
                title="Unhide this activity?"
                action={actions.moderation.unhide.queryString}
                fields={{ activity_id: activity.id }}
                confirm="Yes, unhide it"
                cancel="No, keep it hidden"
              >
                <p>Members will see it again, and it goes back on Discover if it's coming up.</p>
              </ModerationAction>
            )
          )}
        </div>
      )}
      {activity.status === 'cancelled' && (
        <p class="banner">{withReason('Cancelled', activity.cancel_reason)}</p>
      )}
      {activity.category && <p class="category">{activity.category.name}</p>}
      <h1>{activity.title}</h1>
      <p>
        <time datetime={activity.starts_at}>
          {formatRange(
            new Date(activity.starts_at),
            activity.ends_at ? new Date(activity.ends_at) : null
          )}
        </time>
        {google && (
          <>
            {' · '}
            <button type="button" class="link" commandfor="calendar" command="show-modal">
              Add to calendar
            </button>
          </>
        )}
      </p>
      {google && (
        <Sheet id="calendar" title="Add to calendar">
          <ul class="calendars">
            <li>
              <a href={`/activities/${activity.id}.ics`}>Download for Apple Calendar or Outlook</a>
            </li>
            <li>
              <a href={google} target="_blank" rel="noopener">
                Open in Google Calendar
              </a>
            </li>
          </ul>
          <p>Your calendar's copy won't change if the activity does.</p>
        </Sheet>
      )}
      <p>
        {activity.location_name} ·{' '}
        <a href={mapsUrl(activity.location_name, Astro.request.headers.get('user-agent') ?? '')}>
          Open in Maps
        </a>
      </p>
      {activity.time_or_place_changed_at && (
        <p class="updated">
          Updated{' '}
          <time datetime={activity.time_or_place_changed_at}>
            {formatAgo(new Date(activity.time_or_place_changed_at), new Date())}
          </time>
        </p>
      )}
      {activity.cost_note && <p>Cost: {activity.cost_note}</p>}
      {activity.tags.length > 0 && (
        <p>
          {activity.tags
            .map(({ tag }) => tag)
            .toSorted((a, b) => a.sort_order - b.sort_order)
            .map(({ name }) => name)
            .join(' · ')}
        </p>
      )}
      <p class="going" data-going={activity.id} data-faces={FACES}>
        <button type="button" commandfor="going" command="show-modal">
          {people.slice(0, FACES).map((member) => (
            <Avatar member={member} named mine={member.id === user.id} />
          ))}
          <span data-count>{activity.going_count}</span> going
          <span
            data-guest-total={activity.id}
            data-value={activity.guest_total}
            hidden={!activity.guest_total}
          >
            {` (+${activity.guest_total} ${activity.guest_total === 1 ? 'guest' : 'guests'})`}
          </span>
          <span data-maybe={activity.id} hidden={!activity.maybe_count}>
            · <span data-count>{activity.maybe_count}</span> maybe
          </span>
          <span aria-hidden="true">›</span>
        </button>
      </p>
      <Sheet id="going" title="Who's going">
        <GoingList
          activityId={activity.id}
          organizerId={activity.organizer_id}
          people={people}
          me={people.length < LIST ? me : null}
        />
        {activity.going_count > LIST && (
          <a class="all" href={`/activities/${activity.id}/going`}>
            Show all
          </a>
        )}
        {maybes.length > 0 && (
          <>
            <h3>Maybe</h3>
            <GoingList activityId={`${activity.id}-maybe`} organizerId={null} people={maybes} />
          </>
        )}
      </Sheet>
      {host?.status === 'active' ? (
        <p>
          <Avatar member={host} />
          Hosted by <a href={`/people/${host.id}`}>{host.display_name}</a>
          {department}
        </p>
      ) : activity.organizer_id ? (
        // Members can't read an organizer who isn't active (AUTH-05). Moderators see who it was.
        <p>
          Organizer no longer active
          {host && (
            <>
              {' '}
              · <a href={`/people/${host.id}`}>{host.display_name}</a>
            </>
          )}
        </p>
      ) : (
        // Its organizer deleted their account (PROF-05).
        <p>Hosted by Former member</p>
      )}
      {handover && (
        <div class="handover">
          {people.length > 0 && (
            <ModerationAction
              id="handover-transfer"
              label="Give to a new host"
              title="Give this activity to a new host?"
              action={actions.moderation.transfer.queryString}
              fields={{ activity_id: activity.id }}
              confirm="Yes, give it to them"
              cancel="No, leave it"
            >
              <p>Pick someone who's going and has agreed to host it. It becomes theirs to edit.</p>
              <p slot="fields">
                <label for="handover-to">New host</label>
                <br />
                <select id="handover-to" name="to_user" required>
                  {people.map((member) => (
                    <option value={member.id}>{member.display_name}</option>
                  ))}
                </select>
              </p>
            </ModerationAction>
          )}
          <ModerationAction
            id="handover-cancel"
            label="Cancel it"
            title="Cancel this activity?"
            action={actions.moderation.cancel.queryString}
            fields={{ activity_id: activity.id }}
            confirm="Yes, cancel it"
            cancel="No, leave it"
          >
            <p>
              The people going will see it's cancelled because its organizer is no longer active.
            </p>
          </ModerationAction>
        </div>
      )}
      {activity.description && (
        <p class="description">
          {linkify(activity.description).map(({ text, href }) =>
            href ? (
              <a href={href} rel="nofollow ugc noopener">
                {text}
              </a>
            ) : (
              text
            )
          )}
        </p>
      )}
      {activity.has_private_details && (
        // After the member's answer changes, src/scripts/private-details.ts shows the details or
        // the note.
        <section aria-labelledby="for-attendees" data-private-details={activity.id}>
          <h2 id="for-attendees">For attendees</h2>
          <p class="description" data-details hidden={!activity.private}>
            {activity.private &&
              linkify(activity.private.details).map(({ text, href }) =>
                href ? (
                  <a href={href} rel="nofollow ugc noopener">
                    {text}
                  </a>
                ) : (
                  text
                )
              )}
          </p>
          <p data-note hidden={!!activity.private}>
            <span aria-hidden="true">🔒</span> Exact location shared with attendees after you RSVP.
          </p>
        </section>
      )}
      {PHYSICAL_CATEGORIES.includes(activity.category_id) && <ParticipationDisclaimer />}
      {activity.updates.length > 0 && (
        <section class="updates" aria-labelledby="updates">
          <h2 id="updates">Updates</h2>
          <ul>
            {activity.updates.map((update) => (
              <li>
                {update.hidden_at && (
                  // Only its author and moderators read a hidden update (NOTIF-04).
                  <p class="hidden">{withReason('Hidden by a moderator', update.hidden_reason)}</p>
                )}
                <p class="byline">
                  {update.author?.display_name ?? 'Organizer'},{' '}
                  <time datetime={update.created_at}>
                    {formatAgo(new Date(update.created_at), new Date())}
                  </time>
                  {!update.hidden_at && update.author_id !== user.id && (
                    <>
                      {' · '}
                      <a href={`/activities/${activity.id}/updates/${update.id}/report`}>Report</a>
                    </>
                  )}
                </p>
                <p class="description">
                  {linkify(update.body).map(({ text, href }) =>
                    href ? (
                      <a href={href} rel="nofollow ugc noopener">
                        {text}
                      </a>
                    ) : (
                      text
                    )
                  )}
                </p>
                {update.hidden_at && moderator && (
                  <ModerationAction
                    id={`unhide-update-${update.id}`}
                    label="Unhide update"
                    title="Unhide this update?"
                    action={actions.moderation.unhideUpdate.queryString}
                    fields={{ update_id: update.id }}
                    confirm="Yes, unhide it"
                    cancel="No, keep it hidden"
                  >
                    <p>Members will see it again on this page and in Alerts.</p>
                  </ModerationAction>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
      <div class="actions">
        {hosting ? (
          <>
            <p>You're hosting</p>
            <span class="hosting">
              {!activity.hidden_at && <a href={`/activities/${activity.id}/update`}>Post update</a>}
              <a href={`/activities/${activity.id}/edit`}>Edit</a>
            </span>
          </>
        ) : !open || full ? (
          <>
            <p id="rsvp-note">
              {activity.status === 'cancelled'
                ? 'This activity is cancelled.'
                : activity.hidden_at
                  ? 'This activity is hidden.'
                  : open
                    ? 'Every spot is taken.'
                    : 'This activity is over.'}
            </p>
            <button type="button" disabled aria-describedby="rsvp-note">
              {going ? '✓ Going' : open ? 'Full' : "I'm in"}
            </button>
          </>
        ) : (
          <RsvpForm
            activityId={activity.id}
            status={answer}
            guests={
              activity.guests_allowed
                ? { most: activity.max_guests_per_rsvp, mine: activity.mine[0]?.guest_count ?? 0 }
                : undefined
            }
          />
        )}
      </div>
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This activity isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
  {member && (
    <template data-my-face>
      <Avatar member={member} named />
    </template>
  )}
</Layout>

<script>
  import { clearDraft } from '../../../scripts/activity-draft';
  import '../../../scripts/private-details';
  import '../../../scripts/rsvp';
  import '../../../scripts/share';
  import '../../../scripts/sheets';

  // The draft from the create form is posted now (ACT-03).
  if (document.querySelector('[data-posted]')) clearDraft();
</script>

<style>
  .top,
  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .banner {
    padding: 0.75rem 1rem;
    border-left: 0.25rem solid #b42318;
    background: #fef3f2;
  }
  .banner p {
    margin: 0;
  }
  .banner > :first-child {
    font-weight: 600;
  }
  /* Add to calendar reads as a link beside the time, as Open in Maps does beside the place. It's
     at least 24 px tall (WCAG 2.2 target size). */
  .link {
    padding: 0.25rem 0;
    font: inherit;
    color: LinkText;
    text-decoration: underline;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .calendars {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .calendars a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .handover {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .category {
    margin-bottom: 0;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .going button {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 44px;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .all {
    display: inline-grid;
    place-items: center;
    min-height: 44px;
  }
  .description {
    white-space: pre-line;
  }
  .updated {
    font-size: 0.875rem;
  }
  /* Within thumb reach at the bottom of the screen, even when the page is short, so toasts sit
     above it rather than on ✓ Going. The page leaves room for it. */
  .actions {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    max-width: 40rem;
    margin: 0 auto;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background: white;
    border-top: 1px solid #767676;
  }
  :global(footer) {
    padding-bottom: calc(5rem + env(safe-area-inset-bottom));
  }
  .actions p {
    margin: 0;
  }
  .actions button,
  .actions a {
    display: inline-grid;
    place-items: center;
    min-width: 8rem;
    min-height: 44px;
  }
  /* Post update and Edit side by side, which fit beside "You're hosting" at 320 px. */
  .hosting {
    display: flex;
    gap: 1rem;
  }
  .actions .hosting a {
    min-width: 44px;
  }
  .updates ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .updates li + li {
    border-top: 1px solid #767676;
  }
  .byline {
    margin-bottom: 0;
    font-size: 0.875rem;
    color: #595959;
  }
  /* Report, at least 24 px tall (WCAG 2.2 target size). */
  .byline a {
    display: inline-block;
    padding: 0.25rem 0;
  }
  .updates .hidden {
    margin-bottom: 0;
    padding: 0.25rem 0.75rem;
    font-weight: 600;
    border-left: 0.25rem solid #b42318;
    background: #fef3f2;
  }
</style>
