  }
  .updates li + li {
    border-top: 1px solid var(--border);
  }
  .byline {
    margin-bottom: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  /* Report, at least 24 px tall (WCAG 2.2 target size). */
  .byline a {
    display: inline-block;
    padding: 0.25rem 0;
  }
  .updates .hidden {
    margin-bottom: 0;
    padding: 0.25rem 0.75rem;
    font-weight: 600;
    border-left: 0.25rem solid var(--danger);
    background: var(--danger-soft);
  }
</style>
