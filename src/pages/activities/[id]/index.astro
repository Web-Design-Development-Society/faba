    border-top: 1px solid var(--border);
  }
  :global(footer) {
    padding-bottom: calc(5rem + env(safe-area-inset-bottom));
  }
  .actions p {
    margin: 0;
  }
  .actions button {
    min-width: 8rem;
  }
  /* Post update, Edit and Post again side by side, beside "You're hosting", which wraps first on a
     narrow phone (UI-12). */
  .actions > p {
    flex: 1;
    min-width: 0;
  }
  .hosting {
    display: flex;
    flex: none;
    gap: 0.5rem;
  }
  .hosting .button {
