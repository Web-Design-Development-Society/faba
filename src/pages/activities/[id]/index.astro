---
// An activity's page (ACT-02, design document section 7.6), in the order people ask: what, when,
// where, who, then the details. Report opens the Report form (MOD-01), and those going or maybe can
// Mute updates from the same menu (NOTIF-08). Its organizer's updates come last, newest first, and
// Post update sits beside Edit (NOTIF-04). Post again joins them once it's over or cancelled
// (ACT-07). Moderators unhide a hidden one here (MOD-03), and give an ineligible organizer's
// upcoming one to a new host or cancel it (AUTH-05). Its details for attendees show only to those
// who can read them (ACT-09). Add to calendar sits at the right of the time (ACT-08). A board activity has a
// badge, and an admin who organizes one marks it and announces it from the menu (MOD-07). One
// posted under a group names it, and says when it's for the group's members only (GRP-03). A date
// in a series says how often it repeats, and through when (REC-01), and its organizer cancels
// just that date from here (REC-03). Anyone else joins the whole series, or leaves it (REC-04).
//
// It reads top to bottom (UI-21): the time, the place and the host, big and with no icons; then the
// details; then everyone going, listed on the page. Managing attendees and co-organizers is in its
// own sheet, for those who can.
import { actions, isInputError } from 'astro:actions';
import Avatar from '../../../components/Avatar.astro';
import Back from '../../../components/Back.astro';
import BoardContact from '../../../components/BoardContact.astro';
import CancelActivity from '../../../components/CancelActivity.astro';
import CoverPicture from '../../../components/CoverPicture.astro';
import GoingList from '../../../components/GoingList.astro';
import Icon from '../../../components/Icon.astro';
import Menu from '../../../components/Menu.astro';
import ModerationAction from '../../../components/ModerationAction.astro';
import ParticipationDisclaimer from '../../../components/ParticipationDisclaimer.astro';
import RsvpForm from '../../../components/RsvpForm.astro';
import PictureUpload from '../../../components/PictureUpload.astro';
import Sheet from '../../../components/Sheet.astro';
import Status from '../../../components/Status.astro';
import Layout from '../../../layouts/Layout.astro';
import { profileHref } from '../../../lib/back';
import { googleCalendarUrl } from '../../../lib/calendar';
import { isFull } from '../../../lib/cards';
import { categoryLook } from '../../../lib/categories';
import { PHYSICAL_CATEGORIES } from '../../../lib/contact';
import { linkify, mapsUrl } from '../../../lib/links';
import { repeatsSentence } from '../../../lib/series';
import {
  FLASH_MESSAGES,
  pictureRefusal,
  postedFrom,
  setFlash,
  takeFlash,
} from '../../../lib/server/flash';
import { formatAgo, formatDate, formatRange, isOver } from '../../../lib/time';

// People in who's going before Show all (RSVP-03).
const LIST = 50;

const { supabase, user, member } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

// I'm in and Can't make it without JavaScript (RSVP-01, RSVP-02). When it fails, the page says why.
const rsvp = Astro.getActionResult(actions.rsvps.set);
if (rsvp && !rsvp.error) {
  setFlash(Astro.cookies, Astro.url, rsvp.data.status);
  return Astro.redirect(postedFrom(Astro.url), 303);
}
// I'm in for all upcoming, and Leave series, on a date in a series (REC-04).
const joinSeries = Astro.getActionResult(actions.rsvps.joinSeries);
if (joinSeries && !joinSeries.error) {
  setFlash(Astro.cookies, Astro.url, 'joined_series');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const leaveSeries = Astro.getActionResult(actions.rsvps.leaveSeries);
if (leaveSeries && !leaveSeries.error) {
  setFlash(Astro.cookies, Astro.url, 'left_series');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
// Adding or removing a co-organizer, from the attendee list (ACT-10).
const addCoOrganizer = Astro.getActionResult(actions.activities.addCoOrganizer);
if (addCoOrganizer && !addCoOrganizer.error) {
  setFlash(Astro.cookies, Astro.url, 'co_organizer_added');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const removeCoOrganizer = Astro.getActionResult(actions.activities.removeCoOrganizer);
if (removeCoOrganizer && !removeCoOrganizer.error) {
  setFlash(Astro.cookies, Astro.url, 'co_organizer_removed');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
// Taking an attendee off the list (RSVP-09).
const removeAttendee = Astro.getActionResult(actions.rsvps.removeAttendee);
if (removeAttendee && !removeAttendee.error) {
  setFlash(Astro.cookies, Astro.url, 'attendee_removed');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const unhide = Astro.getActionResult(actions.moderation.unhide);
if (unhide && !unhide.error) {
  setFlash(Astro.cookies, Astro.url, 'unhidden');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const transfer = Astro.getActionResult(actions.moderation.transfer);
if (transfer && !transfer.error) {
  setFlash(Astro.cookies, Astro.url, 'transferred');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const cancel = Astro.getActionResult(actions.moderation.cancel);
if (cancel && !cancel.error) {
  setFlash(Astro.cookies, Astro.url, 'cancelled');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
// Cancel this date, on a date in a series (REC-03).
const cancelDate = Astro.getActionResult(actions.activities.cancel);
if (cancelDate && !cancelDate.error) {
  setFlash(Astro.cookies, Astro.url, 'cancelled');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const mute = Astro.getActionResult(actions.notifications.mute);
if (mute && !mute.error) {
  setFlash(Astro.cookies, Astro.url, mute.data.muted ? 'muted' : 'unmuted');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const board = Astro.getActionResult(actions.activities.setBoard);
if (board && !board.error) {
  setFlash(Astro.cookies, Astro.url, board.data.board ? 'board' : 'not_board');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const announce = Astro.getActionResult(actions.activities.announce);
if (announce && !announce.error) {
  setFlash(Astro.cookies, Astro.url, 'announced');
  return Astro.redirect(postedFrom(Astro.url), 303);
}
const unhideUpdate = Astro.getActionResult(actions.moderation.unhideUpdate);
if (unhideUpdate && !unhideUpdate.error) {
  setFlash(Astro.cookies, Astro.url, 'update_unhidden');
  return Astro.redirect(postedFrom(Astro.url, '#updates'), 303);
}
// Comments (ACT-12). A failed one shows in the comments section, beside its form.
const commentPosted = Astro.getActionResult(actions.comments.post);
if (commentPosted && !commentPosted.error) {
  setFlash(Astro.cookies, Astro.url, 'comment_posted');
  return Astro.redirect(postedFrom(Astro.url, '#comments'), 303);
}
const commentRemoved = Astro.getActionResult(actions.comments.remove);
if (commentRemoved && !commentRemoved.error) {
  setFlash(Astro.cookies, Astro.url, 'comment_deleted');
  return Astro.redirect(postedFrom(Astro.url, '#comments'), 303);
}
const commentHidden = Astro.getActionResult(actions.moderation.hideComment);
if (commentHidden && !commentHidden.error) {
  setFlash(Astro.cookies, Astro.url, 'comment_hidden');
  return Astro.redirect(postedFrom(Astro.url, '#comments'), 303);
}
const commentUnhidden = Astro.getActionResult(actions.moderation.unhideComment);
if (commentUnhidden && !commentUnhidden.error) {
  setFlash(Astro.cookies, Astro.url, 'comment_unhidden');
  return Astro.redirect(postedFrom(Astro.url, '#comments'), 303);
}
const commentError =
  commentPosted?.error?.message ??
  commentRemoved?.error?.message ??
  commentHidden?.error?.message ??
  commentUnhidden?.error?.message;
// The error shows at the top, since its sheet has closed.
const failed =
  joinSeries?.error ??
  leaveSeries?.error ??
  addCoOrganizer?.error ??
  removeCoOrganizer?.error ??
  removeAttendee?.error ??
  unhide?.error ??
  transfer?.error ??
  cancel?.error ??
  cancelDate?.error ??
  mute?.error ??
  board?.error ??
  announce?.error ??
  unhideUpdate?.error;
const failure = isInputError(failed) ? Object.values(failed.fields).flat()[0] : failed?.message;

// Only its organizer and moderators can read a hidden activity (RLS), so it's not available to
// anyone else. Nor is an id that isn't a UUID, which is an error. Only active members are going, in
// the faces and the list (RSVP-03). Members can't read suspended members' profiles (RLS), and the
// filter keeps those out for moderators too, who'll be able to. Only its organizer, members going
// and moderators can read its details for attendees (RLS), so nobody else's page has them.
const [{ data: activity }, { data: me }] = await Promise.all([
  supabase
    .from('activities')
    .select(
      `id, title, description, starts_at, ends_at, location_name, cost_note, status, cancel_reason,
      hidden_at, hidden_reason, going_count, maybe_count, guest_total, capacity, guests_allowed,
      max_guests_per_rsvp, organizer_id,
      time_or_place_changed_at, category_id, has_private_details, is_board_activity, announced_at,
      visibility, group:groups(name, slug),
      series:activity_series(freq, start_date, until_date, subscribed:series_subscriptions(user_id)),
      private:activity_private_details(details),
      category:categories(name, icon, color_token),
      organizer:profiles!activities_organizer_id_fkey(id, display_name, avatar_url, use_initials, department, status),
      co_organizers:activity_co_organizers(member:profiles!activity_co_organizers_user_id_fkey!inner(id, display_name, avatar_url, use_initials, department)),
      mine:rsvps(status, guest_count, mute:activity_mutes(muted_at)),
      going:rsvps(member:profiles!inner(id, display_name, avatar_url, use_initials, department)),
      maybe:rsvps(member:profiles!inner(id, display_name, avatar_url, use_initials, department)),
      cover:images!activities_cover_image_id_fkey(id, alt, uploaded_by, width, height, hidden_at,
        hidden_reason),
      updates:activity_updates(id, body, created_at, author_id, hidden_at, hidden_reason,
        author:profiles!activity_updates_author_id_fkey(display_name)),
      comments:activity_comments(id, body, created_at, author_id, hidden_at, hidden_reason,
        author:profiles!activity_comments_author_id_fkey(display_name))`
    )
    .eq('id', Astro.params.id!)
    .eq('mine.user_id', user.id)
    .eq('going.status', 'going')
    .eq('going.member.status', 'active')
    .eq('maybe.status', 'maybe')
    .eq('maybe.member.status', 'active')
    .order('created_at', { referencedTable: 'going' })
    .limit(LIST, { referencedTable: 'going' })
    .order('created_at', { referencedTable: 'updates', ascending: false })
    .limit(LIST, { referencedTable: 'updates' })
    .order('created_at', { referencedTable: 'comments' })
    .limit(LIST, { referencedTable: 'comments' })
    .maybeSingle(),
  // The member in who's going, for after I'm in.
  supabase
    .from('profiles')
    .select('id, display_name, avatar_url, use_initials, department')
    .eq('id', user.id)
    .single(),
]);
if (!activity) Astro.response.status = 404;

const flash = takeFlash(Astro.cookies);
// A refused picture says why next to its form, not in the toast (MEDIA-01).
const pictureError = pictureRefusal(flash);
// Co-organizers (ACT-10) can edit and cancel too, so they host like the organizer does.
const coOrganizers = activity?.co_organizers.map(({ member }) => member) ?? [];
const hosting = activity?.organizer_id === user.id || coOrganizers.some(({ id }) => id === user.id);
const answer = activity?.mine[0]?.status ?? null;
const going = answer === 'going';
// Whether the member joined its series (REC-04). RLS shows them only their own subscription.
const inSeries = !!activity?.series?.subscribed.length;
// Those going or maybe, the organizer among them, hear about it, so they can mute it (NOTIF-08).
const mutable = going || answer === 'maybe';
const muted = !!activity?.mine[0]?.mute;
const moderator =
  member?.status === 'active' && (member.role === 'moderator' || member.role === 'admin');
const over =
  !!activity &&
  isOver(
    new Date(activity.starts_at),
    activity.ends_at ? new Date(activity.ends_at) : null,
    new Date()
  );
// A hidden one takes no RSVPs, as rsvp() says.
const open = activity?.status === 'published' && !activity.hidden_at && !over;
const host = activity?.organizer;
// Full to anyone not going or maybe (RSVP-04), who can join its waitlist (RSVP-07). A maybe can
// still change their answer.
const full = !!activity && !going && answer !== 'maybe' && isFull(activity);
// On the waitlist, and their place in it (RSVP-07). Members can't read who else is waiting.
const waitlisted = answer === 'waitlisted';
const { data: position } =
  activity && waitlisted && full
    ? await supabase.rpc('waitlist_position', { activity_id: activity.id })
    : { data: null };
// Who's maybe, which only the organizer can read (RSVP-05).
const maybes = activity?.maybe.map(({ member }) => member) ?? [];
// An ineligible organizer's upcoming activity, which moderators can give to someone going or
// cancel (AUTH-05). Members can't read that organizer, but moderators can.
const handover =
  moderator &&
  host?.status === 'ineligible' &&
  activity?.status === 'published' &&
  new Date(activity.starts_at) > new Date();
// An admin marks the activities they organize as board activities, and announces one once, while
// it's coming up (MOD-07). The sheet warns once 2 or more went out in the last 30 days.
const admin = member?.status === 'active' && member.role === 'admin';
const boardAdmin = admin && hosting;
// Whether the member can manage the attendee list: the organizer, a co-organizer, a moderator or a
// group organizer (RSVP-09). The database checks it again on every change.
const { data: canManage } = activity
  ? await supabase.rpc('manages_attendees', { activity_id: activity.id })
  : { data: false };
// The Manage attendees sheet, for those who can take people off the list or choose co-organizers.
const manageable = activity?.status === 'published' && (!!canManage || hosting);
const announceable =
  !!activity &&
  boardAdmin &&
  activity.is_board_activity &&
  !activity.announced_at &&
  activity.status === 'published' &&
  !activity.hidden_at &&
  new Date(activity.starts_at) > new Date();
const { count: announcedLately } = announceable
  ? await supabase
      .from('activities')
      .select('id', { count: 'exact', head: true })
      .gt('announced_at', new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString())
  : { count: 0 };
const people = activity?.going.map(({ member }) => member) ?? [];
// Going members who can be made co-organizers (ACT-10): not the organizer, nor one already.
const addable = people.filter(
  ({ id }) => id !== activity?.organizer_id && !coOrganizers.some((c) => c.id === id)
);
const look = activity?.category ? categoryLook(activity.category) : null;
const url = new URL(Astro.url.pathname, Astro.url.origin).href;
// Add to calendar (ACT-08), until it's cancelled or over. The .ics has the details for attendees
// for a member going, and the Google Calendar link never has them.
const google =
  activity?.status === 'published' && !over
    ? googleCalendarUrl({
        title: activity.title,
        startsAt: new Date(activity.starts_at),
        endsAt: activity.ends_at ? new Date(activity.ends_at) : null,
        place: activity.location_name,
        description: activity.description,
        url,
      })
    : null;
const withReason = (label: string, reason: string | null) =>
  reason ? `${label}: ${reason}` : label;
const email = activity
  ? `mailto:?subject=${encodeURIComponent(activity.title)}&body=${encodeURIComponent(url)}`
  : undefined;
---

<Layout title={activity?.title ?? 'Not available'} paper>
  <header class="top">
    <Back href="/discover">Back to Discover</Back>
    {activity && (
      <Menu>
        <li>
          <a href={email} data-share data-title={activity.title} data-url={url}>
            Share
          </a>
        </li>
        {mutable && (
          <li>
            <form method="post" action={actions.notifications.mute.queryString}>
              <input type="hidden" name="activity_id" value={activity.id} />
              <input type="hidden" name="muted" value={String(!muted)} />
              <button>{muted ? 'Unmute updates' : 'Mute updates'}</button>
            </form>
          </li>
        )}
        {boardAdmin && (
          <li>
            <form method="post" action={actions.activities.setBoard.queryString}>
              <input type="hidden" name="id" value={activity.id} />
              <input type="hidden" name="board" value={String(!activity.is_board_activity)} />
              <button>
                {activity.is_board_activity ? 'Not a board activity' : 'Mark as board activity'}
              </button>
            </form>
          </li>
        )}
        {announceable && (
          <li>
            <button type="button" commandfor="announce" command="show-modal">
              Announce to every member
            </button>
          </li>
        )}
        <li>
          <a href={`/activities/${activity.id}/report`}>Report</a>
        </li>
      </Menu>
    )}
  </header>
  {activity && announceable && (
    <Sheet id="announce" title="Announce to every member?">
      <p>
        Every active member gets it in Alerts. An activity can be announced only once, and it can't
        be taken back.
      </p>
      {(announcedLately ?? 0) >= 2 && (
        <p class="warning">
          The board has sent {announcedLately} announcements in the last 30 days. The guidance is 2
          or fewer a month, so members don't tune them out.
        </p>
      )}
      <form method="post" action={actions.activities.announce.queryString}>
        <input type="hidden" name="id" value={activity.id} />
        <button type="submit">Yes, announce it</button>
      </form>
      <form method="dialog">
        <button>Not now</button>
      </form>
    </Sheet>
  )}
  <Status
    message={flash && !pictureError ? FLASH_MESSAGES[flash] : undefined}
    data-posted={flash === 'posted' ? '' : undefined}
  />
  {rsvp?.error && <p role="alert">{rsvp.error.message}</p>}
  {failure && <p role="alert">{failure}</p>}
  {activity ? (
    <>
      {activity.hidden_at && (
        <div class="banner">
          <p>{withReason('Hidden by a moderator', activity.hidden_reason)}</p>
          {hosting ? (
            <p>
              Contact <BoardContact /> if you think this was a mistake.
            </p>
          ) : (
            moderator && (
              <ModerationAction
                id="unhide"
                label="Unhide"
                title="Unhide this activity?"
                action={actions.moderation.unhide.queryString}
                fields={{ activity_id: activity.id }}
                confirm="Yes, unhide it"
                cancel="No, keep it hidden"
              >
                <p>Members will see it again, and it goes back on Discover if it's coming up.</p>
              </ModerationAction>
            )
          )}
        </div>
      )}
      {activity.status === 'cancelled' && (
        <p class="banner">{withReason('Cancelled', activity.cancel_reason)}</p>
      )}
      {/* The title, then what it's part of in a line under it (UI-26). */}
      <h1>{activity.title}</h1>
      {activity.group && (
        <p class="meta">
          Group: <a href={`/groups/${activity.group.slug}`}>{activity.group.name}</a>
          {activity.visibility === 'group' && ' · Group members only'}
        </p>
      )}
      {activity.is_board_activity && <p class="board">FABA board activity</p>}
      {boardAdmin && activity.announced_at && (
        <p class="small">
          Announced{' '}
          <time datetime={activity.announced_at}>
            {formatAgo(new Date(activity.announced_at), new Date())}
          </time>
        </p>
      )}
      {activity.cover && !activity.cover.hidden_at && (
        <CoverPicture image={activity.cover} viewer={user.id} shape="cover" />
      )}
      {activity.cover?.hidden_at && (
        <p class="hidden">
          {withReason('Picture hidden by a moderator', activity.cover.hidden_reason)}
        </p>
      )}
      {/* Each fact under a plain heading, one after another, with its link quietly at the right of
          the heading (UI-21, UI-26). The time and the place are bigger. */}
      <section class="topic" aria-labelledby="when-heading">
        <div class="topic-head">
          <h2 id="when-heading">Date and time</h2>
          {google && (
            <button type="button" class="quiet" commandfor="calendar" command="show-modal">
              Add to calendar
            </button>
          )}
        </div>
        <p class="big">
          <time datetime={activity.starts_at}>
            {formatRange(
              new Date(activity.starts_at),
              activity.ends_at ? new Date(activity.ends_at) : null
            )}
          </time>
        </p>
        {activity.series && (
          <p class="small">
            {repeatsSentence(activity.series.freq, activity.series.start_date)}
            {activity.series.until_date && ` through ${formatDate(activity.series.until_date)}`}
          </p>
        )}
      </section>
      <section class="topic" aria-labelledby="where-heading">
        <div class="topic-head">
          <h2 id="where-heading">Location</h2>
          <a
            href={mapsUrl(activity.location_name, Astro.request.headers.get('user-agent') ?? '')}
            class="quiet"
          >
            Open in Maps
          </a>
        </div>
        <p class="big">{activity.location_name}</p>
        {activity.time_or_place_changed_at && (
          <p class="small">
            Updated{' '}
            <time datetime={activity.time_or_place_changed_at}>
              {formatAgo(new Date(activity.time_or_place_changed_at), new Date())}
            </time>
          </p>
        )}
      </section>
      {activity.cost_note && (
        <section class="topic" aria-labelledby="cost-heading">
          <h2 id="cost-heading">Cost</h2>
          <p class="fact">{activity.cost_note}</p>
        </section>
      )}
      <section class="topic" aria-labelledby="host-heading">
        <h2 id="host-heading">Host</h2>
        {host?.status === 'active' ? (
          <p class="host fact">
            <Avatar member={host} />
            <span>
              <a href={profileHref(host.id, `/activities/${activity.id}`)}>{host.display_name}</a>
              {host.department && <span class="small department">{host.department}</span>}
            </span>
          </p>
        ) : activity.organizer_id ? (
          // Members can't read an organizer who isn't active (AUTH-05). Moderators see who it was.
          <p class="fact">
            Organizer no longer active
            {host && (
              <>
                {' '}
                ·{' '}
                <a href={profileHref(host.id, `/activities/${activity.id}`)}>{host.display_name}</a>
              </>
            )}
          </p>
        ) : (
          // Its organizer deleted their account (PROF-05).
          <p class="fact">Former member</p>
        )}
      </section>
      {/* A regular joins the whole series once, and leaves it the same way (REC-04). */}
      {activity.series && !hosting && !activity.hidden_at && (
        <form
          method="post"
          class="series"
          action={
            inSeries ? actions.rsvps.leaveSeries.queryString : actions.rsvps.joinSeries.queryString
          }
        >
          <input type="hidden" name="activity_id" value={activity.id} />
          {inSeries && <span>You're in for all upcoming dates.</span>}
          <button>{inSeries ? 'Leave series' : "I'm in for all upcoming"}</button>
        </form>
      )}
      {/* Skipping a week takes 2 taps from here (REC-03). Edit has it too, as for any activity. */}
      {activity.series && hosting && open && (
        <p>
          <CancelActivity activityId={activity.id} inSeries />
        </p>
      )}
      {google && (
        <Sheet id="calendar" title="Add to calendar">
          <ul class="calendars">
            <li>
              <a href={`/activities/${activity.id}.ics`} class="button">
                Download for Apple Calendar or Outlook
              </a>
            </li>
            <li>
              <a href={google} target="_blank" rel="noopener" class="button">
                Open in Google Calendar
              </a>
            </li>
          </ul>
          <p>Your calendar's copy won't change if the activity does.</p>
        </Sheet>
      )}
      {activity.description && (
        <section class="topic" aria-labelledby="about">
          <h2 id="about">Details</h2>
          <p class="description">
            {linkify(activity.description).map(({ text, href }) =>
              href ? (
                <a href={href} rel="nofollow ugc noopener">
                  {text}
                </a>
              ) : (
                text
              )
            )}
          </p>
        </section>
      )}
      {activity.has_private_details && (
        // After the member's answer changes, src/scripts/private-details.ts shows the details or
        // the note.
        <section class="topic" aria-labelledby="for-attendees" data-private-details={activity.id}>
          <h2 id="for-attendees">For attendees</h2>
          <p class="description" data-details hidden={!activity.private}>
            {activity.private &&
              linkify(activity.private.details).map(({ text, href }) =>
                href ? (
                  <a href={href} rel="nofollow ugc noopener">
                    {text}
                  </a>
                ) : (
                  text
                )
              )}
          </p>
          <p data-note hidden={!!activity.private}>
            <span aria-hidden="true">🔒</span> Exact location shared with attendees after you RSVP.
          </p>
        </section>
      )}
      {/* Everyone going, on the page with no tap needed (RSVP-03, UI-21): the count, then each
          member, with the organizer first. The organizer also sees who's maybe (RSVP-05). */}
      <section class="who topic" aria-labelledby="going-heading">
        <div class="topic-head">
          <h2 id="going-heading">Who's going</h2>
          {manageable && (
            <button type="button" class="quiet" commandfor="manage" command="show-modal">
              Manage attendees
            </button>
          )}
        </div>
        <p class="going" data-going={activity.id}>
          <span data-count>{activity.going_count}</span> going
          <span
            data-guest-total={activity.id}
            data-value={activity.guest_total}
            hidden={!activity.guest_total}
          >
            {` (+${activity.guest_total} ${activity.guest_total === 1 ? 'guest' : 'guests'})`}
          </span>
          <span data-maybe={activity.id} hidden={!activity.maybe_count}>
            {' · '}
            <span data-count>{activity.maybe_count}</span> maybe
          </span>
        </p>
        <GoingList
          from={`/activities/${activity.id}`}
          activityId={activity.id}
          organizerId={activity.organizer_id}
          people={people}
          me={people.length < LIST ? me : null}
        />
        {activity.going_count > LIST && (
          <a class="all button" href={`/activities/${activity.id}/going`}>
            Show all
          </a>
        )}
        {maybes.length > 0 && (
          <>
            <h3>Maybe</h3>
            <GoingList
              activityId={`${activity.id}-maybe`}
              organizerId={null}
              people={maybes}
              from={`/activities/${activity.id}`}
            />
          </>
        )}
      </section>
      {/* The category as a chip with its icon, on a tint of its color (UI-05), in its own part. */}
      {activity.category && look && (
        <section class="topic" aria-labelledby="category-heading">
          <h2 id="category-heading">Category</h2>
          <p class="category" style={`--tint: ${look.color}`}>
            <Icon name={look.icon} />
            {activity.category.name}
          </p>
        </section>
      )}
      {/* Taking people off the list and choosing co-organizers, for those who can (RSVP-09, ACT-10). */}
      {manageable && (
        <Sheet id="manage" title="Manage attendees">
          {canManage && activity.status === 'published' && (
            <section class="manage-attendees">
              <h3>Attendees</h3>
              <p>
                <a href={`/activities/${activity.id}/attendees.csv`} download class="button">
                  Export CSV
                </a>{' '}
                (names only)
              </p>
              {people.some(({ id }) => id !== activity.organizer_id) ? (
                <ul>
                  {people
                    .filter(({ id }) => id !== activity.organizer_id)
                    .map((member) => (
                      <li>
                        {member.display_name}{' '}
                        <form method="post" action={actions.rsvps.removeAttendee.queryString}>
                          <input type="hidden" name="activity_id" value={activity.id} />
                          <input type="hidden" name="user_id" value={member.id} />
                          <button class="danger">Take {member.display_name} off the list</button>
                        </form>
                      </li>
                    ))}
                </ul>
              ) : (
                <p>No one else is going yet.</p>
              )}
            </section>
          )}
          {hosting && activity.status === 'published' && (
            <section class="co-organizers">
              <h3>Co-organizers</h3>
              {coOrganizers.length === 0 ? (
                <p>No co-organizers yet. Up to 3 can edit and cancel this activity.</p>
              ) : (
                <ul>
                  {coOrganizers.map((co) => (
                    <li>
                      {co.display_name}{' '}
                      <form method="post" action={actions.activities.removeCoOrganizer.queryString}>
                        <input type="hidden" name="activity_id" value={activity.id} />
                        <input type="hidden" name="user_id" value={co.id} />
                        <button class="danger">Remove {co.display_name}</button>
                      </form>
                    </li>
                  ))}
                </ul>
              )}
              {coOrganizers.length < 3 && addable.length > 0 && (
                <>
                  <h4>Make a co-organizer</h4>
                  <ul>
                    {addable.map((member) => (
                      <li>
                        {member.display_name}{' '}
                        <form method="post" action={actions.activities.addCoOrganizer.queryString}>
                          <input type="hidden" name="activity_id" value={activity.id} />
                          <input type="hidden" name="user_id" value={member.id} />
                          <button class="secondary">
                            Make {member.display_name} a co-organizer
                          </button>
                        </form>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </section>
          )}
        </Sheet>
      )}
      {handover && (
        <div class="handover">
          {people.length > 0 && (
            <ModerationAction
              id="handover-transfer"
              label="Give to a new host"
              title="Give this activity to a new host?"
              action={actions.moderation.transfer.queryString}
              fields={{ activity_id: activity.id }}
              confirm="Yes, give it to them"
              cancel="No, leave it"
            >
              <p>Pick someone who's going and has agreed to host it. It becomes theirs to edit.</p>
              <p slot="fields">
                <label for="handover-to">New host</label>
                <br />
                <select id="handover-to" name="to_user" required>
                  {people.map((member) => (
                    <option value={member.id}>{member.display_name}</option>
                  ))}
                </select>
              </p>
            </ModerationAction>
          )}
          <ModerationAction
            id="handover-cancel"
            label="Cancel it"
            title="Cancel this activity?"
            action={actions.moderation.cancel.queryString}
            fields={{ activity_id: activity.id }}
            confirm="Yes, cancel it"
            cancel="No, leave it"
          >
            <p>
              The people going will see it's cancelled because its organizer is no longer active.
            </p>
          </ModerationAction>
        </div>
      )}
      {PHYSICAL_CATEGORIES.includes(activity.category_id) && <ParticipationDisclaimer />}
      {activity.updates.length > 0 && (
        <section class="updates topic" aria-labelledby="updates">
          <h2 id="updates">Updates</h2>
          <ul>
            {activity.updates.map((update) => (
              <li>
                {update.hidden_at && (
                  // Only its author and moderators read a hidden update (NOTIF-04).
                  <p class="hidden">{withReason('Hidden by a moderator', update.hidden_reason)}</p>
                )}
                <p class="byline">
                  {update.author?.display_name ?? 'Organizer'},{' '}
                  <time datetime={update.created_at}>
                    {formatAgo(new Date(update.created_at), new Date())}
                  </time>
                  {!update.hidden_at && update.author_id !== user.id && (
                    <>
                      {' · '}
                      <a href={`/activities/${activity.id}/updates/${update.id}/report`}>Report</a>
                    </>
                  )}
                </p>
                <p class="description">
                  {linkify(update.body).map(({ text, href }) =>
                    href ? (
                      <a href={href} rel="nofollow ugc noopener">
                        {text}
                      </a>
                    ) : (
                      text
                    )
                  )}
                </p>
                {update.hidden_at && moderator && (
                  <ModerationAction
                    id={`unhide-update-${update.id}`}
                    label="Unhide update"
                    title="Unhide this update?"
                    action={actions.moderation.unhideUpdate.queryString}
                    fields={{ update_id: update.id }}
                    confirm="Yes, unhide it"
                    cancel="No, keep it hidden"
                  >
                    <p>Members will see it again on this page and in Alerts.</p>
                  </ModerationAction>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
      {hosting && !activity.hidden_at && (
        <section class="cover-upload topic" aria-labelledby="cover-heading">
          <h2 id="cover-heading">Cover picture</h2>
          <PictureUpload
            target="activity"
            id={activity.id}
            back={`/activities/${activity.id}`}
            submit="Save picture"
            error={pictureError}
          />
        </section>
      )}
      <section class="comments topic" id="comments" aria-labelledby="comments-heading">
        <h2 id="comments-heading">Questions and comments</h2>
        {commentError && <p role="alert">{commentError}</p>}
        {activity.comments.length > 0 ? (
          <ul>
            {activity.comments.map((comment) => (
              <li>
                {comment.hidden_at && (
                  // Only its author and moderators read a hidden comment (ACT-12).
                  <p class="hidden">{withReason('Hidden by a moderator', comment.hidden_reason)}</p>
                )}
                <p class="byline">
                  {comment.author?.display_name ?? 'Member'},{' '}
                  <time datetime={comment.created_at}>
                    {formatAgo(new Date(comment.created_at), new Date())}
                  </time>
                  {!comment.hidden_at && comment.author_id !== user.id && (
                    <>
                      {' · '}
                      <a href={`/activities/${activity.id}/comments/${comment.id}/report`}>
                        Report
                      </a>
                    </>
                  )}
                </p>
                <p class="description">{comment.body}</p>
                {comment.author_id === user.id && (
                  <form method="post" action={actions.comments.remove.queryString}>
                    <input type="hidden" name="comment_id" value={comment.id} />
                    <button class="danger">Delete my comment</button>
                  </form>
                )}
                {comment.hidden_at && moderator && (
                  <ModerationAction
                    id={`unhide-comment-${comment.id}`}
                    label="Unhide comment"
                    title="Unhide this comment?"
                    action={actions.moderation.unhideComment.queryString}
                    fields={{ comment_id: comment.id }}
                    confirm="Yes, unhide it"
                    cancel="No, keep it hidden"
                  >
                    <p>Members will see it again on this page.</p>
                  </ModerationAction>
                )}
                {!comment.hidden_at && moderator && (
                  <ModerationAction
                    id={`hide-comment-${comment.id}`}
                    label="Hide comment"
                    title="Hide this comment?"
                    action={actions.moderation.hideComment.queryString}
                    fields={{ comment_id: comment.id }}
                    confirm="Hide comment"
                    cancel="Keep it visible"
                    templates
                  >
                    <p>Members won't see it here. Its author sees your reason.</p>
                  </ModerationAction>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p>No questions or comments yet.</p>
        )}
        {!activity.hidden_at && (
          <form method="post" action={actions.comments.post.queryString} class="stack">
            <input type="hidden" name="activity_id" value={activity.id} />
            <label for="comment-body">Ask a question or leave a comment</label>
            <textarea id="comment-body" name="body" maxlength="500" required></textarea>
            <button>Post comment</button>
          </form>
        )}
      </section>
      <div class="actions">
        {hosting ? (
          <>
            <p>You're hosting</p>
            <span class="hosting">
              {!activity.hidden_at && (
                <a href={`/activities/${activity.id}/update`} class="button">
                  Post update
                </a>
              )}
              <a href={`/activities/${activity.id}/edit`} class="button primary">
                Edit
              </a>
              {!open && !activity.hidden_at && (
                <a href={`/activities/new?from=${activity.id}`} class="button">
                  Post again
                </a>
              )}
            </span>
          </>
        ) : open && full ? (
          // Join waitlist, and a member's place on it with Leave waitlist (RSVP-07).
          <>
            <p id="rsvp-note">
              {waitlisted
                ? `You're #${position ?? 1} on the waitlist. You're in if a spot opens.`
                : 'Every spot is taken.'}
            </p>
            <form method="post" action={actions.rsvps.set.queryString}>
              <input type="hidden" name="activity_id" value={activity.id} />
              <input type="hidden" name="status" value={waitlisted ? 'not_going' : 'waitlisted'} />
              <button aria-describedby="rsvp-note">
                {waitlisted ? 'Leave waitlist' : 'Join waitlist'}
              </button>
            </form>
          </>
        ) : !open ? (
          <>
            <p id="rsvp-note">
              {activity.status === 'cancelled'
                ? 'This activity is cancelled.'
                : activity.hidden_at
                  ? 'This activity is hidden.'
                  : 'This activity is over.'}
            </p>
            <button type="button" disabled aria-describedby="rsvp-note">
              {going ? '✓ Going' : "I'm in"}
            </button>
          </>
        ) : (
          <RsvpForm
            activityId={activity.id}
            status={waitlisted ? null : answer}
            guests={
              activity.guests_allowed
                ? { most: activity.max_guests_per_rsvp, mine: activity.mine[0]?.guest_count ?? 0 }
                : undefined
            }
          />
        )}
      </div>
    </>
  ) : (
    <>
      <h1>Not available</h1>
      <p>This activity isn't available. It may have been removed, or the link may be wrong.</p>
    </>
  )}
</Layout>

<script>
  import { clearDraft } from '../../../scripts/activity-draft';
  import '../../../scripts/private-details';
  import '../../../scripts/rsvp';
  import '../../../scripts/share';
  import '../../../scripts/sheets';

  // The draft from the create form is posted now (ACT-03).
  if (document.querySelector('[data-posted]')) clearDraft();
</script>

<style>
  .top,
  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .banner {
    padding: 0.75rem 1rem;
    border-left: 0.25rem solid var(--danger);
    background: var(--danger-soft);
  }
  .banner p {
    margin: 0;
  }
  .banner > :first-child {
    font-weight: 600;
  }
  /* Add to calendar, Open in Maps and Manage attendees are quiet (UI-21): words in the darker FABA
     blue at the right, still 44 px tall, underlined on hover. */
  .quiet {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 44px;
    padding: 0 0.25rem;
    color: var(--blue-dark);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    background: none;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    letter-spacing: normal;
    text-transform: none;
  }
  .quiet:hover {
    text-decoration: underline;
    background: none;
  }
  .calendars {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .calendars a {
    width: 100%;
    margin-top: 0.5rem;
  }
  .handover {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* What it's part of, under the title. */
  .meta {
    margin: 0.25rem 0 0;
  }
  .board {
    display: inline-block;
    margin: 0.5rem 0 0;
    padding: 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: 0;
  }
  .warning {
    padding: 0.5rem 0.75rem;
    border-left: 0.25rem solid var(--warning);
    background: var(--warning-soft);
  }
  /* The category as a chip with its icon, on a tint of its color (UI-05). */
  .category {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0.25rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy);
    background: color-mix(in srgb, var(--tint) 16%, var(--card));
    border-radius: 0;
  }
  /* Each fact sits right under its heading. The time and the place are bigger. */
  .big,
  .fact {
    margin: 0;
  }
  .big {
    font-size: 1.25rem;
    line-height: 1.35;
  }
  .topic .small {
    margin: 0.25rem 0 0;
  }
  /* The comment box is the page's width. */
  .comments textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 6rem;
    padding: 0.5rem 0.75rem;
    font: inherit;
    border: 1px solid var(--border);
    border-radius: 0;
  }
  /* The avatars keep a gap before their words (UI-02), and the department is under the name. */
  .host {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .department {
    display: block;
    line-height: 1.3;
  }
  .going {
    margin: 0 0 0.25rem;
    color: var(--muted);
  }
  .who h3 {
    margin: 1rem 0 0.25rem;
    font-size: 1rem;
  }
  .all {
    margin-top: 0.5rem;
  }
  .description {
    white-space: pre-line;
  }
  .series {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .series button {
    min-height: 44px;
    padding: 0 1rem;
  }
  /* Within thumb reach at the bottom of the screen, even when the page is short, so toasts sit
     above it rather than on ✓ Going. The page leaves room for it. */
  .actions {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    max-width: 40rem;
    margin: 0 auto;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
