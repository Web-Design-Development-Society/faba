---
// The reports queue (MOD-02, design document section 7.11): open reports, oldest first, each with
// what was reported, the reason and note, who reported it, and when. Only moderators and admins
// can open it, and the database checks again. Dismiss, Hide content for an activity (MOD-03), Hide
// update for an organizer's update (NOTIF-04) and Suspend member for a member (MOD-04) ask for a
// reason in a sheet, which goes to the audit log.
// Below them, upcoming activities whose organizer is no longer eligible, for a moderator to give to
// a new host or cancel on their pages (AUTH-05).
import { actions, isInputError } from 'astro:actions';
import ModerationAction from '../components/ModerationAction.astro';
import Status from '../components/Status.astro';
import Layout from '../layouts/Layout.astro';
import { excerpt } from '../lib/notifications';
import { FLASH_MESSAGES, setFlash, takeFlash } from '../lib/server/flash';
import { formatAgo, formatRange } from '../lib/time';
import { REASONS } from '../lib/validation/report';

// The most reports on the page.
const LIMIT = 50;

const { supabase, user, member } = Astro.locals;
if (!user) return Astro.redirect('/auth/login');

const dismiss = Astro.getActionResult(actions.moderation.dismiss);
if (dismiss && !dismiss.error) {
  setFlash(Astro.cookies, Astro.url, 'dismissed');
  return Astro.redirect('/mod', 303);
}
const hide = Astro.getActionResult(actions.moderation.hide);
if (hide && !hide.error) {
  setFlash(Astro.cookies, Astro.url, 'hidden');
  return Astro.redirect('/mod', 303);
}
const hideUpdate = Astro.getActionResult(actions.moderation.hideUpdate);
if (hideUpdate && !hideUpdate.error) {
  setFlash(Astro.cookies, Astro.url, 'update_hidden');
  return Astro.redirect('/mod', 303);
}
const suspend = Astro.getActionResult(actions.moderation.suspend);
if (suspend && !suspend.error) {
  setFlash(Astro.cookies, Astro.url, 'suspended');
  return Astro.redirect('/mod', 303);
}
const flash = takeFlash(Astro.cookies);
// The reason's error shows at the top, since its sheet has closed.
const failed = dismiss?.error ?? hide?.error ?? hideUpdate?.error ?? suspend?.error;
const failure = isInputError(failed) ? failed.fields.reason?.[0] : failed?.message;

const moderator =
  member?.status === 'active' && (member.role === 'moderator' || member.role === 'admin');
if (!moderator) Astro.response.status = 403;

// A deleted account has no profile to read.
const { data: reports, error } = moderator
  ? await supabase
      .from('reports')
      .select(
        `id, target_type, target_id, reason, note, created_at,
        reporter:profiles!reports_reporter_id_fkey(display_name)`
      )
      .eq('status', 'open')
      .order('created_at')
      .order('id')
      .limit(LIMIT)
  : { data: [], error: null };

// What was reported. Moderators read every activity, profile and update, so only a deleted one is
// missing. Hide content, Hide update and Suspend member need it there, and not hidden or suspended
// already.
const targets = (type: string) =>
  reports?.filter(({ target_type }) => target_type === type).map(({ target_id }) => target_id) ??
  [];
const now = new Date();
const [{ data: activities }, { data: profiles }, { data: updates }, { data: handovers }] =
  await Promise.all([
    supabase.from('activities').select('id, title, hidden_at').in('id', targets('activity')),
    supabase.from('profiles').select('id, display_name, status').in('id', targets('profile')),
    supabase
      .from('activity_updates')
      .select('id, body, hidden_at, activity:activities(id, title), group:groups(slug, name)')
      .in('id', targets('activity_update')),
    moderator
      ? supabase
          .from('activities')
          .select('id, title, starts_at, organizer:profiles!activities_organizer_id_fkey!inner()')
          .eq('organizer.status', 'ineligible')
          .eq('status', 'published')
          .gt('starts_at', now.toISOString())
          .order('starts_at')
          .limit(LIMIT)
      : { data: [] },
  ]);
const preview = (type: string, id: string) => {
  if (type === 'activity') {
    const activity = activities?.find((a) => a.id === id);
    return {
      kind: 'Activity',
      href: `/activities/${id}`,
      name: activity?.title,
      actionable: !!activity && !activity.hidden_at,
    };
  }
  if (type === 'activity_update') {
    // To an activity, or to a group (GRP-04).
    const update = updates?.find((u) => u.id === id);
    const place = update?.activity?.title ?? update?.group?.name;
    return {
      kind: place ? `Update to ${place}` : 'Update',
      href: update?.group
        ? `/groups/${update.group.slug}#updates`
        : `/activities/${update?.activity?.id}#updates`,
      name: update && excerpt(update.body),
      actionable: !!update && !update.hidden_at,
    };
  }
  const profile = profiles?.find((p) => p.id === id);
  return {
    kind: 'Member',
    href: `/people/${id}`,
    name: profile?.display_name,
    actionable: profile?.status === 'active',
  };
};
---

<Layout title="Reports">
  <a href="/me">Back to Me</a>
  <h1>Reports</h1>
  <Status message={flash && FLASH_MESSAGES[flash]} />
  {failure && <p role="alert">{failure}</p>}
  {!moderator ? (
    <p>Only moderators can see the reports queue.</p>
  ) : error ? (
    <p role="alert">The reports couldn't load. Please try again.</p>
  ) : !reports?.length ? (
    <p>No open reports. Nice.</p>
  ) : (
    <ul>
      {reports.map((report) => {
        const target = preview(report.target_type, report.target_id);
        return (
          <li>
            <article aria-labelledby={`report-${report.id}`}>
              <p class="kind">{target.kind}</p>
              <h2 id={`report-${report.id}`}>
                {target.name ? <a href={target.href}>{target.name}</a> : 'Not available'}
              </h2>
              <p>
                <strong>{REASONS[report.reason as keyof typeof REASONS] ?? report.reason}</strong>
              </p>
              {report.note && <p class="note">{report.note}</p>}
              <p class="meta">
                Reported by {report.reporter?.display_name ?? "a member who's no longer active"} ·{' '}
                <time datetime={report.created_at}>
                  {formatAgo(new Date(report.created_at), now)}
                </time>
              </p>
              <div class="actions">
                <ModerationAction
                  id={`dismiss-${report.id}`}
                  label="Dismiss"
                  title="Dismiss this report?"
                  action={actions.moderation.dismiss.queryString}
                  fields={{ report_id: report.id }}
                  confirm="Dismiss report"
                  cancel="Keep it open"
                />
                {report.target_type === 'activity' && target.actionable && (
                  <ModerationAction
                    id={`hide-${report.id}`}
                    label="Hide content"
                    title="Hide this activity?"
                    action={actions.moderation.hide.queryString}
                    fields={{ activity_id: report.target_id }}
                    confirm="Hide activity"
                    cancel="Keep it visible"
                  >
                    <p>
                      Members won't see it. Its organizer sees your reason, and can edit it. Its
                      other open reports are dealt with too.
                    </p>
                  </ModerationAction>
                )}
                {report.target_type === 'activity_update' && target.actionable && (
                  <ModerationAction
                    id={`hide-update-${report.id}`}
                    label="Hide update"
                    title="Hide this update?"
                    action={actions.moderation.hideUpdate.queryString}
                    fields={{ update_id: report.target_id }}
                    confirm="Hide update"
                    cancel="Keep it visible"
                  >
                    <p>
                      Members won't see it on the activity or in Alerts. Its author sees your
                      reason. Its other open reports are dealt with too.
                    </p>
                  </ModerationAction>
                )}
                {report.target_type === 'profile' && target.actionable && (
                  <ModerationAction
                    id={`suspend-${report.id}`}
                    label="Suspend member"
                    title="Suspend this member?"
                    action={actions.moderation.suspend.queryString}
                    fields={{ user_id: report.target_id }}
                    confirm="Yes, suspend them"
                    cancel="Don't suspend"
                  >
                    <p>
                      They can't use FABA until a moderator reinstates them. Their activities that
                      aren't over are hidden, and stay hidden after that. Their other open reports
                      are dealt with too.
                    </p>
                  </ModerationAction>
                )}
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  )}
  {!!handovers?.length && (
    <section class="handovers" aria-labelledby="handovers">
      <h2 id="handovers">Organizer no longer active</h2>
      <p>Give each one to someone going who agrees to host it, or cancel it.</p>
      <ul>
        {handovers.map((activity) => (
          <li>
            <a href={`/activities/${activity.id}`}>{activity.title}</a> ·{' '}
            <time datetime={activity.starts_at}>
              {formatRange(new Date(activity.starts_at), null)}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<script>
  import '../scripts/sheets';
</script>

<style>
  ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  article {
    padding: 0.75rem;
    border: 1px solid #767676;
    border-radius: 0.5rem;
  }
  article p,
  article h2 {
    margin: 0 0 0.25rem;
  }
  h2 {
    font-size: 1rem;
  }
  .kind,
  .meta {
    font-size: 0.875rem;
    color: #595959;
  }
  .note {
    white-space: pre-line;
  }
  .handovers {
    margin-top: 2rem;
  }
  .handovers h2 {
    font-size: 1.25rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
