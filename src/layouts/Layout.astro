---
// A plain layout for the walking skeleton (FND-10). The real layouts and styles come with
// Iteration 1 tasks AS-2 and AS-3. Every page's footer says FABA isn't an official BYU-Idaho
// channel, and links the public pages (INFO-01, ADR-016). The main screens have the bottom
// navigation (design document section 7.3): Discover, Plans, Post, Alerts and Me. Alerts shows the
// unread count (NOTIF-01), which src/scripts/unread.ts keeps current. Detail and form pages don't
// have it, so their own sticky actions keep the bottom of the screen, except New activity, which
// has it with Post as the current item (UI-06).
//
// The look is UI-14's cut paper (mockups/discover_collage.webp) with UI-16's square pieces: a plain
// light gray-blue page with its content straight on it, pieces of paper with square corners and a
// shadow, and headings in Anton, a condensed display face, in capitals. Anton is self-hosted (OFL-1.1, 18 KB for Latin) and preloaded.
import '@fontsource/anton/latin-400.css';
import anton from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import Icon from '../components/Icon.astro';
import { badge } from '../lib/notifications';

interface Props {
  title: string;
  /** The bottom navigation's current item, for the main screens. */
  tab?: 'discover' | 'plans' | 'post' | 'alerts' | 'me';
  /** Where Post goes, such as with Discover's category. */
  post?: string;
  /** New and Edit activity's warm paper (UI-25). */
  warm?: boolean;
  /** Cream paper behind the content, for a page that reads top to bottom (UI-26). */
  paper?: boolean;
}

const { title, tab, post = '/activities/new', warm = false, paper = false } = Astro.props;
const unread = Astro.locals.member?.unread_count ?? 0;
const current = (item: string) => (item === tab ? ('page' as const) : undefined);
---

<html lang="en" class:list={{ warm, paper }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Find and organize activities with BYU-Idaho faculty in Rexburg. FABA is an independent community run by the Faculty Association Board."
    />
    <meta name="theme-color" content="#f4f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f141b" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FABA" />
    <meta property="og:title" content={title === 'FABA' ? title : `${title} · FABA`} />
    <meta
      property="og:description"
      content="Find and organize activities with BYU-Idaho faculty in Rexburg. FABA is an independent community run by the Faculty Association Board."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="preload" href={anton} as="font" type="font/woff2" crossorigin />
    <title>{title === 'FABA' ? title : `${title} · FABA`}</title>
  </head>
  <body>
    {/* Skips the header and the navigation, which come before every page's content (section 7.14). */}
    <a class="skip" href="#content">
      Skip to content
    </a>
    {/* Shown while the device is offline (PWA-01, section 7.13). The script turns it on. */}
    <p class="offline" data-offline role="status" hidden>
      You're offline. We'll keep what you typed.
    </p>
    <header class="site">
      <a href="/discover" class="brand">
        <img src="/brand/faba-mark.png" alt="" width="49" height="36" />
        <span>FABA</span>
      </a>
      {/* The motto (UI-08), beside the link, so the link's name stays FABA. */}
      <p class="motto">Bringing faculty together!</p>
      {/* Search, at the strip's right on every page with the bottom bar (UI-19). */}
      {tab && (
        <a
          href="/search"
          class="site-search"
          aria-label="Search"
          aria-current={Astro.url.pathname === '/search' ? 'page' : undefined}
        >
          <Icon name="search" size={24} />
        </a>
      )}
    </header>
    <main id="content">
      <slot />
    </main>
    <footer>
      <p>
        FABA is an informal group run by the Faculty Association Board. It isn't an official
        BYU-Idaho channel.
      </p>
      <p>
        <a href="/about">About</a> · <a href="/privacy">Privacy</a> ·{' '}
        <a href="/guidelines">Guidelines</a>
      </p>
    </footer>
    {tab && (
      <nav aria-label="Main" class="tabs">
        <a href="/discover" aria-current={current('discover')}>
          {/* The FABA logo, in greyscale like the icons beside it (UI-28). The label names it. */}
          <span class="tile">
            <img class="mark" src="/brand/faba-mark.png" alt="" width="32" height="23" />
          </span>
          Discover
        </a>
        <a href="/plans" aria-current={current('plans')}>
          <span class="tile">
            <Icon name="calendar" size={24} />
          </span>
          Plans
        </a>
        <a href={post} class="post" aria-current={current('post')}>
          <span class="square">
            <Icon name="plus" size={28} />
          </span>
          Post
        </a>
        <a href="/notifications" aria-current={current('alerts')} data-alerts>
          <span class="tile">
            <Icon name="bell" size={24} />
          </span>
          Alerts
          {/* Screen readers hear "Alerts 3 unread", which keeps what's shown in the link's name. */}
          <span class="badge" data-badge hidden={!unread}>
            <span data-count>{badge(unread)}</span>
            <span class="unread"> unread</span>
          </span>
        </a>
        <a href="/me" aria-current={current('me')}>
          <span class="tile">
            <Icon name="user" size={24} />
          </span>
          Me
        </a>
      </nav>
    )}
  </body>
</html>

<script>
  import '../scripts/unread';
  import '../scripts/offline';
</script>

<style is:global>
  /* A visible focus ring on every control, in both themes (section 7.14). */
  :focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  /* The skip link is hidden until it has focus, then it appears at the top left. */
  .skip {
    position: absolute;
    left: 1rem;
    top: 0.5rem;
    z-index: 10;
    padding: 0.5rem 0.75rem;
    background: var(--navy-surface);
    color: white;
    border-radius: 0;
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
  /* For screen readers only, such as the main tabs' headings (UI-18). */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  /* People who ask for less motion get none, even where a page adds some later (section 7.14). */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* The look from the My events design (UI-01), the 2026 mockups (UI-02) and the cut-paper mockup
     (UI-14). Colors are tokens, so they change in one place. */
  :root {
    --blue: #006cc2; /* white text on it is 5.35:1, and it's 4.9:1 as text on the page (UI-29) */
    --blue-dark: #0a4fb8;
    --blue-soft: #e8f1fd;
    --navy: #0f1f3d;
    --ink: #171717;
    --muted: #4b5563; /* 6.9:1 on paper, 5.7:1 on sky */
    --line: #c9d3e0;
    --border: #767676; /* 4.5:1 on white, for controls that need 3:1 */
    --card: #ffffff;
    --paper: #f7f4ec; /* cream paper, for the footer */
    --sky: #cfe1fa; /* light blue paper: navy on it is 12:1, FABA blue 4.8:1 */
    /* The page's background: a calm, nearly white grey, with no gradient, so eyes don't tire
       (UI-29). Ink is 16.5:1 on it, link blue 6.9:1 and muted text 7.0:1. */
    --page: #f4f6f8;
    /* New and Edit activity's warm colors (UI-25). */
    --orange: #ee6d34; /* white on it is 3.1:1, enough for an icon */
    --orange-dark: #c94f1c; /* white on it is 4.6:1 */
    --orange-deep: #b8481a; /* white on it is 5.3:1, for words on orange (UI-32) */
    --paper-warm: #fff9f4; /* navy on it is 15.7:1, muted 7.2:1, field borders 4.3:1 */
    /* Anton, then a fallback sized to take about the same room, so the page doesn't jump when
       Anton arrives. */
    --display: 'Anton', 'Anton narrow fallback', 'Anton fallback', sans-serif;
    /* Paper (UI-16): each piece is a plain rectangle with square corners and a shadow. Most lie
       low; the logo strip and the footer, at the page's ends, are lifted higher. */
    --lift: 0 1px 2px rgb(15 31 61 / 14%), 0 4px 10px rgb(15 31 61 / 12%);
    --lift-high: 0 2px 4px rgb(5 20 70 / 28%), 0 12px 28px rgb(5 20 70 / 32%);
    /* Colors by their job, so the dark theme can change each in one place (UI-33). FABA blue is
       for backgrounds behind white words, borders and focus rings; blue words use --blue-text. */
    --blue-text: #006cc2; /* 4.9:1 on the page, 5.35:1 on white */
    --blue-hover: #0a4fb8; /* behind white words, on hover */
    --navy-surface: #0f1f3d; /* behind white words, such as the toast */
    --danger: #b42318; /* 6.6:1 on white */
    --danger-soft: #fef3f2;
    --warning: #b54708;
    --warning-soft: #fffaeb;
    --placeholder: #6b7280; /* 4.8:1 on white */
    --avatar: #dddddd;
    /* Fields, date pickers and scrollbars follow the theme. */
    color-scheme: light dark;
    /* Anton has one weight, so a heading asked for bold stays Anton, not a smeared copy of it. */
    font-synthesis: none;
  }
  /* Dark mode, when the device asks for it (UI-33): the same look in the dark, every pair checked
     against the same rules, text at least 4.5:1 and controls 3:1. Orange stays as it is. */
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #0f141b;
      --paper: #171d26;
      --card: #1e2631;
      --paper-warm: #221b16;
      --sky: #1c3754;
      --blue-soft: #1a2a40;
      --ink: #e7eaee; /* 12.6:1 on a card */
      --navy: #eef2f8; /* headings: 13.6:1 on a card */
      --muted: #a9b2bf; /* 7.1:1 on a card, 5.7:1 on sky */
      --line: #2e3846;
      --border: #8792a2; /* 4.8:1 on a card */
      --placeholder: #9aa4b1;
      --blue: #0a74cf; /* white on it is 4.76:1, and as a border 3.2:1 on a card */
      --blue-text: #6db3ff; /* 6.9:1 on a card, 5.5:1 on sky */
      --blue-dark: #8fc5ff; /* links: 8.4:1 on a card */
      --navy-surface: #2c3c5a; /* white on it is 11:1 */
      --danger: #ff8b7b;
      --danger-soft: #3b1f1c;
      --warning: #ffb46b;
      --warning-soft: #3a2b14;
      --avatar: #3a4452;
      --lift: 0 1px 2px rgb(0 0 0 / 50%), 0 4px 10px rgb(0 0 0 / 40%);
      --lift-high: 0 2px 4px rgb(0 0 0 / 60%), 0 12px 28px rgb(0 0 0 / 55%);
    }
  }
  /* Anton's fallbacks, sized to Anton's width (83% of Arial Narrow Bold, 68% of Arial Bold) and
     line height (ascent 1.18, descent 0.33), measured in Chromium. A phone without either uses its
     own sans-serif for the moment Anton takes to arrive. */
  @font-face {
    font-family: 'Anton narrow fallback';
    src: local('Arial Narrow Bold'), local('ArialNarrow-Bold');
    size-adjust: 83%;
    ascent-override: 142%;
    descent-override: 40%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: 'Anton fallback';
    src: local('Arial Bold'), local('Arial-BoldMT');
    size-adjust: 68%;
    ascent-override: 174%;
    descent-override: 49%;
    line-gap-override: 0%;
  }
  /* A solid, nearly white grey behind every page, with no gradient (UI-29). It replaced the blue
     gradient of UI-16, which a designer advised could tire older adults' eyes. */
  html {
    min-height: 100%;
    background: var(--page);
  }
  body {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
    color: var(--ink);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }
  /* Each page's content sits straight on the page, with no sheet, so cards and fields get the
     whole width. */
  main {
    display: block;
  }
  /* New and Edit activity are warm, to make posting feel exciting (UI-25): the form is on a piece
     of warm paper with a thin orange edge, on the same calm background as every other page (UI-29,
     UI-32). New activity's heading strip is white words on a deeper orange, at 5.3:1. */
  html.warm main {
    padding: 0.75rem;
    background: var(--paper-warm);
    border: 2px solid var(--orange);
  }
  html.warm main > h1:first-child:not(.visually-hidden) {
    color: white;
    background: var(--orange-deep);
  }
  /* An activity, a group, a member and the short forms sit on a piece of cream paper, and read top
     to bottom in roomy text, each part under a plain heading (UI-26). Muted text is 6.9:1 on it. */
  html.paper main {
    padding: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    background: var(--paper);
  }
  /* A part of such a page: room above it, and its heading in the display face, the same size for
     every part, with its action, such as Add to calendar, at the right. */
  .topic {
    margin-top: 2rem;
  }
  .topic h2 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
    line-height: 1.2;
  }
  /* The action stays on the heading's line, even on a 320 px phone, and a long heading wraps onto
     two lines instead. */
  .topic-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .topic-head h2 {
    min-width: 0;
    margin: 0;
  }
  .topic-head > :not(h2) {
    flex: none;
  }
  /* Small print, such as Updated 2d ago, stays at least 15 px. */
  .small {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  /* On paper, a form starts a little below its title, and its questions are bigger, with room
     between them. */
  html.paper main h1 + :is(form, .lead) {
    margin-top: 1.5rem;
  }
  /* A form's questions are bigger, with room between them. */
  html.paper main :where(label[for], legend) {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
  }
  html.paper main > form > :where(p, fieldset) {
    margin: 0 0 1.5rem;
  }
  /* On a narrow phone, the page's edges give back some room. */
  @media (max-width: 24rem) {
    body {
      padding-inline: 0.5rem;
    }
  }
  /* A white piece of paper, for anything that groups content. */
  .card {
    border: 1px solid transparent;
    background: var(--card);
    border-radius: 0;
    box-shadow: var(--lift);
  }
  /* The mark with the wordmark beside it, on a white strip. The words are the link's name. */
  .site {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.875rem;
    border: 1px solid transparent;
    background: var(--card);
    box-shadow: var(--lift-high);
  }
  /* Smaller than the wordmark, after a rule. On a narrow phone it wraps onto a second line beside
     it, and two lines are no taller than the logo's link. */
  .motto {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding-left: 0.75rem;
    font-family: var(--display);
    font-size: 0.9375rem;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--navy);
    border-left: 2px solid var(--navy);
  }
  /* On a narrow phone the strip is a little tighter, so the motto stays on two lines beside the
     logo and Search. */
  @media (max-width: 24rem) {
    .site {
      gap: 0.5rem;
      padding-inline: 0.625rem;
    }
    .motto {
      padding-left: 0.5rem;
      font-size: 0.8125rem;
    }
  }
  /* Search: a navy magnifying glass, 44 px square, light blue on the Search page. */
  .site-search {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -0.375rem;
    color: var(--navy);
  }
  .site-search:hover {
    background: var(--blue-soft);
  }
  .site-search[aria-current='page'] {
    background: var(--sky);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--navy);
    font-family: var(--display);
    font-size: 1.75rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .brand img {
    display: block;
    height: 2.25rem;
    width: auto;
  }
  /* Headings are in the display face, each word starting with a capital by CSS, which reads more
     easily than all capitals (UI-30), so the page keeps the words as written. */
  h1,
  h2 {
    font-family: var(--display);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: capitalize;
  }
  h1 {
    margin: 0.25rem 0 0.75rem;
    font-size: clamp(2.25rem, 9vw, 3rem);
    color: var(--navy);
  }
  h2 {
    font-size: 1.625rem;
  }
  h2,
  h3 {
    color: var(--navy);
  }
  /* A row of buttons at the right, such as Alerts' Mark all read. The main tabs' headings are for
     screen readers only, since the bottom bar shows which page it is (UI-18). */
  main > .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem 0.75rem;
  }
  /* Any other page's heading is on a white strip, tilted a little, as in the mockup (UI-14). */
  main > h1:first-child:not(.visually-hidden) {
    display: inline-block;
    padding: 0.125rem 0.75rem;
    border: 1px solid transparent;
    background: var(--card);
    box-shadow: var(--lift);
    transform: rotate(-1.5deg);
  }
  /* Two paper tabs, such as Discover's Activities | Groups: the current one FABA blue with white
     text, the other white with FABA blue text (UI-29). A tab is a link, so each half has its own
     address. */
  nav.switch {
    display: flex;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  nav.switch a {
    display: grid;
    flex: 1;
    place-items: center;
    min-height: 48px;
    padding: 0.25rem 0.5rem;
    color: var(--blue-text);
    font-family: var(--display);
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    border: 1px solid transparent;
    background: var(--card);
    box-shadow: var(--lift);
    transform: rotate(1deg);
  }
  nav.switch a:first-child {
    transform: rotate(-1.5deg);
  }
  /* Three tabs, such as Plans' Going | Organizing | Past, are a little smaller, so each fits. */
  nav.switch:has(> a:nth-child(3)) a {
    padding-inline: 0.25rem;
    font-size: 1.125rem;
  }
  nav.switch a[aria-current='page'] {
    color: white;
    background: var(--blue);
  }
  /* The darker FABA blue, since a link can sit straight on the page: 6.9:1 on it. */
  a {
    color: var(--blue-dark);
  }
  /* A form's main action: FABA blue, as tall as a field, with modest padding (UI-12). Every button
     is square, in the display face in capitals, like the paper tabs (UI-22). Rows and quiet words
     that are buttons, such as an alert's card, set their own font. */
  button {
    min-height: 44px;
    padding: 0 1.25rem;
    color: white;
    font: inherit;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    background: var(--blue);
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }
  button:hover {
    background: var(--blue-hover);
  }
  /* The other actions, outlined, and a link that stands on its own looks the same: it still goes
     somewhere, so it stays a link to screen readers (UI-12). Red is for what removes or deletes. */
  button.secondary,
  button.danger,
  a.button,
  summary.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    box-sizing: border-box;
    min-height: 44px;
    padding: 0 1.25rem;
    color: var(--navy);
    font: inherit;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0;
    cursor: pointer;
  }
  summary.button {
    list-style: none;
  }
  summary.button::-webkit-details-marker {
    display: none;
  }
  button.secondary:hover,
  a.button:hover,
  summary.button:hover {
    background: var(--card);
    border-color: var(--blue);
  }
  button.danger,
  a.button.danger {
    color: var(--danger);
    border-color: var(--danger);
  }
  button.danger:hover,
  a.button.danger:hover {
    background: var(--danger-soft);
  }
  a.button.primary {
    color: white;
    background: var(--blue);
    border-color: var(--blue);
  }
  a.button.primary:hover {
    background: var(--blue-hover);
  }
  /* A form's buttons: Cancel and the main action side by side, the main one wider (UI-06). */
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .form-actions > * {
    flex: 1;
    min-height: 48px;
  }
  .form-actions > button:not(.secondary, .danger) {
    flex: 1.6;
  }

  /* Forms made for phones (UI-12), in one place, at the lowest priority (:where), so a page's own
     style still wins where it needs something else. A field is the form's width, 48 px tall, with
     16 px text, so iOS doesn't zoom in, and a border at 4.5:1. */
  :where(
    input:not(
      [type='checkbox'],
      [type='radio'],
      [type='file'],
      [type='hidden'],
      [type='range'],
      [type='color'],
      [type='submit'],
      [type='button'],
      [type='image'],
      [type='reset']
    ),
    select,
    textarea
  ) {
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: 0.5rem 0.75rem;
    font: inherit;
