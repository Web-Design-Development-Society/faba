---
// A plain layout for the walking skeleton (FND-10). The real layouts and styles come with
// Iteration 1 tasks AS-2 and AS-3. Every page's footer says FABA isn't an official BYU-Idaho
// channel, and links the public pages (INFO-01, ADR-016). The main screens have the bottom
// navigation (design document section 7.3): Discover, Plans, Post, Alerts and Me. Alerts shows the
// unread count (NOTIF-01), which src/scripts/unread.ts keeps current. Detail and form pages don't
// have it, so their own sticky actions keep the bottom of the screen.
import Icon from '../components/Icon.astro';
import { badge } from '../lib/notifications';

interface Props {
  title: string;
  /** The bottom navigation's current item, for the main screens. */
  tab?: 'discover' | 'plans' | 'alerts' | 'me';
  /** Where Post goes, such as with Discover's category. */
  post?: string;
}

const { title, tab, post = '/activities/new' } = Astro.props;
const unread = Astro.locals.member?.unread_count ?? 0;
const current = (item: string) => (item === tab ? ('page' as const) : undefined);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f4f7fb" />
    <title>{title === 'FABA' ? title : `${title} · FABA`}</title>
  </head>
  <body>
    {/* Skips the header and the navigation, which come before every page's content (section 7.14). */}
    <a class="skip" href="#content">
      Skip to content
    </a>
    {/* Shown while the device is offline (PWA-01, section 7.13). The script turns it on. */}
    <p class="offline" data-offline role="status" hidden>
      You're offline. We'll keep what you typed.
    </p>
    <header class="site">
      <a href="/discover" class="brand">
        <img src="/brand/faba-mark.png" alt="" width="49" height="36" />
        <span>FABA</span>
      </a>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer>
      <p>
        FABA is an informal group run by the Faculty Association Board. It isn't an official
        BYU-Idaho channel.
      </p>
      <p>
        <a href="/about">About</a> · <a href="/privacy">Privacy</a> ·{' '}
        <a href="/guidelines">Guidelines</a>
      </p>
    </footer>
    {tab && (
      <nav aria-label="Main" class="tabs">
        <a href="/discover" aria-current={current('discover')}>
          <Icon name="home" size={24} />
          Discover
        </a>
        <a href="/plans" aria-current={current('plans')}>
          <Icon name="calendar" size={24} />
          Plans
        </a>
        <a href={post} class="post">
          <span class="circle">
            <Icon name="plus" size={28} />
          </span>
          Post
        </a>
        <a href="/notifications" aria-current={current('alerts')} data-alerts>
          <Icon name="bell" size={24} />
          Alerts
          {/* Screen readers hear "Alerts 3 unread", which keeps what's shown in the link's name. */}
          <span class="badge" data-badge hidden={!unread}>
            <span data-count>{badge(unread)}</span>
            <span class="unread"> unread</span>
          </span>
        </a>
        <a href="/me" aria-current={current('me')}>
          <Icon name="user" size={24} />
          Me
        </a>
      </nav>
    )}
  </body>
</html>

<script>
  import '../scripts/unread';
  import '../scripts/offline';
</script>

<style is:global>
  /* A visible focus ring on every control, in both themes (section 7.14). */
  :focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  /* The skip link is hidden until it has focus, then it appears at the top left. */
  .skip {
    position: absolute;
    left: 1rem;
    top: 0.5rem;
    z-index: 10;
    padding: 0.5rem 0.75rem;
    background: var(--blue);
    color: #fff;
    border-radius: var(--radius);
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }

  /* People who ask for less motion get none, even where a page adds some later (section 7.14). */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* The look from the My events design (UI-01) and the 2026 mockups (UI-02). Colors are tokens,
     so they change in one place. Selected things are FABA blue, never black. */
  :root {
    --blue: #0b5bd3; /* white text on it is 6.4:1 */
    --blue-dark: #0a4fb8;
    --blue-soft: #e8f1fd;
    --navy: #0f1f3d;
    --ink: #171717;
    --muted: #4b5563; /* 7.5:1 on white, 7:1 on the page */
    --line: #c9d3e0;
    --border: #767676; /* 4.5:1 on white, for controls that need 3:1 */
    --page: #f4f7fb; /* the soft blue-gray the cards sit on */
    --card: #ffffff;
    --shadow: 0 1px 2px rgb(15 31 61 / 6%), 0 2px 8px rgb(15 31 61 / 6%);
    --radius: 0.625rem;
  }
  body {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
    color: var(--ink);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    background: var(--page);
  }
  /* A white card on the page, for anything that groups content. */
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  /* The mark with the wordmark beside it. The words are the link's name. */
  .site {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--navy);
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .brand img {
    display: block;
    height: 2.25rem;
    width: auto;
  }
  h1 {
    color: var(--navy);
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  h2,
  h3 {
    color: var(--navy);
  }
  a {
    color: var(--blue);
  }
  button {
    min-height: 44px;
    padding: 0 1rem;
    color: white;
    font: inherit;
    font-weight: 600;
    background: var(--blue);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }
  button:hover {
    background: var(--blue-dark);
  }
  footer {
    margin-top: 3rem;
    padding-top: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }
  footer a {
    display: inline-block;
    padding: 0.75rem 0;
  }
  /* In thumb reach at the bottom of the screen (section 7.16), above the cards' I'm in buttons,
     which sit above their links. The page leaves room for it. */
  body:has(> .tabs) {
    padding-bottom: calc(6rem + env(safe-area-inset-bottom));
  }
  /* Five items, each an icon over its label (section 7.3, UI-02). The current one is blue, bolder
     and underlined, so it isn't shown by color alone. */
  .tabs {
    position: fixed;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    max-width: 40rem;
    margin: 0 auto;
    padding: 0.25rem 0.25rem calc(0.25rem + env(safe-area-inset-bottom));
    background: var(--card);
    border-top: 1px solid var(--border);
  }
  .tabs a {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    min-width: 0;
    min-height: 56px;
    padding-bottom: 0.25rem;
    color: var(--navy);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .tabs [aria-current] {
    font-weight: 700;
    color: var(--blue);
  }
  .tabs [aria-current]::after {
    position: absolute;
    right: 22%;
    bottom: 0;
    left: 22%;
    height: 3px;
    content: '';
    background: currentColor;
    border-radius: 2px;
  }
  .tabs .badge {
    position: absolute;
    top: 0;
    left: calc(50% + 0.5rem);
    min-width: 1.25rem;
    padding: 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25rem;
    color: white;
    text-align: center;
    background: #b42318;
    border-radius: 999px;
  }
  /* Heard, not seen. */
  .tabs .unread {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .offline {
    margin: 0 0 1rem;
    padding: 0.5rem 0.75rem;
    color: #171717;
    background: #fef3c7;
    border-radius: 0.5rem;
  }
  /* The one filled button in the bar: a blue circle that rises above it, with "Post" under it. */
  .tabs .post {
    font-weight: 600;
  }
  .tabs .post .circle {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-top: -1.5rem;
    color: white;
    background: var(--blue);
    border: 3px solid var(--card);
    border-radius: 50%;
    box-shadow: 0 2px 6px rgb(11 91 211 / 35%);
  }
  .tabs .post:hover .circle {
    background: var(--blue-dark);
  }
</style>
