---
// The filters on Discover and Search (ACT-06, SRCH-02, design document section 7.10): just two
// buttons, Category and Date (UI-09). Each names what's chosen, such as "Category: Outdoors" or
// "Date: This weekend", and opens a panel that drops down under them. They're disclosures
// (<details>), so they open without JavaScript, and with it they close with Escape or a tap
// elsewhere, and opening one closes the other.
//
// Category's panel has a chip for each category. Date's has Any time, Today, This week and This
// weekend, then Pick dates with From and To. The choices are links, and Pick dates is a GET form,
// so a filter can be shared. A date keeps the category, and a category keeps the dates, as in
// /discover?when=weekend&cat=outdoors. On Search they keep the words too. Clear filters shows
// whenever a filter is on, and what the page puts in the slot, such as Discover's Follow button for
// the chosen category, comes after it.
//
// On Search before searching (`browse`), the categories show as chips to browse instead.
//
// On Discover (`collapsible`), the row is hidden behind a Filters button, at the right on the line
// of the first day's heading, until the member wants it (UI-36). Shown, Category and Date are on
// the first line with Filters at its right, and Clear filters and Follow on the next. It starts
// shown when a filter is on, so the member sees what the feed is filtered by. Without JavaScript
// it's always shown, with no button.
import { isIcon } from '../lib/icons';
import { formatDay, WHENS, type When } from '../lib/time';
import Icon from './Icon.astro';

interface Props {
  categories: { id: string; name: string; icon?: string }[];
  /** The page the filters filter, such as /discover. */
  page: string;
  /** The page's query, whose filters these change. */
  query: URLSearchParams;
  /** The dates that are on, as readDates() read them. */
  dates?: { when?: When; from?: string; to?: string };
  /** True for links to Discover's categories, as on Search before searching. */
  browse?: boolean;
  /** True to hide the row behind a Filters button until a filter is on (UI-36). */
  collapsible?: boolean;
}

const { categories, page, query, dates = {}, browse, collapsible } = Astro.props;
const now = new Date();
const cat = query.get('cat');
const chosenCategory = categories.find(({ id }) => id === cat);

// The page with `changes`, starting again from its first page.
const link = (changes: Record<string, string | null>) => {
  const next = new URLSearchParams(query);
  for (const name of ['after', 'id', 'spots', 'tag', ...Object.keys(changes)]) next.delete(name);
  for (const [name, value] of Object.entries(changes)) if (value) next.set(name, value);
  return next.size ? `${page}?${next}` : page;
};
const kinds = categories.map(({ id, name, icon }) => ({
  name,
  icon: icon && isIcon(icon) ? icon : undefined,
  chosen: !browse && cat === id,
  href: browse ? `/discover?cat=${encodeURIComponent(id)}` : link({ cat: cat === id ? null : id }),
}));

const picked = !!(dates.from || dates.to);
const anyTime = !dates.when && !picked;
const whens = [
  {
    name: 'Any time',
    chosen: anyTime,
    href: link({ when: null, from: null, to: null }),
  },
  ...Object.entries(WHENS).map(([id, name]) => ({
    name,
    chosen: dates.when === id,
    href: link({ when: id, from: null, to: null }),
  })),
];
const dateLabel = dates.when
  ? WHENS[dates.when]
  : dates.from && dates.to
    ? dates.from === dates.to
      ? formatDay(dates.from, now)
      : `${formatDay(dates.from, now)} to ${formatDay(dates.to, now)}`
    : dates.from
      ? `From ${formatDay(dates.from, now)}`
      : dates.to
        ? `Until ${formatDay(dates.to, now)}`
        : null;
// Dates in the link that readDates() couldn't use, such as an end before the start.
const wrong = !picked && (query.get('from') || query.get('to'));
// Pick dates keeps the page's other filters and words.
const kept = [...query].filter(
  ([name]) => !['from', 'to', 'when', 'after', 'id', 'spots', 'tag'].includes(name)
);
// Every filter off, keeping only the search words.
const words = new URLSearchParams([...query].filter(([name]) => ['q', 'past'].includes(name)));
const clear = words.size ? `${page}?${words}` : page;
const on = !!chosenCategory || !anyTime;
const shown = on || !!wrong;
---

{browse ? (
  <nav aria-label="Categories">
    <ul class="chips">
      {kinds.map(({ name, icon, href }) => (
        <li>
          <a href={href}>
            {icon && <Icon name={icon} />}
            {name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
) : (
  <>
    {wrong && (
      <p role="alert" class="wrong">
        Those dates don't work together. Pick a start on or before the end.
      </p>
    )}
    <nav aria-label="Filters" class:list={['filters', { collapsible, shown }]}>
      {collapsible && (
        <button
          type="button"
          class="toggle"
          aria-expanded={shown ? 'true' : 'false'}
          aria-controls="filter-tools"
          data-filters-toggle
        >
          Filters
        </button>
      )}
      <div class="tools" id="filter-tools">
        <div class="menus">
          {kinds.length > 0 && (
            <details class="menu" data-menu>
              <summary class:list={{ on: !!chosenCategory }}>
                {chosenCategory ? `Category: ${chosenCategory.name}` : 'Category'}
              </summary>
              <ul class="chips panel">
                {kinds.map(({ name, icon, chosen, href }) => (
                  <li>
                    <a href={href} aria-current={chosen ? 'page' : undefined}>
                      {icon && !chosen && <Icon name={icon} />}
                      {name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <details class="menu" data-menu>
            <summary class:list={{ on: !anyTime }}>
              {dateLabel ? `Date: ${dateLabel}` : 'Date'}
            </summary>
            <div class="panel">
              <ul class="whens">
                {whens.map(({ name, chosen, href }) => (
                  <li>
                    <a href={href} aria-current={chosen ? 'page' : undefined}>
                      {name}
                    </a>
                  </li>
                ))}
              </ul>
              <form method="get" action={page} class="pick" data-pick-dates>
                {kept.map(([name, value]) => (
                  <input type="hidden" name={name} value={value} />
                ))}
                <fieldset>
                  <legend>Pick dates</legend>
                  <p>
                    <label for="filter-from">From</label>
                    <input id="filter-from" type="date" name="from" value={dates.from} />
                  </p>
                  <p>
                    <label for="filter-to">To</label>
                    <input id="filter-to" type="date" name="to" value={dates.to} />
                  </p>
                </fieldset>
                <button>Show activities</button>
              </form>
            </div>
          </details>
        </div>
        {on && (
          <div class="more">
            <a href={clear} class="clear button">
              Clear filters
            </a>
            <slot />
          </div>
        )}
      </div>
    </nav>
  </>
)}

<script>
  // A panel closes with Escape, or a tap anywhere else, as a menu does, and opening one closes the
  // other.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details[data-menu]')];
  document.addEventListener('click', ({ target }) => {
    for (const menu of menus) if (menu.open && !menu.contains(target as Node)) menu.open = false;
  });
  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  }
  // Filters shows or hides Discover's row (UI-36). Hiding it closes an open panel.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-filters-toggle]')) {
    toggle.addEventListener('click', () => {
      const shown = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(shown));
      toggle.closest('.filters')?.classList.toggle('shown', shown);
      if (!shown) for (const menu of menus) menu.open = false;
    });
  }
  // Dates left empty stay out of the link. Without JavaScript they're in it, and readDates()
  // ignores them.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-pick-dates]')) {
    form.addEventListener('formdata', ({ formData }) => {
      for (const name of ['from', 'to']) if (!formData.get(name)) formData.delete(name);
    });
  }
</script>

<style>
  /* The panels drop down from the filters, the whole width of the page. */
  .filters {
    position: relative;
    margin-top: 0.75rem;
  }
  .wrong {
    margin: 0.75rem 0 0;
  }
  .wrong + .filters {
    margin-top: 0.5rem;
  }
  /* Category, Date, Clear filters and Follow, in one row that wraps on a narrow phone. Beside
     Discover's Filters button, it wraps in the room left of it. */
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .menus,
  .more {
    display: contents;
  }
  /* Discover's Filters (UI-36): quiet words in the display face, with a caret before them, at the
     right. It's there only with JavaScript, which hides the row until it's tapped. Hidden, the row
     takes no room, so Filters sits on the line of the first day's heading, and what comes next
     wraps around it. */
  .toggle {
    display: none;
  }
  :global(html[data-js]) .toggle {
    display: inline-flex;
    float: right;
    align-items: center;
    gap: 0.375rem;
    min-width: 44px;
    min-height: 48px;
    margin: 0 0 0 0.5rem;
    padding: 0 0 0 0.25rem;
    color: var(--navy);
    font-size: 1.0625rem;
    letter-spacing: 0.04em;
    background: none;
  }
  /* As tall as Category and Date, and level with the day's heading while they're hidden. */
  :global(html[data-js]) .filters:not(.shown) .toggle {
    margin-top: -0.25rem;
  }
  .toggle:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
    background: none;
  }
  /* The caret points left while the row is hidden, and down once it's shown, as Category's turns. */
  .toggle::before {
    width: 0.5rem;
    height: 0.5rem;
    content: '';
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(135deg);
  }
  .shown .toggle::before {
    margin-top: -0.25rem;
    transform: rotate(45deg);
  }
  :global(html[data-js]) .collapsible:not(.shown) .tools {
    display: none;
  }
  /* Shown: Category and Date on the first line, with Filters at its right, and Clear filters and
     Follow on the next, the whole width. */
  :global(html[data-js]) .collapsible.shown {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: start;
  }
  :global(html[data-js]) .collapsible.shown .tools {
    display: contents;
  }
  :global(html[data-js]) .collapsible.shown .menus,
  :global(html[data-js]) .collapsible.shown .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  :global(html[data-js]) .collapsible.shown .menus {
    grid-area: 1 / 1;
  }
  :global(html[data-js]) .collapsible.shown .toggle {
    grid-area: 1 / 2;
    margin: 0;
  }
  :global(html[data-js]) .collapsible.shown .more {
    grid-area: 2 / 1 / 3 / 3;
  }
  /* Bordered boxes with a caret, their labels in the display face, as in the mockup (UI-14). */
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0 1rem;
    color: var(--navy);
    font-family: var(--display);
    font-size: 1.0625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    list-style: none;
    background: var(--card);
    border: 2px solid var(--navy);
    border-radius: 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* A caret that turns when the panel is open. */
  summary::after {
    width: 0.5rem;
    height: 0.5rem;
    margin: -0.25rem 0 0 0.25rem;
    content: '';
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }
  .menu[open] summary::after {
    margin-top: 0.25rem;
    transform: rotate(-135deg);
  }
  /* What's chosen is FABA blue, and its name is in the button, so it isn't color alone. */
  summary.on {
    color: var(--blue-text);
    border-color: var(--blue);
  }
  summary:hover {
    border-color: var(--blue);
  }
  /* The panels drop down under the row, over the feed's cards and their buttons, as a menu
     would, and under the bottom bar, which comes later in the page. */
  .panel {
    position: absolute;
    z-index: 2;
    top: calc(100% + 0.5rem);
    right: 0;
    left: 0;
    padding: 0.75rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0;
    box-shadow: 0 8px 24px rgb(15 31 61 / 18%);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0 1rem;
    color: var(--navy);
    white-space: nowrap;
    text-decoration: none;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0;
  }
  /* Category's panel is a list of chips too, so it keeps the panel's padding, as Date's does. */
  .chips.panel {
    padding: 0.75rem;
  }
  .chips :global(.icon) {
    color: var(--blue-text);
  }
  /* FABA blue with a check (UI-02), so it isn't shown by color alone. */
  .chips [aria-current],
  .whens [aria-current] {
    font-weight: 600;
    color: white;
    background: var(--blue);
    border-color: var(--blue);
  }
  .chips [aria-current]::before,
  .whens [aria-current]::before {
    content: '✓' / '';
  }
  /* The dates are a short list, one to a line. */
  .whens {
    display: grid;
    gap: 0.25rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  .whens a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.75rem;
    color: var(--navy);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 0;
  }
  .whens a:hover {
    border-color: var(--blue);
  }
  .pick fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 0 0 0.75rem;
    padding: 0.75rem 0 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  .pick legend {
    float: left;
    width: 100%;
    margin-bottom: 0.25rem;
    padding: 0;
    font-weight: 600;
    color: var(--navy);
  }
  .pick p {
    display: grid;
    flex: 1;
    gap: 0.25rem;
    min-width: 8rem;
    margin: 0;
  }
  .pick input {
    min-height: 44px;
    padding: 0 0.5rem;
    font: inherit;
    border: 1px solid var(--border);
    border-radius: 0;
  }
  .pick button {
    width: 100%;
  }
</style>
