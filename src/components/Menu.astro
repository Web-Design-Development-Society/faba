---
// The ⋯ menu at the top of a page, for what's needed less often, such as Share and Report (ACT-02,
// PROF-03). Each item is an li with a link, or with a form for an action such as Mute updates.
---

<details class="menu">
  <summary aria-label="More actions">⋯</summary>
  <ul>
    <slot />
  </ul>
</details>

<style>
  .menu {
    position: relative;
  }
  summary {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  ul {
    position: absolute;
    right: 0;
    z-index: 1;
    margin: 0;
    padding: 0.5rem 1rem;
    list-style: none;
    background: white;
    border: 1px solid #767676;
  }
  ul :global(a) {
    display: block;
    padding: 0.5rem 0;
  }
  /* An action, such as Mute updates, looks like the links around it. */
  ul :global(button) {
    display: block;
    padding: 0.5rem 0;
    font: inherit;
    color: LinkText;
    text-align: start;
    text-decoration: underline;
    white-space: nowrap;
    cursor: pointer;
    background: none;
    border: 0;
  }
</style>
