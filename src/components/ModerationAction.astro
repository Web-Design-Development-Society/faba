---
// A moderator's action, such as Dismiss or Hide content (MOD-02, MOD-03): a button that opens a
// sheet asking why, which posts to the Action. The reason goes to the audit log (FR-MOD-1). It
// works without JavaScript. Anything in the slot explains the action above the reason, and the
// `fields` slot adds fields to the form, such as a choice.
import { MODERATION_REASON_MAX, REASON_TEMPLATES } from '../lib/validation/moderation';
import Sheet from './Sheet.astro';

interface Props {
  /** Unique on the page, such as `hide-<report id>`. */
  id: string;
  /** The button that opens the sheet. */
  label: string;
  /** The sheet's question. */
  title: string;
  /** The Action's query string. */
  action: string;
  /** The form's other fields, such as the report's id. */
  fields: Record<string, string>;
  /** The button that does it. */
  confirm: string;
  /** The button that closes the sheet. */
  cancel: string;
  /** Offer the common reasons (MOD-08). The reason is still needed, typed or picked. */
  templates?: boolean;
}

const { id, label, title, action, fields, confirm, cancel, templates } = Astro.props;
---

<button type="button" commandfor={id} command="show-modal">
  {label}
</button>
<Sheet id={id} title={title}>
  <slot />
  <form method="post" action={action}>
    {Object.entries(fields).map(([name, value]) => (
      <input type="hidden" name={name} value={value} />
    ))}
    <slot name="fields" />
    {templates && (
      <p>
        <label for={`${id}-template`}>Common reason</label>
        <br />
        <select id={`${id}-template`} name="template">
          <option value="">Pick one, or write your own below</option>
          {Object.entries(REASON_TEMPLATES).map(([value, label]) => (
            <option value={value}>{label}</option>
          ))}
        </select>
      </p>
    )}
    <p>
      <label for={`${id}-reason`}>Reason, for the audit log</label>
      <br />
      <textarea
        id={`${id}-reason`}
        name="reason"
        rows="2"
        required={!templates}
        maxlength={MODERATION_REASON_MAX}
      ></textarea>
    </p>
    <button type="submit">{confirm}</button>
  </form>
  <form method="dialog">
    <button>{cancel}</button>
  </form>
</Sheet>

<style>
  button {
    min-height: 44px;
    padding: 0 1rem;
  }
</style>
