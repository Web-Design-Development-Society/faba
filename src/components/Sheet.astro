---
// A bottom sheet (design document section 7.8), a <dialog> with a heading. A button opens it with
// commandfor and command="show-modal", which works without JavaScript. src/scripts/sheets.ts
// covers browsers without invoker commands. Escape or a tap outside it closes it.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<dialog id={id} aria-labelledby={`${id}-title`} closedby="any">
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</dialog>

<style>
  /* At the bottom of a phone's screen, and in the middle of a bigger one (section 7.16). */
  dialog {
    width: 100%;
    max-width: 100%;
    max-height: 80vh;
    margin: auto auto 0;
    padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom));
    border: 0;
    border-radius: 1rem 1rem 0 0;
  }
  @media (min-width: 640px) {
    dialog {
      width: 24rem;
      margin: auto;
      border-radius: 1rem;
    }
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }
</style>
