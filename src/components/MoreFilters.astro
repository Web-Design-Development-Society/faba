---
// More filters (SRCH-02, SRCH-03, design document section 7.10): a sheet with a custom date range,
// Has spots left and the curated tags. It's a GET form, so it works without JavaScript, and it
// keeps the page's chips and words. Dates replace a date chip. The button counts the filters it
// holds that are on, and Clear all, always in the sheet, takes every filter off. It sits beside
// Category, outlined like it (UI-04), in FilterChips' row.
import Sheet from './Sheet.astro';

interface Props {
  /** The page the form filters, such as /discover. */
  page: string;
  query: URLSearchParams;
  /** The dates that are on, as readDates() read them. */
  dates: { from?: string; to?: string };
  /** Has spots left and the tags that are on, as readMore() read them, and the tags offered. */
  more: { spots: boolean; tags: string[] };
  tags: { id: string; name: string }[];
}

const { page, query, dates, more, tags } = Astro.props;
const on = (dates.from || dates.to ? 1 : 0) + (more.spots ? 1 : 0) + more.tags.length;
const mine = ['from', 'to', 'when', 'spots', 'tag', 'after', 'id'];
const kept = [...query].filter(([name]) => !mine.includes(name));
// Dates in the link that readDates() couldn't use, such as an end before the start.
const wrong = !dates.from && !dates.to && (query.get('from') || query.get('to'));
// Every filter off, keeping only the search words.
const clear = new URLSearchParams([...query].filter(([name]) => ['q', 'past'].includes(name)));
---

{wrong && <p role="alert">Those dates don't work together. Pick a start on or before the end.</p>}
<button type="button" class="tool" commandfor="more-filters" command="show-modal">
  {on ? `More filters (${on})` : 'More filters'}
</button>
<Sheet id="more-filters" title="More filters">
  <form method="get" action={page} data-more-filters>
    {kept.map(([name, value]) => (
      <input type="hidden" name={name} value={value} />
    ))}
    <fieldset>
      <legend>Dates</legend>
      <p>
        <label for="filter-from">From</label>
        <br />
        <input id="filter-from" type="date" name="from" value={dates.from} />
      </p>
      <p>
        <label for="filter-to">To</label>
        <br />
        <input id="filter-to" type="date" name="to" value={dates.to} />
      </p>
    </fieldset>
    <fieldset>
      <legend>Spots</legend>
      <label>
        <input type="checkbox" name="spots" value="1" checked={more.spots} />
        Has spots left
      </label>
    </fieldset>
    {tags.length > 0 && (
      <fieldset>
        <legend>Tags</legend>
        {tags.map(({ id, name }) => (
          <label>
            <input type="checkbox" name="tag" value={id} checked={more.tags.includes(id)} />
            {name}
          </label>
        ))}
      </fieldset>
    )}
    <button>Apply</button>
  </form>
  <a href={clear.size ? `${page}?${clear}` : page}>Clear all</a>
</Sheet>

<script>
  // Dates left empty stay out of the link. Without JavaScript they're in it, and readDates()
  // ignores them.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-more-filters]')) {
    form.addEventListener('formdata', ({ formData }) => {
      for (const name of ['from', 'to']) if (!formData.get(name)) formData.delete(name);
    });
  }
</script>

<style>
  button,
  a,
  input {
    min-height: 44px;
  }
  button {
    padding: 0 1rem;
  }
  a {
    display: inline-grid;
    align-items: center;
  }
  fieldset {
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }
  legend {
    font-weight: 600;
  }
  fieldset label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
  }
</style>
