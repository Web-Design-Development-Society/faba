---
// An activity in the feed (ACT-01, design document section 7.5) and in Plans (RSVP-08). The whole
// card opens the activity, except I'm in and ✓ Going (RSVP-01, RSVP-02). A cancelled activity says
// so in their place (ACT-05), and a full one says Full to anyone not going (RSVP-04), or On waitlist (RSVP-07). In Plans,
// badges say when an upcoming one has changed time or place, is full, or is hidden. Every card
// says when it's a FABA board activity (MOD-07), unless it's cancelled or full, which say so in
// its place: a card has one status at most (design document section 7.5). On Home, one that someone
// else posted since the member's previous visit says New, after all those (ACT-11). A date in a
// series says how often it repeats, beside its time (REC-01). The layout is UI-03's: the date,
// the cover's small copy or the category's icon, the title, then rows for the time and place, and
// who's going with I'm in along the bottom, so a phone never squeezes the time into a narrow column.
import { categoryLook } from '../lib/categories';
import { historyLabel, isFull } from '../lib/cards';
import { repeatsBadge } from '../lib/series';
import { formatSoon, isOver } from '../lib/time';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import RsvpForm from './RsvpForm.astro';

interface Props {
  activity: {
    id: string;
    title: string;
    starts_at: string;
    ends_at: string | null;
    location_name: string;
    going_count: number;
    guest_total: number;
    hidden_at: string | null;
    time_or_place_changed_at: string | null;
    capacity: number | null;
    organizer_id: string | null;
    status: string;
    is_board_activity: boolean;
    created_at: string;
    category: { name: string; icon: string; color_token: string } | null;
    /** The series it's a date in (REC-01). */
    series: { freq: string } | null;
    /** Its cover picture (MEDIA-01), shown small (UI-03). */
    cover?: { id: string; hidden_at: string | null } | null;
    going: {
      member: {
        id: string;
        display_name: string;
        avatar_url: string | null;
        use_initials: boolean;
      };
    }[];
    /** The signed-in member's RSVP. */
    my_rsvp: string | null;
  };
  /** The signed-in member's id. */
  viewer: string;
  now: Date;
  /** The most faces in the going row. */
  faces: number;
  /** True for Plans' status badges. */
  badges?: boolean;
  /** True for a past activity, which says "Went" or "Organized" for the viewer (HIST-01). */
  history?: boolean;
  /** On Home, when the member's previous visit ended, so newer activities say New (ACT-11). */
  newSince?: Date | null;
  /** True for Discover's Your next plan, which has a blue edge (UI-03). */
  next?: boolean;
}

const { activity, viewer, now, faces, badges, history, newSince, next } = Astro.props;
const { category } = activity;
// The date badge (UI-01) shows the day in Rexburg's time, the same as the time line beside it.
const starts = new Date(activity.starts_at);
const month = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'America/Boise' })
  .format(starts)
  .toUpperCase();
const day = new Intl.DateTimeFormat('en-US', { day: 'numeric', timeZone: 'America/Boise' }).format(
  starts
);
const look = category && categoryLook(category);
const cover = activity.cover && !activity.cover.hidden_at ? activity.cover : null;
const hosting = activity.organizer_id === viewer;
const going = activity.my_rsvp === 'going';
const cancelled = activity.status === 'cancelled';
// Cards aren't hidden, so a published one takes RSVPs until it's over.
const open =
  !cancelled &&
  !isOver(new Date(activity.starts_at), activity.ends_at ? new Date(activity.ends_at) : null, now);
const full = isFull(activity);
const board = activity.is_board_activity && !cancelled && !(open && full) && 'Board activity';
const fresh =
  !!newSince &&
  !hosting &&
  !cancelled &&
  !(open && full) &&
  new Date(activity.created_at) > newSince &&
  'New';
const past = history ? historyLabel({ ...activity, viewer }) : null;
const shown = (
  past
    ? [past]
    : badges
      ? [
          open && activity.time_or_place_changed_at && 'Changed',
          open && full && 'Full',
          board,
          activity.hidden_at && 'Hidden',
        ]
      : [board || fresh]
).filter((badge) => !!badge);
---

<article class:list={['card', { next }]} style={look ? `--stripe: ${look.color}` : undefined}>
  <div class="layout">
    <p class="date" aria-hidden="true">
      <span class="month">{month}</span>
      <span class="day">{day}</span>
    </p>
    {(cover || look) && (
      <span
        class="picture"
        role={category ? 'img' : undefined}
        aria-label={category?.name}
        style={look ? undefined : '--stripe: #616161'}
      >
        {cover ? (
          <img
            src={`/api/media/${cover.id}?size=thumb`}
            alt=""
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
          />
        ) : (
          look && <Icon name={look.icon} size={24} />
        )}
      </span>
    )}
    <h3>
      <a href={`/activities/${activity.id}`}>{activity.title}</a>
    </h3>
    <span class="chevron">
      <Icon name="chevron" />
    </span>
    <div class="rows">
      <p class="when">
        <Icon name="calendar" />
        <span>
          <time datetime={activity.starts_at}>{formatSoon(new Date(activity.starts_at), now)}</time>
          {activity.series && ` · ${repeatsBadge(activity.series.freq)}`}
        </span>
      </p>
      <p class="place">
        <Icon name="pin" />
        <span>{activity.location_name}</span>
      </p>
      {shown.length > 0 && (
        <ul class="badges">
          {shown.map((badge) => (
            <li>{badge}</li>
          ))}
        </ul>
      )}
    </div>
    <div class="foot">
      <p class="going" data-going={activity.id} data-faces={faces}>
        {activity.going.length === 0 && <Icon name="people" />}
        {activity.going.map(({ member }) => (
          <Avatar member={member} named mine={member.id === viewer} />
        ))}
        <span data-count>{activity.going_count}</span> going
      </p>
      {cancelled ? (
        <p class="mine cancelled">Cancelled</p>
      ) : hosting ? (
        <p class="mine">You're hosting</p>
      ) : open && full && !going && activity.my_rsvp !== 'maybe' ? (
        <p class="mine">{activity.my_rsvp === 'waitlisted' ? 'On waitlist' : 'Full'}</p>
      ) : open ? (
        // Someone waiting when a spot is open says I'm in like anyone else (RSVP-07).
        <RsvpForm
          activityId={activity.id}
          status={activity.my_rsvp === 'waitlisted' ? null : activity.my_rsvp}
        />
      ) : (
        going && <p class="mine going-pill">✓ Going</p>
      )}
    </div>
  </div>
</article>

<style>
  /* A white card with its category's color down the left edge (UI-01, UI-02). Its own width
     decides the layout, so a card is laid out for the space it has, not the screen's. */
  .card {
    position: relative;
    container-type: inline-size;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 0.375rem solid var(--stripe, #616161);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  /* Your next plan has a FABA blue edge, as in the mockup (UI-03). */
  .next {
    border-left-color: var(--blue);
  }
  /* The date and picture, then the title with the time and place beside them, then who's going
     and I'm in along the bottom (UI-03). */
  .layout {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    grid-template-areas:
      'date picture title chevron'
      'date picture rows chevron'
      'foot foot foot foot';
    gap: 0.25rem 0.75rem;
    align-items: start;
    padding: 0.75rem;
  }
  /* On a phone, the time and place take the card's whole width under the title, so they're never
     squeezed into a narrow column. */
  @container (max-width: 24rem) {
    .layout {
      grid-template-areas:
        'date picture title chevron'
        'rows rows rows rows'
        'foot foot foot foot';
      column-gap: 0.625rem;
    }
    .date {
      min-width: 2.75rem;
    }
    .date .day {
      font-size: 1.25rem;
    }
    .picture {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
  /* The day, as the My events design shows it: a blue badge (UI-01). */
  .date {
    grid-area: date;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.25rem;
    margin: 0;
    padding: 0.25rem 0.375rem;
    color: white;
    line-height: 1.1;
    background: var(--blue);
    border-radius: 0.5rem;
  }
  .date .month {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .date .day {
    font-size: 1.5rem;
    font-weight: 800;
  }
  /* The cover's small copy, or the category's icon on a tint of its color (UI-02). Either way,
     its label is the category's name. */
  .picture {
    grid-area: picture;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    overflow: hidden;
    color: var(--navy);
    background: color-mix(in srgb, var(--stripe) 16%, white);
    border-radius: 0.5rem;
  }
  .picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h3 {
    grid-area: title;
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* The title's link covers the card, so the whole card opens the activity. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:has(a:focus-visible) {
    outline: 2px solid;
    outline-offset: 2px;
  }
  .card a:focus-visible {
    outline: none;
  }
  .chevron {
    grid-area: chevron;
    align-self: center;
    color: var(--muted);
  }
  .rows {
    grid-area: rows;
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  p {
    margin: 0;
  }
  .rows p {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }
  .rows :global(.icon) {
    color: var(--blue);
  }
  /* The time shows in full. A series' "Weekly" can go to the next line. */
  time {
    white-space: nowrap;
  }
  /* A long place ends with an ellipsis. The activity's page has all of it. */
  .place span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .foot {
    grid-area: foot;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  /* The faces overlap a little, with a white ring, so three fit beside the count on a phone. */
  .going {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  /* The people icon stands in for faces until someone's going. */
  .going :global(.icon:has(~ .avatar)) {
    display: none;
  }
  .going :global(.avatar) {
    box-shadow: 0 0 0 2px var(--card);
  }
  .going :global(.avatar + .avatar) {
    margin-left: -0.75rem;
  }
  .mine {
    margin-left: auto;
    font-weight: 600;
    white-space: nowrap;
  }
  .cancelled {
    color: #b42318;
  }
  .going-pill {
    padding: 0.25rem 0.75rem;
    color: var(--blue);
    background: var(--blue-soft);
    border-radius: 999px;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .badges li {
    padding: 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
</style>
