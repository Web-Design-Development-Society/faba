---
// An activity in the feed (ACT-01, design document section 7.5) and in My activities (HIST-02).
// The whole card opens the activity, except I'm in and ✓ Going (RSVP-01, RSVP-02). A cancelled
// activity says so in their place (ACT-05).
import { categoryLook } from '../lib/categories';
import { formatSoon, isOver } from '../lib/time';
import Avatar from './Avatar.astro';
import RsvpForm from './RsvpForm.astro';

interface Props {
  activity: {
    id: string;
    title: string;
    starts_at: string;
    ends_at: string | null;
    location_name: string;
    going_count: number;
    organizer_id: string | null;
    status: string;
    category: { name: string; icon: string; color_token: string } | null;
    going: {
      member: {
        id: string;
        display_name: string;
        avatar_url: string | null;
        use_initials: boolean;
      };
    }[];
    /** The signed-in member's RSVP. */
    my_rsvp: string | null;
  };
  /** The signed-in member's id. */
  viewer: string;
  now: Date;
  /** The most faces in the going row. */
  faces: number;
}

const { activity, viewer, now, faces } = Astro.props;
const { category } = activity;
const look = category && categoryLook(category);
const hosting = activity.organizer_id === viewer;
const going = activity.my_rsvp === 'going';
const cancelled = activity.status === 'cancelled';
// Cards aren't hidden, so a published one takes RSVPs until it's over.
const open =
  !cancelled &&
  !isOver(new Date(activity.starts_at), activity.ends_at ? new Date(activity.ends_at) : null, now);
---

<article class="card" style={look ? `--stripe: ${look.color}` : undefined}>
  {category && look && (
    <span class="icon" role="img" aria-label={category.name}>
      {look.icon}
    </span>
  )}
  <div class="body">
    <h3>
      <a href={`/activities/${activity.id}`}>{activity.title}</a>
    </h3>
    <p>
      <time datetime={activity.starts_at}>{formatSoon(new Date(activity.starts_at), now)}</time>
    </p>
    <p class="place">{activity.location_name}</p>
    <p class="going" data-going={activity.id} data-faces={faces}>
      {activity.going.map(({ member }) => (
        <Avatar member={member} named mine={member.id === viewer} />
      ))}
      <span data-count>{activity.going_count}</span> going
    </p>
  </div>
  {cancelled ? (
    <p class="mine cancelled">Cancelled</p>
  ) : hosting ? (
    <p class="mine">You're hosting</p>
  ) : open ? (
    <RsvpForm activityId={activity.id} going={going} />
  ) : (
    going && <p class="mine">✓ Going</p>
  )}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 1px solid #767676;
    border-left: 0.375rem solid var(--stripe, #616161);
    border-radius: 0.5rem;
  }
  /* The title's link covers the card, so the card shows the focus. */
  .card:has(a:focus-visible) {
    outline: 2px solid;
    outline-offset: 2px;
  }
  .card a:focus-visible {
    outline: none;
  }
  .icon {
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .body {
    flex: 1;
    min-width: 0;
  }
  h3 {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 1rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  p {
    margin: 0;
  }
  .place {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .going {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }
  .mine {
    align-self: center;
    font-weight: 600;
    white-space: nowrap;
  }
  .cancelled {
    color: #b42318;
  }
</style>
