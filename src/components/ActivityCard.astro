---
// An activity in the feed (ACT-01, design document section 7.5) and in Plans (RSVP-08). The whole
// card opens the activity, except I'm in and ✓ Going (RSVP-01, RSVP-02). A cancelled activity says
// so in their place (ACT-05), and a full one says Full to anyone not going (RSVP-04), or On
// waitlist (RSVP-07). In Plans, badges say when an upcoming one has changed time or place, is full,
// or is hidden. Every card says when it's a FABA board activity (MOD-07), unless it's cancelled or
// full, which say so in its place: a card has one status at most (design document section 7.5). On
// Home, one that someone else posted since the member's previous visit says New, after all those
// (ACT-11). A date in a series says how often it repeats, beside its time (REC-01).
//
// The layout is UI-17's (mockups/activity_card.png): white paper with the title across the top,
// the picture under it with the time and place beside it, and the going count at the bottom right;
// then a FABA blue column as tall as the card, with the date at the top and the member's answer at
// the bottom. It's a piece of white paper with square corners and a shadow (UI-16).
import { categoryLook } from '../lib/categories';
import { historyLabel, isFull } from '../lib/cards';
import { repeatsBadge } from '../lib/series';
import { isOver, soonParts } from '../lib/time';
import Icon from './Icon.astro';
import RsvpForm from './RsvpForm.astro';

interface Props {
  activity: {
    id: string;
    title: string;
    starts_at: string;
    ends_at: string | null;
    location_name: string;
    going_count: number;
    guest_total: number;
    hidden_at: string | null;
    time_or_place_changed_at: string | null;
    capacity: number | null;
    organizer_id: string | null;
    status: string;
    is_board_activity: boolean;
    created_at: string;
    category: { name: string; icon: string; color_token: string } | null;
    /** The series it's a date in (REC-01). */
    series: { freq: string } | null;
    /** Its cover picture (MEDIA-01), shown small (UI-03). */
    cover?: { id: string; hidden_at: string | null } | null;
    /** The signed-in member's RSVP. */
    my_rsvp: string | null;
  };
  /** The signed-in member's id. */
  viewer: string;
  now: Date;
  /** True for Plans' status badges. */
  badges?: boolean;
  /** True for a past activity, which says "Went" or "Organized" for the viewer (HIST-01). */
  history?: boolean;
  /** On Home, when the member's previous visit ended, so newer activities say New (ACT-11). */
  newSince?: Date | null;
}

const { activity, viewer, now, badges, history, newSince } = Astro.props;
const { category } = activity;
// The date shows the day in Rexburg's time, the same as the time beside the picture.
const starts = new Date(activity.starts_at);
const month = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'America/Boise' })
  .format(starts)
  .toUpperCase();
const day = new Intl.DateTimeFormat('en-US', { day: 'numeric', timeZone: 'America/Boise' }).format(
  starts
);
const [soonDay, soonTime] = soonParts(starts, now);
const look = category && categoryLook(category);
const cover = activity.cover && !activity.cover.hidden_at ? activity.cover : null;
const hosting = activity.organizer_id === viewer;
const going = activity.my_rsvp === 'going';
const cancelled = activity.status === 'cancelled';
// Cards aren't hidden, so a published one takes RSVPs until it's over.
const open =
  !cancelled &&
  !isOver(new Date(activity.starts_at), activity.ends_at ? new Date(activity.ends_at) : null, now);
const full = isFull(activity);
const board = activity.is_board_activity && !cancelled && !(open && full) && 'Board activity';
const fresh =
  !!newSince &&
  !hosting &&
  !cancelled &&
  !(open && full) &&
  new Date(activity.created_at) > newSince &&
  'New';
const past = history ? historyLabel({ ...activity, viewer }) : null;
const shown = (
  past
    ? [past]
    : badges
      ? [
          open && activity.time_or_place_changed_at && 'Changed',
          open && full && 'Full',
          board,
          activity.hidden_at && 'Hidden',
        ]
      : [board || fresh]
).filter((badge) => !!badge);
---

<article class="card" style={look ? `--stripe: ${look.color}` : undefined}>
  <div class="paper">
    <h3>
      <a href={`/activities/${activity.id}`}>{activity.title}</a>
    </h3>
    {(cover || look) && (
      <span
        class="picture"
        role={category ? 'img' : undefined}
        aria-label={category?.name}
        style={look ? undefined : '--stripe: #616161'}
      >
        {cover ? (
          <img
            src={`/api/media/${cover.id}?size=thumb`}
            alt=""
            width="88"
            height="88"
            loading="lazy"
            decoding="async"
          />
        ) : (
          look && <Icon name={look.icon} size={40} />
        )}
      </span>
    )}
    <div class="rows">
      <p class="when">
        <time datetime={activity.starts_at}>
          <span>{soonDay}</span> <span>{soonTime}</span>
        </time>
        {activity.series && ` · ${repeatsBadge(activity.series.freq)}`}
      </p>
      <p class="place">{activity.location_name}</p>
      {shown.length > 0 && (
        <ul class="badges">
          {shown.map((badge) => (
            <li>{badge}</li>
          ))}
        </ul>
      )}
    </div>
    <p class="going" data-going={activity.id}>
      <span data-count>{activity.going_count}</span> going
    </p>
  </div>
  <div class="side">
    <p class="date" aria-hidden="true">
      <span class="month">{month}</span>
      <span class="day">{day}</span>
    </p>
    {cancelled ? (
      <p class="mine">Cancelled</p>
    ) : hosting ? (
      <p class="mine">You're hosting</p>
    ) : open && full && !going && activity.my_rsvp !== 'maybe' ? (
      <p class="mine">{activity.my_rsvp === 'waitlisted' ? 'On waitlist' : 'Full'}</p>
    ) : open ? (
      // Someone waiting when a spot is open says I'm in like anyone else (RSVP-07).
      <RsvpForm
        activityId={activity.id}
        status={activity.my_rsvp === 'waitlisted' ? null : activity.my_rsvp}
      />
    ) : (
      going && <p class="mine">✓ Going</p>
    )}
  </div>
</article>

<style>
  /* A piece of white paper, from the layout's .card (UI-16), with the blue column at its right.
     The category's color tints its picture. Its own width decides the sizes, so a card is laid out
     for the space it has, not the screen's. */
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5rem;
    container-type: inline-size;
  }
  /* The title across the top, the picture under it with the time and place beside it, and the
     going count at the bottom right (UI-17). */
  .paper {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'title title'
      'picture rows'
      'picture going';
    gap: 0.5rem 0.875rem;
    padding: 0.75rem 0.875rem;
  }
  /* Without a category or cover, the time and place take the picture's room. */
  .paper:not(:has(.picture)) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'title' 'rows' 'going';
  }
  p {
    margin: 0;
  }
  /* The title in the display face, each word starting with a capital (UI-30). */
  h3 {
    grid-area: title;
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--navy);
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: capitalize;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* The title's link covers the card, so the whole card opens the activity. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:has(a:focus-visible) {
    outline: 2px solid;
    outline-offset: 2px;
  }
  .card a:focus-visible {
    outline: none;
  }
  /* The cover's small copy, or the category's icon on a tint of its color (UI-02). Either way,
     its label is the category's name. */
  .picture {
    grid-area: picture;
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    overflow: hidden;
    color: var(--navy);
    background: color-mix(in srgb, var(--stripe) 16%, white);
    border-radius: 0;
  }
  .picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The day and time, then the place, big and with no icons. */
  .rows {
    grid-area: rows;
    display: grid;
    align-content: start;
    gap: 0.125rem;
    min-width: 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }
  /* The day and the time each stay whole, so a narrow card breaks the line between them. */
  time span {
    white-space: nowrap;
  }
  /* A long place ends with an ellipsis. The activity's page has all of it. */
  .place {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0.25rem 0 0;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    list-style: none;
  }
  .badges li {
    padding: 0 0.5rem;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: 0;
  }
  /* Just the count, at the bottom right. */
  .going {
    grid-area: going;
    justify-self: end;
    align-self: end;
  }
  /* FABA blue, as tall as the card, flush with its edges over the paper's transparent border. */
  .side {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: -1px -1px -1px 0;
    padding: 0.625rem 0.375rem;
    color: white;
    text-align: center;
    background: var(--blue);
  }
  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--display);
    line-height: 1;
    text-transform: uppercase;
  }
  .date .month {
    font-size: 2rem;
    letter-spacing: 0.04em;
  }
  .date .day {
    font-size: 3.5rem;
  }
  /* The member's answer, or why there's none to give, in the display face like a button (UI-22). */
  .mine {
    font-family: var(--display);
    font-size: 1.125rem;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .side :global(.rsvp) {
    align-self: stretch;
    margin: 0;
  }
  /* I'm in is a white button, and ✓ Going and Maybe are white words that open the sheet. Each is
     the column's width and 44 px tall. */
  .side :global(.rsvp > form button) {
    width: 100%;
    padding: 0 0.25rem;
    font-size: 1.125rem;
    white-space: nowrap;
  }
  .side :global(.rsvp > form button[type='submit']) {
    color: var(--blue);
    background: white;
  }
  .side :global(.rsvp > form button[type='submit']:hover) {
    background: var(--blue-soft);
  }
  .side :global(.rsvp > form button[type='button']) {
    color: white;
    background: none;
  }
  .side :global(.rsvp > form button[type='button']:hover) {
    text-decoration: underline;
  }
  /* A blue focus ring wouldn't show on blue. */
  .side :global(.rsvp > form button:focus-visible) {
    outline-color: white;
  }
  /* On a phone, a little smaller, so the time and place keep their room beside the picture. */
  @container (max-width: 24rem) {
    .card {
      grid-template-columns: minmax(0, 1fr) 4.75rem;
    }
    .paper {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      column-gap: 0.75rem;
      padding: 0.625rem 0.75rem;
    }
    h3 {
      font-size: 1.5rem;
    }
    .picture {
      width: 4.5rem;
      height: 4.5rem;
    }
    .rows {
      font-size: 1.125rem;
    }
    .date .month {
      font-size: 1.75rem;
    }
    .date .day {
      font-size: 3.25rem;
    }
  }
  /* High contrast: the column is plain, with a line between it and the rest of the card. */
  @media (forced-colors: active) {
    .side {
      margin: 0;
      border-left: 1px solid CanvasText;
    }
  }
</style>
