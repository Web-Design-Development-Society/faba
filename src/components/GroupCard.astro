---
// A group in Discover → Groups (GRP-01, UI-10): a white card, like an activity's (UI-03), that opens
// the group. Its banner runs across the top at 3:1, the shape it has on the group's page, or a strip
// in its category's tint with the category's icon when it has none or a moderator hid it. Either
// way the picture's label is the category's name. Then its name, its category, how many members
// it has (GRP-02), who can join, and the start of its description. Badges with words say when the
// member is in it, has asked to join, or it's a league.
import { categoryLook } from '../lib/categories';
import { excerpt } from '../lib/notifications';
import Icon from './Icon.astro';

interface Props {
  group: {
    slug: string;
    name: string;
    description: string | null;
    kind: string;
    join_policy: string;
    member_count: number | null;
    my_membership: string | null;
    category: { name: string; icon: string; color_token: string } | null;
    banner: { id: string; hidden_at: string | null } | null;
  };
}

const { group } = Astro.props;
const look = group.category
  ? categoryLook(group.category)
  : categoryLook({ icon: 'sparkle', color_token: 'category-other' });
const banner = group.banner && !group.banner.hidden_at ? group.banner : null;
const members = group.member_count ?? 0;
const badges = [
  group.my_membership === 'active' && "You're in",
  group.my_membership === 'pending' && 'Requested',
  group.kind === 'league' && 'League',
].filter((badge): badge is string => !!badge);
---

<article class="group" style={`--tint: ${look.color}`}>
  <span class="picture" role={group.category ? 'img' : undefined} aria-label={group.category?.name}>
    {banner ? (
      <img
        src={`/api/media/${banner.id}?size=thumb`}
        alt=""
        width="640"
        height="213"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Icon name={look.icon} size={36} />
    )}
  </span>
  <div class="body">
    <h2>
      <a href={`/groups/${group.slug}`}>{group.name}</a>
    </h2>
    {badges.length > 0 && (
      <ul class="badges">
        {badges.map((badge) => (
          <li>{badge}</li>
        ))}
      </ul>
    )}
    <ul class="facts">
      {group.category && (
        <li>
          <Icon name={look.icon} />
          {group.category.name}
        </li>
      )}
      <li>
        <Icon name="people" />
        {members} {members === 1 ? 'member' : 'members'}
      </li>
      <li>
        <Icon name={group.join_policy === 'open' ? 'user-plus' : 'key'} />
        {group.join_policy === 'open' ? 'Anyone can join' : 'Ask to join'}
      </li>
    </ul>
    {group.description && <p class="about">{excerpt(group.description)}</p>}
  </div>
</article>

<style>
  .group {
    position: relative;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  /* The banner's shape, across the top. Without one, the category's tint and icon. */
  .picture {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 1;
    color: var(--navy);
    background: color-mix(in srgb, var(--tint) 18%, white);
  }
  .picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: grid;
    gap: 0.375rem;
    padding: 0.75rem 1rem 1rem;
  }
  h2 {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 1.125rem;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  /* The name's link covers the card, so the whole card opens the group. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .group:has(a:focus-visible) {
    outline: 2px solid;
    outline-offset: 2px;
  }
  .group a:focus-visible {
    outline: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .badges {
    gap: 0.25rem;
  }
  .badges li {
    padding: 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--blue);
    background: var(--blue-soft);
    border-radius: 999px;
  }
  /* The category, the members and who can join, each with its icon, wrapping as they need. */
  .facts {
    gap: 0.125rem 1rem;
  }
  .facts li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .facts :global(.icon) {
    color: var(--blue);
  }
  .about {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>
