---
// I'm in (RSVP-01), and ✓ Going or Maybe, which open a sheet with Going, Maybe and Can't make it
// (RSVP-02, RSVP-05, design document section 7.8). The member's answer is pressed. When the organizer
// welcomes guests, the sheet also takes how many the member is bringing, which makes them going
// (RSVP-06). Each is a form that posts to the page it's on, which saves the RSVP and redirects
// back (POST, then redirect, then GET), so it works without JavaScript. So does the sheet. With
// JavaScript, src/scripts/rsvp.ts saves without leaving the page, and turns the one button into the
// other.
import { actions } from 'astro:actions';
import Sheet from './Sheet.astro';

interface Props {
  activityId: string;
  /** The signed-in member's answer, if any. */
  status: string | null;
  /** The most guests each member can bring, when the organizer welcomes them, and the member's. */
  guests?: { most: number; mine: number };
}

const { activityId, status, guests } = Astro.props;
const CHOICES = [
  ['going', 'Going'],
  ['maybe', 'Maybe'],
  ['not_going', "Can't make it"],
];
// The page's own address, so it comes back as it was, such as Discover's second page.
const target = new URL(Astro.url);
for (const [name, value] of new URLSearchParams(actions.rsvps.set.queryString)) {
  target.searchParams.set(name, value);
}
const action = target.pathname + target.search;
// Discover can show an activity twice, as the next plan and in the feed. I'm in names the sheet too,
// for when src/scripts/rsvp.ts makes it ✓ Going. A button that names one doesn't post unless its
// type says to.
const sheet = `rsvp-${crypto.randomUUID()}`;
---

<div
  class="rsvp"
  data-rsvp={activityId}
  data-status={status ?? 'not_going'}
  data-guests={guests?.mine ?? 0}
>
  <form method="post" action={action}>
    <input type="hidden" name="activity_id" value={activityId} />
    <input type="hidden" name="status" value="going" />
    {status === 'going' || status === 'maybe' ? (
      <button type="button" commandfor={sheet} command="show-modal">
        {status === 'going' ? '✓ Going' : 'Maybe'}
      </button>
    ) : (
      <button type="submit" commandfor={sheet}>
        I'm in
      </button>
    )}
  </form>
  <Sheet id={sheet} title="Are you going?">
    <div class="choices">
      {CHOICES.map(([value, label]) => (
        <form method="post" action={action}>
          <input type="hidden" name="activity_id" value={activityId} />
          <input type="hidden" name="status" value={value} />
          <button aria-pressed={value === (status ?? 'not_going') ? 'true' : 'false'}>
            {label}
          </button>
        </form>
      ))}
    </div>
    {guests && (
      <form method="post" action={action} class="guests">
        <input type="hidden" name="activity_id" value={activityId} />
        <input type="hidden" name="status" value="going" />
        <label for={`${sheet}-guests`}>Guests you're bringing</label>
        <input
          id={`${sheet}-guests`}
          type="number"
          name="guests"
          min="0"
          max={guests.most}
          value={guests.mine}
          inputmode="numeric"
        />
        <button>Save guests</button>
      </form>
    )}
  </Sheet>
</div>

<style>
  /* Above a card's link, which covers the card. */
  .rsvp {
    position: relative;
    z-index: 1;
    flex: none;
    align-self: center;
    margin-left: auto;
  }
  button {
    min-height: 44px;
    padding: 0 1rem;
  }
  .guests {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .guests input {
    width: 4rem;
    min-height: 44px;
  }
  /* Outlined, with the sheet's own text color: buttons are white on blue elsewhere (UI-01), and on
     no background that white text would be invisible. Plain weight, so the answer stands out. */
  .choices button {
    width: 100%;
    margin-top: 0.5rem;
    color: inherit;
    font-weight: 400;
    text-align: left;
    background: none;
    border: 1px solid #767676;
    border-radius: 0.5rem;
  }
  /* The member's answer: bold, a thicker border, and a check. */
  .choices [aria-pressed='true'] {
    font-weight: 600;
    border-width: 2px;
  }
  .choices [aria-pressed='true']::before {
    content: '✓ ' / '';
  }
</style>
