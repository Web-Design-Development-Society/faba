---
// I'm in (RSVP-01), and ✓ Going, which opens a sheet with Can't make it (RSVP-02, design document
// section 7.8). Each is a form that posts to the page it's on, which saves the RSVP and redirects
// back (POST, then redirect, then GET), so it works without JavaScript. So does the sheet. With
// JavaScript, src/scripts/rsvp.ts saves without leaving the page, and turns the one button into the
// other.
import { actions } from 'astro:actions';
import Sheet from './Sheet.astro';

interface Props {
  activityId: string;
  /** Whether the signed-in member is going. */
  going: boolean;
}

const { activityId, going } = Astro.props;
// The page's own address, so it comes back as it was, such as Discover's second page.
const target = new URL(Astro.url);
for (const [name, value] of new URLSearchParams(actions.rsvps.set.queryString)) {
  target.searchParams.set(name, value);
}
const action = target.pathname + target.search;
// Discover can show an activity twice, as the next plan and in the feed. I'm in names the sheet too,
// for when src/scripts/rsvp.ts makes it ✓ Going. A button that names one doesn't post unless its
// type says to.
const sheet = `rsvp-${crypto.randomUUID()}`;
---

<div class="rsvp" data-rsvp={activityId}>
  <form method="post" action={action}>
    <input type="hidden" name="activity_id" value={activityId} />
    <input type="hidden" name="status" value="going" />
    {going ? (
      <button type="button" commandfor={sheet} command="show-modal">
        ✓ Going
      </button>
    ) : (
      <button type="submit" commandfor={sheet}>
        I'm in
      </button>
    )}
  </form>
  <Sheet id={sheet} title="Are you going?">
    <div class="choices">
      <form method="dialog">
        <button aria-pressed="true">Going</button>
      </form>
      <form method="post" action={action}>
        <input type="hidden" name="activity_id" value={activityId} />
        <input type="hidden" name="status" value="not_going" />
        <button aria-pressed="false">Can't make it</button>
      </form>
    </div>
  </Sheet>
</div>

<style>
  /* Above a card's link, which covers the card. */
  .rsvp {
    position: relative;
    z-index: 1;
    flex: none;
    align-self: center;
    margin-left: auto;
  }
  button {
    min-height: 44px;
    padding: 0 1rem;
  }
  .choices button {
    width: 100%;
    margin-top: 0.5rem;
    text-align: left;
    background: none;
    border: 1px solid #767676;
    border-radius: 0.5rem;
  }
  [aria-pressed='true'] {
    font-weight: 600;
    border-width: 2px;
  }
  [aria-pressed='true']::before {
    content: '✓ ' / '';
  }
</style>
