---
// What a main page is for, in a sentence at its top (UI-24). It's about the page rather than part
// of it, so it's plain dark text, with no shadow, which made it look blurry (UI-29). In a header
// row, such as Groups' with Start a group, it takes the room at the left.
---

<p class="page-sentence">
  <slot />
</p>

<style>
  .page-sentence {
    margin: 0.75rem 0;
    color: var(--ink);
    font-size: 1.2em;
    line-height: 1.4;
  }
  :global(main > .top) > .page-sentence {
    flex: 1 1 0;
    margin: 0;
  }
  /* The button beside it wraps onto two lines before it squeezes the sentence. */
  :global(main > .top) > .page-sentence ~ :global(*) {
    max-width: 45%;
  }
</style>
