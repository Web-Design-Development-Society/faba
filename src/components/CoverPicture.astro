---
// An activity's cover or a group's banner (MEDIA-01), across the page's width at a fixed shape, so a
// tall phone photo doesn't fill the screen. The middle of the picture shows, and the edges that
// don't fit are cut off. Anyone but the person who added it can report it. A phone gets its medium
// copy, 1080 px wide, and a wide, sharp screen the full picture, which the browser picks from how
// wide the page shows it (UI-27). One without a medium copy is served whole either way.
interface Props {
  image: { id: string; alt: string; uploaded_by: string | null };
  /** The member viewing the page. */
  viewer: string;
  /** A cover is 16:9, as a photo usually is. A banner is a wide strip, 3:1. */
  shape: 'cover' | 'banner';
}

const { image, viewer, shape } = Astro.props;
---

<figure class:list={['picture', shape]}>
  <img
    src={`/api/media/${image.id}?size=medium`}
    srcset={`/api/media/${image.id}?size=medium 1080w, /api/media/${image.id} 1600w`}
    sizes="(min-width: 40rem) 36rem, calc(100vw - 3rem)"
    alt={image.alt}
    decoding="async"
  />
  {image.uploaded_by !== viewer && (
    <figcaption>
      <a href={`/media/${image.id}/report`} class="button">
        Report picture
      </a>
    </figcaption>
  )}
</figure>

<style>
  .picture {
    margin: 0 0 1rem;
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--blue-soft);
    border-radius: 0;
  }
  .banner img {
    aspect-ratio: 3 / 1;
  }
  figcaption {
    font-size: 0.875rem;
  }
  figcaption {
    margin-top: 0.5rem;
  }
</style>
