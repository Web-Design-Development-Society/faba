---
// An activity's cover or a group's banner (MEDIA-01), across the page's width. A cover shows whole,
// never cut (MEDIA-03): a wide one spans the page, and a tall one is at most 24rem tall, or half a
// short screen, so it doesn't fill the screen, centered, with the page's paper beside it. A banner
// is a wide strip, 3:1, whose middle shows, and the edges that don't fit are cut off. Anyone but
// the person who added it can report it. A phone gets its medium copy, 1080 px, and a wide, sharp
// screen the full picture, which the browser picks from how wide the page shows it (UI-27). A
// cover's medium copy is the whole picture, and a banner's is cut to its strip. One without a
// medium copy is served whole either way.
interface Props {
  image: { id: string; alt: string; uploaded_by: string | null };
  /** The member viewing the page. */
  viewer: string;
  /** A cover shows whole. A banner is a wide strip, 3:1. */
  shape: 'cover' | 'banner';
}

const { image, viewer, shape } = Astro.props;
const full = `/api/media/${image.id}`;
const medium = `${full}?size=${shape === 'cover' ? 'whole' : 'medium'}`;
---

<figure class:list={['picture', shape]}>
  <img
    src={medium}
    srcset={`${medium} 1080w, ${full} 1600w`}
    sizes="(min-width: 40rem) 36rem, calc(100vw - 3rem)"
    alt={image.alt}
    decoding="async"
  />
  {image.uploaded_by !== viewer && (
    <figcaption>
      <a href={`/media/${image.id}/report`} class="button">
        Report picture
      </a>
    </figcaption>
  )}
</figure>

<style>
  .picture {
    margin: 0 0 1rem;
  }
  img {
    display: block;
    width: 100%;
    border-radius: 0;
  }
  /* The whole picture at its own shape, up to the limit, and the page's paper beside a tall one.
     Until it loads, its space is 16:9. */
  .cover img {
    aspect-ratio: auto 16 / 9;
    height: auto;
    max-height: min(24rem, 50svh);
    object-fit: contain;
    background: var(--paper);
  }
  .banner img {
    aspect-ratio: 3 / 1;
    object-fit: cover;
    background: var(--blue-soft);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
</style>
